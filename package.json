{
  "name": "gobierno-vault",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate.mjs",
    "generate-index": "node scripts/generate-index.mjs",
    "sitemaps-sync": "node scripts/sync-sitemaps.mjs",
    "sitemaps-index": "node scripts/sitemaps-index.mjs",
    "sitemaps-backup": "node scripts/sitemaps-backup.mjs",
    "sitemaps-resync": "node scripts/sitemaps-resync.mjs",
    "sitemaps-watchlist": "node scripts/sitemaps-watchlist.mjs",
    "add-source": "node scripts/add-source.mjs",
    "pdf-extract": "node scripts/pdf-extract.mjs",
    "doc-extract": "node scripts/doc-extract.mjs",
    "fetch-impersonate": "node scripts/fetch-impersonate.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "verify": "node scripts/verify.mjs",
    "build": "node scripts/validate.mjs && set NODE_OPTIONS=--experimental-global-customevent&& astro build",
    "preview": "pnpm run build && npx wrangler pages dev dist --port 4321",
    "deploy": "pnpm run build && npx wrangler pages deploy dist --project-name gobierno-vault --branch main"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/tailwind": "^6.0.2",
    "@lucide/astro": "^1.26.0",
    "@realtimex/piper-tts-web": "^1.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.1.1",
    "cuelume": "^0.2.2",
    "d3-force": "^3.0.0",
    "lucide-astro": "^0.556.0",
    "mermaid": "^11.16.0",
    "onnxruntime-web": "1.22.0",
    "remark-wiki-link": "^2.0.1",
    "tailwindcss": "^3.4.19",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@firecrawl/pdf-inspector": "^1.12.0",
    "crawlee": "^3.18.1"
  }
}
