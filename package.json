{
  "name": "gobierno-vault",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate/validate.mjs",
    "generate-index": "node scripts/generate/generate-index.mjs",
    "generate-seguimiento-index": "node scripts/generate/generate-seguimiento-index.mjs",
    "sitemaps-sync": "node scripts/sitemaps/sync.mjs",
    "sitemaps-index": "node scripts/sitemaps/index.mjs",
    "sitemaps-backup": "node scripts/sitemaps/backup.mjs",
    "sitemaps-resync": "node scripts/sitemaps/resync.mjs",
    "sitemaps-watchlist": "node scripts/sitemaps/watchlist.mjs",
    "news-search": "node scripts/sitemaps/news-search.mjs",
    "add-source": "node scripts/extract/add-source.mjs",
    "pdf-extract": "node scripts/extract/pdf-extract.mjs",
    "doc-extract": "node scripts/extract/doc-extract.mjs",
    "fetch-impersonate": "node scripts/extract/fetch-impersonate.mjs",
    "fetch-content": "node scripts/extract/fetch-content.mjs",
    "ocr-extract": "node scripts/extract/ocr-extract.mjs",
    "video-transcript": "node scripts/extract/video-transcript.mjs",
    "backup": "node scripts/backup/backup.mjs",
    "restore": "node scripts/backup/restore.mjs",
    "verify": "node scripts/backup/verify.mjs",
    "verify-gabinete": "node scripts/validate/verify-gabinete.mjs",
    "validate-sources": "node scripts/validate/validate-sources.mjs",
    "build": "node scripts/validate/validate.mjs && astro build",
    "preview": "pnpm run build && npx wrangler pages dev dist --port 4321",
    "deploy": "pnpm run build && npx wrangler pages deploy dist --project-name gobierno-vault --branch main"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@lucide/astro": "^1.26.0",
    "@realtimex/piper-tts-web": "^1.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.1.1",
    "cuelume": "^0.2.2",
    "d3-force": "^3.0.0",
    "lucide-astro": "^0.556.0",
    "mermaid": "^11.16.0",
    "onnxruntime-web": "1.22.0",
    "remark-wiki-link": "^2.0.1",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@firecrawl/pdf-inspector": "^1.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "crawlee": "^3.18.1",
    "daisyui": "^5.7.19",
    "puppeteer": "^25.9.0",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4.3.3"
  }
}
