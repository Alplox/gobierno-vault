# @astrojs/tailwind@6 declara peer astro ^3||^4||^5, pero el proyecto usa Astro 7.
# Con npm se usaba legacy-peer-deps=true para que `npm clean-install` en CI no fallara.
# Con pnpm esto no es necesario: la política por defecto (strict-peer-dependencies=false
# + auto-install-peers=true) resuelve la combinación sin fallar.
auto-install-peers=true
strict-peer-dependencies=false
