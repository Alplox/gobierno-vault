---
import Base from '../layouts/Base.astro';
import {
  getCabinetByMinistry,
  getCabinetByGobierno,
  periodoDe,
  fechaEs,
  GOBIERNOS,
  type GobiernoAppointment,
} from '../lib/cabinet';
import { Landmark, UserRound, History, ChevronDown, Layers, Timer, CalendarRange, UserX, XCircle } from 'lucide-astro';

const cabinet = getCabinetByMinistry();
const gobiernos = getCabinetByGobierno();

const carterasConTitular = cabinet.filter((c) => c.actual);
const ministrosVigentes = new Set(
  cabinet.map((c) => c.actual?.personId).filter(Boolean)
).size;
const biministros = new Set(
  cabinet.flatMap((c) => [c.actual, ...c.historico]).filter((a) => a?.biministro).map((a) => a!.personId)
).size;
const historicos = cabinet.reduce((s, c) => s + c.historico.length, 0);

// Fecha "hoy" para el gobierno en ejercicio (Kast): la fecha del BUILD. Los
// titulares "en ejercicio" llevan en el cargo hasta hoy, que es lo correcto
// para duraciones y barras. NO usar el max `desde` de los nombramientos como
// corte: con ese criterio el ministro nombrado más reciente siempre mostraba
// "0 días" (su propia fecha de nombramiento ERA el corte) y todos los vigentes
// quedaban congelados en la fecha del último nombramiento (bug real: Riveros
// Cantuarias, nombrado 14-ago-2026, aparecía con "0 días en ejercicio").
// Es solo el fallback sin-JS: gvRefreshHoy() re-ancla el corte a la fecha real
// del cliente si el deploy quedó stale (barras de vigentes, línea "hoy",
// duraciones móviles, stats y la fecha de corte del header).
const fechaMaxDatos = new Date().toISOString().slice(0, 10);

type Segmento = { leftPct: number; widthPct: number; a: GobiernoAppointment };

/**
 * Calcula los segmentos con escala fija de MANDATO COMPLETO: el % se calcula
 * sobre el rango t0→t1 (periodo presidencial completo, 4 años para el actual),
 * pero un titular vigente sin fecha de término se corta en `tDatos` (fecha de
 * corte de los datos = hoy), no en el fin del mandato. Así se ve qué proporción
 * del mandato lleva transcurrido y el resto de la barra queda vacía (futuro).
 */
function calcularSegmentos(
  cartera: { titulares: GobiernoAppointment[] },
  t0: number,
  t1: number,
  tDatos: number
): Segmento[] {
  const rango = t1 - t0;
  if (rango <= 0) return [];
  return cartera.titulares.map((a) => {
    const desde = a.desdeGob ? new Date(a.desdeGob).getTime() : t0;
    const hasta = a.hastaGob ? new Date(a.hastaGob).getTime() : Math.min(t1, tDatos);
    const leftPct = Math.max(0, ((desde - t0) / rango) * 100);
    const widthPct = Math.max(1.5, ((Math.min(hasta, t1) - Math.max(desde, t0)) / rango) * 100);
    return { leftPct, widthPct, a };
  });
}

function duracionCorta(a: GobiernoAppointment): string {
  if (a.fechasSinRegistrar) return 'sin fechas';
  const desde = fechaEs(a.desdeGob ?? a.desde);
  const hasta = a.hastaGob ? fechaEs(a.hastaGob) : a.hasta ? fechaEs(a.hasta) : 'en ejercicio';
  return `${desde ?? '¿?'} → ${hasta ?? '¿?'}`;
}

// Colores de segmento según estado del titular en el gobierno.
// Azul = titular (en ejercicio o que completó el periodo); rojo = salida anticipada.
function segmentoClase(a: GobiernoAppointment): string {
  if (a.salidaPrevia) return 'bg-error/70 hover:bg-error';
  return 'bg-primary/70 hover:bg-primary/100';
}

// Eje de tiempo general: marcas en el mismo % que las barras (0-100% del periodo).
// SIEMPRE se escala al mandato completo (4 años): para el gobierno en ejercicio
// el eje llega al fin del mandato previsto, no a la fecha de corte de los datos.
// Los AÑOS siempre aparecen (enero de cada año del mandato); entre ellos, los
// MESES según densidad (corto → cada mes; largo → cada 3 o 6 meses).
const MESES_CORTOS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

type TickEje = { left: number; label: string; major: boolean };

function ejesTiempo(t0: number, t1: number): TickEje[] {
  const rango = t1 - t0;
  if (rango <= 0) return [];
  const d0 = new Date(t0);
  const d1 = new Date(t1);
  const mesesTotales = (d1.getFullYear() - d0.getFullYear()) * 12 + (d1.getMonth() - d0.getMonth());
  let paso: number;
  if (mesesTotales <= 8) paso = 1;
  else if (mesesTotales <= 24) paso = 2;
  else if (mesesTotales <= 60) paso = 3;
  else paso = 6;
  const ticks: TickEje[] = [];
  // Años: enero de cada año del mandato (siempre visibles, etiqueta "YYYY").
  for (let y = d0.getFullYear(); y <= d1.getFullYear(); y++) {
    const m = new Date(y, 0, 1); // 1 de enero
    if (m.getTime() <= t0 || m.getTime() >= t1) continue;
    const left = ((m.getTime() - t0) / rango) * 100;
    if (left < 2 || left > 98) continue;
    ticks.push({ left, label: String(y), major: true });
  }
  // Meses entre los años (nunca en enero, que ya está cubierto por el año).
  for (let i = paso; ; i += paso) {
    const m = new Date(d0.getFullYear(), d0.getMonth() + i, 1);
    if (m.getTime() >= t1) break;
    if (m.getMonth() === 0) continue; // enero = tick de año
    const left = ((m.getTime() - t0) / rango) * 100;
    if (left < 3 || left > 97) continue;
    ticks.push({ left, label: MESES_CORTOS[m.getMonth()], major: false });
  }
  return ticks.sort((a, b) => a.left - b.left);
}

// Fin del mandato presidencial completo (4 años desde el inicio del periodo).
// Para el gobierno en ejercicio (sin `hasta`) se proyecta el mandato por cumplir.
function finMandato(g: { desde: string; hasta?: string }): number {
  if (g.hasta) return new Date(g.hasta).getTime();
  const [y, m, d] = g.desde.split('-').map(Number);
  return new Date(y + 4, m - 1, d).getTime();
}

// Días en el cargo (sobre las fechas recortadas al periodo del gobierno).
function diasCargo(a: GobiernoAppointment, tFin: number): number | null {
  if (!a.desdeGob) return null;
  const desde = new Date(a.desdeGob).getTime();
  const hasta = a.hastaGob ? new Date(a.hastaGob).getTime() : tFin;
  const dias = Math.round((hasta - desde) / 86400000);
  return dias >= 0 ? dias : null;
}

function etiquetaDias(a: GobiernoAppointment, tFin: number): string {
  const dias = diasCargo(a, tFin);
  if (dias == null) return '';
  return a.vigente && !a.hastaGob ? ` · ${dias} días en ejercicio` : ` · duró ${dias} días`;
}

type StatTitular = { a: GobiernoAppointment; dias: number };

function statsGobierno(
  g: { carteras: { titulares: GobiernoAppointment[] }[] },
  tFin: number
): { promedio: number | null; masLongevo: StatTitular | null; masBreve: StatTitular | null } {
  const conDias: StatTitular[] = g.carteras
    .flatMap((c) => c.titulares)
    .map((a) => ({ a, dias: diasCargo(a, tFin)! }))
    .filter((x) => x.dias !== null);
  if (conDias.length === 0) return { promedio: null, masLongevo: null, masBreve: null };
  const promedio = Math.round(conDias.reduce((s, x) => s + x.dias, 0) / conDias.length);
  const masLongevo = conDias.reduce((m, x) => (x.dias > m.dias ? x : m));
  const masBreve = conDias.reduce((m, x) => (x.dias < m.dias ? x : m));
  return { promedio, masLongevo, masBreve };
}
---

<Base title="Gabinete Ministerial">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <Landmark class="h-6 w-6 text-primary shrink-0" />
      <h1 class="text-2xl sm:text-3xl font-bold text-base-content leading-tight">Gabinete Ministerial</h1>
    </div>
    <p class="text-base-content/60 text-sm">
      Carteras ministeriales y sus titulares (actuales e históricos), generado automáticamente desde los cargos registrados en <code class="text-base-content/70 bg-base-200 px-1 py-0.5 rounded text-xs">src/content/people/*.md</code>.
    </p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
    <div class="bg-base-100 rounded-xl border-0 shadow-[var(--shadow-border)] p-4">
      <p class="text-2xl font-bold text-base-content">{carterasConTitular.length}<span class="text-base-content/40 text-base font-medium">/{cabinet.length}</span></p>
      <p class="text-xs text-base-content/60 font-medium mt-0.5">Carteras con titular</p>
    </div>
    <div class="bg-base-100 rounded-xl border-0 shadow-[var(--shadow-border)] p-4">
      <p class="text-2xl font-bold text-base-content">{ministrosVigentes}</p>
      <p class="text-xs text-base-content/60 font-medium mt-0.5">Titulares en ejercicio</p>
    </div>
    <div class="bg-base-100 rounded-xl border-0 shadow-[var(--shadow-border)] p-4">
      <p class="text-2xl font-bold text-base-content">{biministros}</p>
      <p class="text-xs text-base-content/60 font-medium mt-0.5">Biministros</p>
    </div>
    <div class="bg-base-100 rounded-xl border-0 shadow-[var(--shadow-border)] p-4">
      <p class="text-2xl font-bold text-base-content">{historicos}</p>
      <p class="text-xs text-base-content/60 font-medium mt-0.5">Nombramientos históricos</p>
    </div>
  </div>

  <!-- Toggle de vista -->
  <div class="flex items-center gap-1 mb-6 bg-base-200/80 rounded-xl p-1 w-fit border border-base-300/70" role="tablist" aria-label="Vista del gabinete">
    <button type="button" data-gv-view="carteras" class="gv-view-btn rounded-lg px-4 py-2 text-sm font-semibold transition-colors cursor-pointer" aria-selected="true">Por cartera</button>
    <button type="button" data-gv-view="gobiernos" class="gv-view-btn rounded-lg px-4 py-2 text-sm font-semibold transition-colors cursor-pointer" aria-selected="false">Por gobierno</button>
  </div>

  <!-- VISTA 1: POR CARTERA (formato actual) -->
  <div id="gv-view-carteras" class="space-y-4" data-gv-panel="carteras">
    {cabinet.map((c) => (
      <section class="bg-base-100 rounded-2xl border-0 shadow-[var(--shadow-border)] overflow-hidden">
        <header class="flex items-center justify-between gap-3 px-5 py-4 border-b border-base-300">
          <div class="min-w-0">
            <a href={`/organizations/${c.ministerioId}`} class="text-base font-bold text-base-content hover:text-primary transition-colors leading-snug">
              {c.ministerioNombre}
            </a>
            {c.actual ? (
              <p class="flex items-center gap-1.5 text-sm mt-1">
                <UserRound class="h-3.5 w-3.5 text-primary shrink-0" />
                <a href={`/people/${c.actual.personId}`} class="font-semibold text-base-content hover:text-primary transition-colors">
                  {c.actual.nombre}
                </a>
                <span class="text-xs text-base-content/40 font-normal">{periodoDe(c.actual)}</span>
                {c.actual.biministro && <span class="text-[10px] font-bold uppercase tracking-wide bg-warning/20 text-warning px-1.5 py-0.5 rounded-full">Biministro</span>}
                {c.actual.subrogante && <span class="text-[10px] font-bold uppercase tracking-wide bg-warning/20 text-warning px-1.5 py-0.5 rounded-full">Subrogante</span>}
                {c.actual.fechasSinRegistrar && <span class="text-[10px] font-medium text-base-content/40">(fechas sin registrar)</span>}
              </p>
            ) : (
              <p class="flex items-center gap-1.5 text-sm text-base-content/60 mt-1">
                <Timer class="h-3.5 w-3.5 shrink-0" />
                <span class="italic">Sin titular registrado</span>
              </p>
            )}
          </div>
          <a href={`/organizations/${c.ministerioId}`} class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary bg-primary/10 px-2.5 py-1 rounded-lg transition-colors shrink-0">
            <Layers class="h-3.5 w-3.5" />
            <span>Cartera</span>
          </a>
        </header>

        {c.historico.length > 0 && (
          <details class="group">
            <summary class="flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-base-content/60 hover:text-base-content hover:bg-base-200 cursor-pointer list-none transition-colors select-none">
              <History class="h-3.5 w-3.5 shrink-0" />
              <span>Histórico de titulares ({c.historico.length})</span>
              <ChevronDown class="h-3.5 w-3.5 ml-auto transition-transform group-open:rotate-180" />
            </summary>
            <ul class="px-5 pb-4 space-y-2.5">
              {c.historico.map((a) => (
                <li class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm pl-1 border-l-2 border-base-300">
                  <a href={`/people/${a.personId}`} class="font-medium text-base-content/80 hover:text-primary transition-colors">{a.nombre}</a>
                  <span class="text-xs text-base-content/40">{a.cargo}</span>
                  <span class="text-xs text-base-content/40">· {periodoDe(a)}</span>
                  {a.biministro && <span class="text-[10px] font-bold uppercase tracking-wide bg-warning/20 text-warning px-1.5 py-0.5 rounded-full">Biministro</span>}
                  {a.subrogante && <span class="text-[10px] font-bold uppercase tracking-wide bg-warning/20 text-warning px-1.5 py-0.5 rounded-full">Subrogante</span>}
                  {a.fechasSinRegistrar && <span class="text-[10px] font-medium text-base-content/40">(fechas sin registrar)</span>}
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>
    ))}
  </div>

  <!-- VISTA 2: POR GOBIERNO (línea de tiempo) -->
  <div id="gv-view-gobiernos" class="hidden" data-gv-panel="gobiernos">
    <!-- Selector de presidente -->
    <div class="flex flex-wrap gap-1.5 mb-6" role="tablist" aria-label="Seleccionar gobierno">
      {GOBIERNOS.map((g) => (
          <button type="button" data-gv-gob={g.id}
            class="gv-gob-btn rounded-lg border border-base-300 bg-base-100 px-3 py-1.5 text-xs font-semibold text-base-content/70 hover:border-primary/50 hover:text-primary transition-colors cursor-pointer"
            aria-selected={g.id === 'kast'}>
            <span class="block leading-tight">{g.presidente}</span>
            <span class="block text-[10px] font-normal text-base-content/40">{g.partido} · {g.desde.slice(0, 4)}{g.hasta ? `–${g.hasta.slice(0, 4)}` : '–'}</span>
          </button>
      ))}
    </div>

    <!-- Paneles por gobierno -->
    {gobiernos.map((g) => {
      const t0 = new Date(g.gobierno.desde).getTime();
      // La escala SIEMPRE cubre el mandato completo (4 años), incluso para el gobierno en ejercicio.
      const tFin = finMandato(g.gobierno);
      // Corte de datos: para el actual es la fecha de hoy; para los terminados, el fin del mandato.
      const tDatos = g.gobierno.hasta ? tFin : new Date(fechaMaxDatos).getTime();
      const ejes = ejesTiempo(t0, tFin);
      const stats = statsGobierno(g, tDatos);
      // Desktop: columna de cartera + barra (Gantt). Móvil: apilado (grid-cols-1).
      const columnas = 'grid-cols-1 sm:grid-cols-[190px_1fr]';
      const textoFin = g.gobierno.hasta
        ? fechaEs(g.gobierno.hasta)
        : `en ejercicio · mandato previsto hasta ${fechaEs(new Date(tFin).toISOString().slice(0, 10))}`;
      return (
        <section
          data-gv-gob-panel={g.gobierno.id}
          class={g.gobierno.id === 'kast' ? '' : 'hidden'}
          {...(g.gobierno.actual
            ? {
                'data-gv-actual': '1',
                'data-gv-t0': String(t0),
                'data-gv-tfin': String(tFin),
                'data-gv-tdatos': String(tDatos),
              }
            : {})}
        >
          <div class="bg-base-100 rounded-2xl border-0 shadow-[var(--shadow-border)] overflow-hidden mb-6">
            <header class="px-5 py-4 border-b border-base-300 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-lg font-bold text-base-content">{g.gobierno.presidente}</h2>
                <p class="text-xs text-base-content/60 mt-0.5">
                  <CalendarRange class="h-3.5 w-3.5 inline -mt-0.5 mr-1" />
                  {fechaEs(g.gobierno.desde)} → {textoFin}
                  {g.gobierno.actual && <span data-gv-corte> · corte al {fechaEs(fechaMaxDatos)}</span>}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                <span class="inline-flex items-center gap-1 text-base-content/70"><UserRound class="h-3.5 w-3.5 text-primary" /> {g.totalNombramientos} nombramientos</span>
                <span class="inline-flex items-center gap-1 text-error"><XCircle class="h-3.5 w-3.5" /> {g.salidasPrevias} salidas antes del término</span>
              </div>
            </header>
            <div class="px-5 py-2.5 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-base-content/60 border-b border-base-300 items-center">
              <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-primary/70 inline-block" /> Titular del periodo (incluye en ejercicio)</span>
              <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-error/70 inline-block" /> Salida anticipada (renuncia/cambio)</span>
              {stats.promedio !== null && stats.masLongevo && stats.masBreve && (
                <span class="inline-flex items-center gap-1.5 text-base-content/70 ml-auto">
                  <Timer class="h-3.5 w-3.5 shrink-0" />
                  <span>Duración media: <span data-gv-stat-prom>{stats.promedio}</span> días</span>
                  <span class="text-base-content/30">·</span>
                  <span>Más longevo: <span class="font-semibold text-base-content/80" data-gv-stat-longevo>{stats.masLongevo.a.nombre}</span> (<span data-gv-stat-longevo-dias>{stats.masLongevo.dias}</span> días)</span>
                  <span class="text-base-content/30">·</span>
                  <span>Más breve: <span class="font-semibold text-base-content/80" data-gv-stat-breve>{stats.masBreve.a.nombre}</span> (<span data-gv-stat-breve-dias>{stats.masBreve.dias}</span> días)</span>
                </span>
              )}
            </div>

            {g.carteras.length === 0 ? (
              <p class="px-5 py-6 text-sm text-base-content/40 italic">Sin nombramientos registrados para este gobierno.</p>
            ) : (
              <div class="px-5 py-4">
                {/* Eje de tiempo general: misma escala % que las barras, alineado por columna.
                    Los ticks de año (enero) son mayores; los de mes, menores. */}
                <div class={`grid ${columnas} gap-3 items-end mb-2`}>
                  <span class="hidden sm:block text-[10px] font-semibold text-base-content/40 uppercase tracking-wide pb-0.5">Tiempo</span>
                  <div class="relative h-6 border-b border-base-300">
                    {ejes.map(({ left, label, major }) => (
                      <span
                        class={`absolute top-0 -translate-x-1/2 flex flex-col items-center pointer-events-none ${major ? 'font-semibold' : ''}`}
                        style={`left:${left.toFixed(2)}%;`}
                      >
                        <span class={`w-px ${major ? 'h-3 bg-base-content/50' : 'h-2 bg-base-300'}`}></span>
                        <span class={`text-[9px] whitespace-nowrap mt-0.5 ${major ? 'text-base-content/70' : 'text-base-content/40 hidden sm:block'}`}>{label}</span>
                      </span>
                    ))}
                    {g.gobierno.actual && (
                      <span
                        class="absolute top-0 -translate-x-1/2 flex flex-col items-center pointer-events-none"
                        data-gv-hoy
                        style={`left:${(((new Date(fechaMaxDatos).getTime() - t0) / (tFin - t0)) * 100).toFixed(2)}%;`}
                      >
                        <span class="w-[2px] h-3 bg-primary/100 rounded-full"></span>
                        <span class="text-[9px] font-bold text-primary whitespace-nowrap mt-0.5">hoy</span>
                      </span>
                    )}
                  </div>
                </div>

                <div class="relative">
                  {/* Overlay de rejilla tipo carta Gantt: líneas verticales continuas en
                      los ticks del eje, atravesando TODAS las barras (alineadas al % del
                      eje general). pointer-events-none para no bloquear los clics. */}
                  <div class={`hidden sm:grid absolute inset-0 ${columnas} gap-3 pointer-events-none z-0`} aria-hidden="true">
                    <span class="hidden sm:block"></span>
                    <div class="relative">
                      {ejes.map(({ left, major }) => (
                        <span class={`absolute top-0 bottom-0 w-px ${major ? 'bg-base-300/70' : 'bg-base-300/60'}`} style={`left:${left.toFixed(2)}%;`}></span>
                      ))}
                      {g.gobierno.actual && (
                        <span
                          class="absolute top-0 bottom-0 w-[2px] bg-primary/40 rounded-full"
                          data-gv-hoy
                          style={`left:${(((new Date(fechaMaxDatos).getTime() - t0) / (tFin - t0)) * 100).toFixed(2)}%;`}
                        ></span>
                      )}
                    </div>
                  </div>

                  <div class="relative space-y-2.5 z-10">
                    {g.carteras.map((car) => {
                      const segmentos = calcularSegmentos(car, t0, tFin, tDatos);
                      return (
                        <div class="space-y-0.5">
                          {/* Móvil: encabezado de cartera (la fila del grid con barra
                              y nombres alineados es solo de escritorio). */}
                          <a href={`/organizations/${car.ministerioId}`} class="sm:hidden block text-xs font-semibold text-base-content/80 hover:text-primary transition-colors truncate leading-tight" title={car.ministerioNombre}>
                            {car.ministerioNombre}
                          </a>
                          <div class={`hidden sm:grid ${columnas} gap-1 sm:gap-3 items-center`}>
                            <a href={`/organizations/${car.ministerioId}`} class="text-xs font-semibold text-base-content/80 hover:text-primary transition-colors truncate leading-tight" title={car.ministerioNombre}>
                              {car.ministerioNombre}
                            </a>
                            <div class="gv-bar relative h-7 bg-base-200/70 rounded-md overflow-hidden" title={car.titulares.map((a) => `${a.nombre}: ${duracionCorta(a)}${etiquetaDias(a, tDatos)}`).join('\n')}>
                              {segmentos.map(({ leftPct, widthPct, a }, i) => (
                                <a
                                  href={`/people/${a.personId}`}
                                  data-gv-seg={i}
                                  data-gv-cartera={car.ministerioId}
                                  data-gv-desde={a.desdeGob}
                                  data-gv-nombre={a.nombre}
                                  data-gv-dias={diasCargo(a, tDatos)}
                                  data-gv-vigente={!a.hastaGob ? '1' : undefined}
                                  class={`gv-seg absolute top-0 h-full block ${segmentoClase(a)} transition-colors ${a.biministro ? 'ring-2 ring-inset ring-warning/50' : ''} ${a.subrogante ? 'ring-2 ring-inset ring-orange-300' : ''}`}
                                  style={`left:${leftPct.toFixed(2)}%;width:${widthPct.toFixed(2)}%;`}
                                  title={`${a.nombre} · ${duracionCorta(a)}${etiquetaDias(a, tDatos)}${a.salidaPrevia ? ' · SALIÓ ANTES DEL TÉRMINO' : ''}${a.biministro ? ' · Biministro' : ''}${a.subrogante ? ' · Subrogante' : ''}${a.fechasSinRegistrar ? ' · fechas sin registrar' : ''}`}
                                ></a>
                              ))}
                            </div>
                          </div>
                          {/* Nombres bajo la barra, alineados con cada segmento
                              (hover resalta el segmento correspondiente en la barra).
                              El alto fijo h-4 es el fallback SSR de 1 fila; el script
                              gvPackNames lo reemplaza empaquetando los nombres en las
                              filas que hagan falta (segmentos muy cortos → nombre completo
                              desbordado a su derecha, sin recortar). */}
                          <div class={`hidden sm:grid ${columnas} gap-3`}>
                            <span></span>
                            <div class="gv-names relative h-4 text-[10px] leading-4">
                              {segmentos.map(({ leftPct, widthPct, a }, i) => {
                                const color = a.salidaPrevia ? 'text-error' : 'text-base-content/60';
                                return (
                                  <a
                                    href={`/people/${a.personId}`}
                                    data-gv-name={i}
                                    data-gv-cartera={car.ministerioId}
                                    data-gv-desde={a.desdeGob}
                                    data-gv-vigente={!a.hastaGob ? '1' : undefined}
                                    class={`gv-name absolute top-0 truncate pr-0.5 ${color} hover:underline`}
                                    style={`left:${leftPct.toFixed(2)}%;width:${widthPct.toFixed(2)}%;`}
                                    title={`${a.nombre} · ${duracionCorta(a)}${etiquetaDias(a, tDatos)}`}
                                  >
                                    {a.nombre}
                                  </a>
                                );
                              })}
                            </div>
                          </div>
                          {/* Móvil: escalonado por titular. Cada fila es un segmento de
                              la línea de tiempo con SU propia barra proporcional (misma
                              escala 0-100% del mandato que el eje) y el nombre justo
                              debajo: la conexión barra↔nombre es directa, sin hover. */}
                          <ul class="sm:hidden mt-2 space-y-2">
                            {segmentos.map(({ leftPct, widthPct, a }, i) => (
                              <li class="flex items-center gap-2.5">
                                <span class="relative h-4 w-24 shrink-0 rounded-sm bg-base-200/80 overflow-hidden" aria-hidden="true">
                                  <span
                                    class={`absolute inset-y-0 rounded-sm ${a.salidaPrevia ? 'bg-error/70' : 'bg-primary/70'}`}
                                    style={`left:${leftPct.toFixed(2)}%;width:${widthPct.toFixed(2)}%;`}
                                  ></span>
                                </span>
                                <span class="min-w-0 text-[11px] leading-snug">
                                  <a href={`/people/${a.personId}`} data-gv-name={i} data-gv-cartera={car.ministerioId} class={`gv-name font-semibold ${a.salidaPrevia ? 'text-error' : 'text-base-content'} hover:underline`}>{a.nombre}</a>
                                  <span class="text-base-content/40"> · {duracionCorta(a)}{!a.hastaGob ? <span data-gv-dias-span data-gv-desde={a.desdeGob} data-gv-vigente="1">{etiquetaDias(a, tDatos)}</span> : etiquetaDias(a, tDatos)}{a.salidaPrevia ? ' · salió antes del término' : ''}{a.biministro ? ' · biministro' : ''}{a.subrogante ? ' · subrogante' : ''}</span>
                                </span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            )}

            <div class="px-5 pb-4 space-y-1.5">
              {g.carteras.flatMap((car) =>
                car.titulares
                  .filter((a) => a.salidaPrevia)
                  .map((a) => (
                    <p class="flex items-start gap-1.5 text-xs text-error/80 pl-1">
                      <UserX class="h-3.5 w-3.5 shrink-0 mt-0.5" />
                      <span>
                        <a href={`/people/${a.personId}`} class="font-semibold text-error hover:underline">{a.nombre}</a>
                        <span class="text-base-content/60"> — {car.ministerioNombre.toLowerCase()} · {a.cargo.toLowerCase()} · salió {fechaEs(a.hasta) ?? 'sin fecha'} {a.biministro ? '· biministro' : ''}{a.subrogante ? '· subrogante' : ''}</span>
                      </span>
                    </p>
                  ))
              )}
            </div>
          </div>
        </section>
      );
    })}
  </div>

  <p class="text-xs text-base-content/40 mt-8 leading-relaxed">
    «En ejercicio» = cargo sin fecha de término; «fechas sin registrar» indica información incompleta. En «Por gobierno» cada barra cubre el mandato completo (4 años): azul = completó el periodo o sigue vigente, rojo = salida anticipada. Pulsa un nombre o segmento para ver la ficha de la persona.
  </p>
</Base>

<script>
  // Toggle de vista (por cartera / por gobierno) + selector de presidente.
  // Patrón del sitio: listeners globales registrados una sola vez; en
  // astro:page-load se re-aplica el estado del DOM actual.
  const STORAGE_VIEW = 'gv-gabinete-vista';
  const STORAGE_GOB = 'gv-gabinete-gobierno';

  function gvApplyView(view: string) {
    document.querySelectorAll('[data-gv-panel]').forEach((el) => {
      el.classList.toggle('hidden', el.getAttribute('data-gv-panel') !== view);
    });
    document.querySelectorAll('.gv-view-btn').forEach((btn) => {
      const active = btn.getAttribute('data-gv-view') === view;
      btn.setAttribute('aria-selected', String(active));
      btn.className = `gv-view-btn rounded-lg px-4 py-2 text-sm font-semibold transition-colors cursor-pointer ${active ? 'bg-base-100 shadow-sm text-base-content' : 'text-base-content/60 hover:text-base-content'}`;
    });
    gvPackNames();
  }

  function gvApplyGob(id: string) {
    document.querySelectorAll('[data-gv-gob-panel]').forEach((el) => {
      el.classList.toggle('hidden', el.getAttribute('data-gv-gob-panel') !== id);
    });
    document.querySelectorAll('.gv-gob-btn').forEach((btn) => {
      const active = btn.getAttribute('data-gv-gob') === id;
      btn.setAttribute('aria-selected', String(active));
      btn.className = `gv-gob-btn rounded-lg border px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer ${active ? 'border-primary/60 bg-primary/10 text-primary' : 'border-base-300 bg-base-100 text-base-content/70 hover:border-primary/50 hover:text-primary'}`;
    });
    gvPackNames();
  }

  // ---- Empaquetado de nombres bajo las barras Gantt (vista escritorio) ----
  // Cada nombre se posiciona al inicio % de su segmento, pero ocupa su ANCHO
  // NATURAL (nowrap): los segmentos muy cortos (ministros reemplazados en
  // cuestión de días) ya no truncan el nombre. Cuando dos nombres se cruzan,
  // el segundo baja a la fila siguiente (greedy por filas) y una línea
  // vertical lo conecta con su barra. Se recalcula al cambiar de gobierno,
  // de vista, al navegar (View Transitions) y al redimensionar.
  function gvPackNames() {
    if (window.matchMedia('(max-width: 639px)').matches) return; // móvil usa lista escalonada
    document.querySelectorAll<HTMLElement>('.gv-names').forEach((row) => {
      const names = Array.from(row.querySelectorAll<HTMLElement>('.gv-name'));
      const cw = row.clientWidth;
      if (!names.length || cw === 0) return; // panel oculto: medir no tiene sentido
      const rowEnds: number[] = [];
      names.forEach((el) => {
        // Reset a estado medible: ancho auto + nowrap natural (truncate aporta el nowrap).
        el.style.top = '0px';
        el.style.width = 'auto';
        el.style.overflow = 'visible';
        el.style.textOverflow = 'clip';
        el.classList.remove('gv-trunc');
        const startPct = parseFloat(el.style.left ?? '0') || 0;
        const startPx = (startPct / 100) * cw;
        // Primera fila cuyo último nombre termina antes de que empiece este.
        let r = rowEnds.findIndex((end) => end <= startPx + 1);
        if (r === -1) {
          r = rowEnds.length;
          rowEnds.push(0);
        }
        // No desbordar el contenedor: clamp al espacio restante.
        rowEnds[r] = startPx + Math.min(el.offsetWidth, cw - startPx);
        const natural = el.offsetWidth;
        el.style.setProperty('--gv-row', String(r));
        el.style.top = `${r * 16}px`; // leading-4 = 16px por fila
        el.classList.toggle('gv-row-deep', r > 0);
        if (natural > cw - startPx) {
          el.style.width = `${cw - startPx}px`;
          el.style.overflow = 'hidden';
          el.style.textOverflow = 'ellipsis';
          el.classList.add('gv-trunc');
        } else {
          el.style.width = 'auto';
        }
      });
      row.style.height = `${Math.max(1, rowEnds.length) * 16}px`;
    });
  }

  // ---- Refresco de "hoy" en el gobierno en ejercicio (fecha real del cliente) ----
  // El SSR corta las duraciones/barras en la fecha del build (fallback sin-JS);
  // si el deploy queda stale, esto re-ancla el corte a la fecha actual SOLO con
  // datos ya presentes en el DOM (desde/vigente por segmento): no inventa
  // ministros nuevos — esos requieren rebuild. No-JS ve el snapshot con su
  // "corte al <fecha build>" explícito.
  const GV_MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

  function gvRefreshHoy() {
    const panel = document.querySelector<HTMLElement>('[data-gv-actual]');
    if (!panel) return;
    const t0 = Number(panel.dataset.gvT0);
    const t1 = Number(panel.dataset.gvTfin);
    const tBuild = Number(panel.dataset.gvTdatos);
    const hoyIso = new Date().toISOString().slice(0, 10);
    const hoy = new Date(hoyIso).getTime();
    if (!t0 || !t1 || !hoy || hoy <= tBuild) return; // build al día o reloj del cliente atrás
    const pct = ((hoy - t0) / (t1 - t0)) * 100;
    panel.querySelectorAll<HTMLElement>('[data-gv-hoy]').forEach((el) => {
      el.style.left = `${pct.toFixed(2)}%`;
    });
    const items: { nombre: string; dias: number }[] = [];
    // OJO: los data-* viajan como strings ISO ("2026-03-11"); Number() da NaN —
    // parsear con Date.parse.
    const diasDe = (el: HTMLElement) => {
      const ms = Date.parse(el.dataset.gvDesde ?? '');
      return Number.isNaN(ms) ? null : Math.max(0, Math.round((hoy - ms) / 86400000));
    };
    panel.querySelectorAll<HTMLElement>('[data-gv-vigente]').forEach((el) => {
      const dias = diasDe(el);
      if (dias == null) return;
      if (el.classList.contains('gv-seg') || el.classList.contains('gv-name')) {
        const leftPct = parseFloat(el.style.left ?? '0') || 0;
        el.style.width = `${Math.max(1.5, pct - leftPct).toFixed(2)}%`;
      }
      if (el.hasAttribute('data-gv-dias-span')) {
        el.textContent = ` · ${dias} ${dias === 1 ? 'día' : 'días'} en ejercicio`;
      }
    });
    // Stats (media, más longevo, más breve): los fijos aportan su duración
    // congelada (data-gv-dias); los vigentes se recalculan con hoy.
    panel.querySelectorAll<HTMLElement>('.gv-seg').forEach((seg) => {
      const dias = seg.hasAttribute('data-gv-vigente') ? diasDe(seg) : Number(seg.dataset.gvDias);
      if (dias != null && !Number.isNaN(dias)) items.push({ nombre: seg.dataset.gvNombre ?? '', dias });
    });
    if (items.length) {
      const prom = Math.round(items.reduce((s, x) => s + x.dias, 0) / items.length);
      const max = items.reduce((m, x) => (x.dias > m.dias ? x : m));
      const min = items.reduce((m, x) => (x.dias < m.dias ? x : m));
      const set = (sel: string, v: string) => {
        const el = panel.querySelector<HTMLElement>(sel);
        if (el) el.textContent = v;
      };
      set('[data-gv-stat-prom]', String(prom));
      set('[data-gv-stat-longevo]', max.nombre);
      set('[data-gv-stat-longevo-dias]', String(max.dias));
      set('[data-gv-stat-breve]', min.nombre);
      set('[data-gv-stat-breve-dias]', String(min.dias));
    }
    const [y, m, d] = hoyIso.split('-').map(Number);
    const corte = panel.querySelector<HTMLElement>('[data-gv-corte]');
    if (corte && y && m && d) corte.textContent = ` · corte al ${d} de ${GV_MESES[m - 1]} de ${y}`;
  }

  function gvInitGabinete() {
    const view = localStorage.getItem(STORAGE_VIEW) === 'gobiernos' ? 'gobiernos' : 'carteras';
    gvApplyView(view);
    const gobIds = (window as any).__gvGobiernosIds ?? [];
    const saved = localStorage.getItem(STORAGE_GOB);
    const gob = saved && gobIds.includes(saved) ? saved : 'kast';
    gvApplyGob(gob);
  }

  if (!(window as any).__gvGabineteInit) {
    (window as any).__gvGabineteInit = true;
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const viewBtn = target.closest('[data-gv-view]');
      if (viewBtn) {
        const view = viewBtn.getAttribute('data-gv-view')!;
        localStorage.setItem(STORAGE_VIEW, view);
        gvApplyView(view);
        return;
      }
      const gobBtn = target.closest('[data-gv-gob]');
      if (gobBtn) {
        const id = gobBtn.getAttribute('data-gv-gob')!;
        localStorage.setItem(STORAGE_GOB, id);
        gvApplyGob(id);
        return;
      }
    });

    // Re-empaquetar nombres al cambiar el ancho del viewport (debounce 120ms).
    let gvPackTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(gvPackTimer);
      gvPackTimer = setTimeout(gvPackNames, 120);
    });

    // Hover cruzado nombre ↔ segmento: al pasar el mouse sobre un nombre bajo la
    // barra, el SEGMENTO correspondiente en la barra se oscurece con su color de
    // hover natural (igual que el hover directo sobre la barra). El nombre no se
    // pinta a sí mismo: la conexión visual se ve en la barra. Delegación en
    // document para sobrevivir a las View Transitions (DOM re-montado).
    // OJO: la búsqueda del segmento se acota al PANEL visible (closest
    // [data-gv-gob-panel]). La misma cartera existe en los paneles de todos los
    // gobiernos (la mayoría ocultos), y querySelector global devolvía el primer
    // match del documento — un segmento de un panel oculto —, por lo que el
    // resaltado no se veía (afectaba sobre todo a los segmentos rojos de salida
    // anticipada, por el orden de los paneles).
    function gvHlClear() {
      document.querySelectorAll('.gv-seg-hl').forEach((el) => el.classList.remove('gv-seg-hl'));
    }
    function gvHlShow(scope: ParentNode, cartera: string, idx: string) {
      gvHlClear();
      const s = scope.querySelector(`.gv-seg[data-gv-cartera="${cartera}"][data-gv-seg="${idx}"]`);
      if (s) s.classList.add('gv-seg-hl');
    }
    document.addEventListener('mouseover', (e) => {
      const target = e.target as HTMLElement;
      const seg = target.closest<HTMLElement>('.gv-seg[data-gv-cartera]');
      const name = target.closest<HTMLElement>('.gv-name[data-gv-cartera]');
      if (!seg && !name) return;
      const el = (seg ?? name)!;
      const cartera = el.getAttribute('data-gv-cartera')!;
      const idx = el.getAttribute(seg ? 'data-gv-seg' : 'data-gv-name')!;
      gvHlShow(el.closest('[data-gv-gob-panel]') ?? document, cartera, idx);
    });
    document.addEventListener('mouseout', (e) => {
      const target = e.target as HTMLElement;
      const rel = e.relatedTarget as HTMLElement | null;
      const sigueEnPar = !!(rel && (rel.closest('.gv-seg[data-gv-cartera]') || rel.closest('.gv-name[data-gv-cartera]')));
      if (target.closest('.gv-seg[data-gv-cartera]') || target.closest('.gv-name[data-gv-cartera]')) {
        if (!sigueEnPar) gvHlClear();
      }
    });
  }

  // Re-aplica estado tras cada navegación (View Transitions re-monta el DOM).
  document.addEventListener('astro:page-load', () => {
    (window as any).__gvGobiernosIds = Array.from(document.querySelectorAll('[data-gv-gob-panel]')).map((el) => el.getAttribute('data-gv-gob-panel'));
    gvInitGabinete();
    // Refresca "hoy" ANTES del empaquetado de nombres (los anchos cambian).
    gvRefreshHoy();
    // Tras el init del toggle, los paneles visibles ya tienen ancho medible.
    requestAnimationFrame(gvPackNames);
  });
  (window as any).__gvGobiernosIds = Array.from(document.querySelectorAll('[data-gv-gob-panel]')).map((el) => el.getAttribute('data-gv-gob-panel'));
  gvInitGabinete();
  gvRefreshHoy();
  requestAnimationFrame(gvPackNames);
</script>

<style>
  /* Separación visual entre segmentos consecutivos: línea del color de fondo
     (base-100 del tema) a la izquierda de todo segmento que no sea el primero,
     para que dos o más titulares seguidos (p. ej. dos salidas anticipadas rojas)
     no se fundan en una sola barra. */
  .gv-seg:not(:first-child) {
    border-left: 2px solid var(--color-base-100);
  }

  /* Conexión visual nombre ↔ barra: el efecto de hover ocurre en el SEGMENTO de
     la barra (pasa a su color pleno del tema, rojo o azul más intenso, igual que
     si el cursor estuviera sobre la barra), no en el nombre. Además se atenúan
     los demás segmentos de la misma barra para que se vea cuál corresponde.
     OJO: en daisyUI 5 --color-error/--color-primary son colores COMPLETOS
     (oklch(...)), no canales → usarlos directo, sin oklch(var(...) / a). El
     selector de clase necesita el / escapado (bg-primary\/70); sin escape la
     regla es CSS inválido y no aplica (bug real: el highlight nunca se veía). */
  .gv-seg-hl {
    z-index: 5;
  }
  .gv-seg-hl.bg-error\/70 {
    background-color: var(--color-error);
    box-shadow: 0 0 0 1.5px var(--color-base-100);
  }
  .gv-seg-hl.bg-primary\/70 {
    background-color: var(--color-primary);
    box-shadow: 0 0 0 1.5px var(--color-base-100);
  }
  /* El resto de la barra se atenúa mientras un segmento está resaltado. */
  .gv-bar:has(> .gv-seg-hl) > .gv-seg:not(.gv-seg-hl) {
    opacity: 0.3;
  }

  /* Nombres empaquetados en filas (script gvPackNames): los que bajan a una fila
     posterior llevan una línea vertical que los conecta con su segmento en la
     barra (--gv-row = fila, 1rem por fila = leading-4). */
  .gv-name {
    --gv-row: 0;
  }
  .gv-name.gv-row-deep::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 100%;
    width: 1px;
    height: calc(var(--gv-row) * 1rem + 2px);
    background: color-mix(in oklab, currentColor 40%, transparent);
  }
</style>
