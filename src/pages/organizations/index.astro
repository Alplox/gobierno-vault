---
import Base from '../../layouts/Base.astro';
import { getAllOrganizations } from '../../lib/queries';
import { Building2, Layers, ChevronRight } from 'lucide-astro';

const orgs = await getAllOrganizations();
---

<Base title="Organizaciones">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <Building2 class="h-6 w-6 text-blue-600 shrink-0" />
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">Organizaciones</h1>
    </div>
    <p class="text-gray-500 text-sm">Ministerios, instituciones públicas, entidades y organismos referenciados.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    {orgs.map((org) => (
      <a href={`/organizations/${org.id}`} class="group block border border-gray-200/80 shadow-sm rounded-xl p-5 hover:border-blue-300 hover:shadow-md active:scale-[0.99] transition-all duration-200 bg-white">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <h3 class="font-bold text-gray-900 text-base group-hover:text-blue-600 transition-colors leading-snug">{org.data.nombre}</h3>
            {org.data.tipo && (
              <p class="flex items-center gap-1.5 text-xs text-gray-600 font-medium mt-1">
                <Layers class="h-3.5 w-3.5 text-gray-400 shrink-0" />
                <span>{org.data.tipo}</span>
              </p>
            )}
          </div>
          <ChevronRight class="h-5 w-5 text-gray-300 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all shrink-0 mt-1" />
        </div>
      </a>
    ))}
  </div>
</Base>

