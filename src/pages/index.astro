---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { getAllEvents } from '../lib/queries';
import { Calendar, Shield } from 'lucide-astro';

const events = await getAllEvents();
---

<Base title="Inicio">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <Calendar class="h-6 w-6 text-blue-600 shrink-0" />
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">Línea Temporal</h1>
    </div>
    <p class="text-gray-500 text-sm">Acontecimientos políticos y de gobierno registrados en la base de conocimiento, organizados por décadas, años, meses y días. Haz clic en los encabezados para plegar o expandir cada período.</p>
    <p class="text-gray-500 text-sm">¡Aún en desarrollo!</p>
  </div>
  <Timeline events={events} />
</Base>

