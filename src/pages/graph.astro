---
import Base from '../layouts/Base.astro';
import EventGraph from '../components/EventGraph.astro';
import { getAllEvents } from '../lib/queries';
import { buildConnectionIndex } from '../lib/relations';
import { ArrowLeft, GitFork } from 'lucide-astro';

const events = await getAllEvents();
const connectionIndex = buildConnectionIndex(events);
---

<Base title="Grafo de Relaciones">
  <article class="max-w-6xl mx-auto">
    <div class="mb-6">
      <a href="/events" class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-700 bg-blue-50 px-2.5 py-1 rounded-lg transition-colors">
        <ArrowLeft class="h-3.5 w-3.5" />
        <span>Volver a Eventos</span>
      </a>
    </div>
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-1">
        <GitFork class="h-6 w-6 text-blue-600 shrink-0" />
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">Grafo de Relaciones</h1>
      </div>
      <p class="text-gray-500 text-sm">Visualización de conexiones entre eventos del vault.</p>
    </div>
    <EventGraph events={events} connectionIndex={connectionIndex} size="full" />
  </article>
  <script>
    import '../scripts/force-graph.js';
  </script>
</Base>
