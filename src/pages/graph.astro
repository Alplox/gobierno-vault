---
import Base from '../layouts/Base.astro';
import EventGraph from '../components/EventGraph.astro';
import { getAllEvents, getUniqueTopics, getUniquePeople, getUniqueOrgs, getTopicsMap, getPeopleMap, getOrgsMap } from '../lib/queries';
import { buildConnectionIndex, eventYearFromDate } from '../lib/relations';
import { TIPO_LABELS } from '../lib/eventTypes';
import { ArrowLeft, GitFork } from 'lucide-astro';

const events = await getAllEvents();
const connectionIndex = buildConnectionIndex(events);

const [topicIds, personIds, orgIds, topicsMap, peopleMap, orgsMap] = await Promise.all([
  getUniqueTopics(),
  getUniquePeople(),
  getUniqueOrgs(),
  getTopicsMap(),
  getPeopleMap(),
  getOrgsMap(),
]);
const filters = {
  topics: topicIds.map((id) => ({ id, label: topicsMap.get(id) ?? id })),
  people: personIds.map((id) => ({ id, label: peopleMap.get(id) ?? id })),
  orgs: orgIds.map((id) => ({ id, label: orgsMap.get(id) ?? id })),
  tipos: Object.entries(TIPO_LABELS).map(([id, label]) => ({ id, label })),
  years: [...new Set(events.map((e) => eventYearFromDate(e.data.fecha)))].sort((a, b) => b - a),
};
---

<Base title="Grafo de Relaciones">
  <article class="max-w-6xl mx-auto">
    <div class="mb-6">
      <a href="/events" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary bg-primary/10 px-2.5 py-1 rounded-lg transition-colors">
        <ArrowLeft class="h-3.5 w-3.5" />
        <span>Volver a Eventos</span>
      </a>
    </div>
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-1">
        <GitFork class="h-6 w-6 text-primary shrink-0" />
        <h1 class="text-2xl sm:text-3xl font-bold text-base-content leading-tight">Grafo de Relaciones</h1>
      </div>
      <p class="text-base-content/60 text-sm">Visualización de conexiones entre eventos del vault.</p>
    </div>
    <EventGraph events={events} connectionIndex={connectionIndex} size="full" filters={filters} />
  </article>
  <script>
    import '../scripts/force-graph.js';
  </script>
</Base>
