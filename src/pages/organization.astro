---
import Base from '../layouts/Base.astro';
import { ArrowLeft } from 'lucide-astro';
---

<Base title="Organización">
  <div class="mb-6">
    <a href="/organizations" class="inline-flex items-center gap-1.5 text-xs font-semibold text-base-content hover:text-base-content bg-primary/10 px-2.5 py-1 rounded-lg transition-colors">
      <ArrowLeft class="h-3.5 w-3.5" />
      <span>Volver a Organizaciones</span>
    </a>
  </div>

  <div id="org-detail" role="status" aria-live="polite">
    <p class="text-sm text-base-content/80 bg-base-100 p-8 rounded-xl border border-base-300 text-center">Cargando organización…</p>
  </div>
</Base>

<script>
  type Titular = {
    nombre: string; personId: string; cargo: string; periodo: string;
    actual: boolean; biministro: boolean; subrogante: boolean;
  };
  type Org = {
    id: string; nombre: string; tipo: string; pais: string; bio: string;
    titulares: Titular[]; eventIds: string[];
  };
  type Payload = {
    data: Org[];
    eventsById: Record<string, { titulo: string; href: string }>;
  };

  let cached: Payload | null = null;
  let pending: Promise<Payload> | null = null;

  function load(): Promise<Payload> {
    if (cached) return Promise.resolve(cached);
    if (!pending) {
      pending = fetch('/data/organizations.json')
        .then((r) => {
          if (!r.ok) throw new Error(`HTTP ${r.status}`);
          return r.json() as Promise<Payload>;
        })
        .then((p) => { cached = p; return p; });
    }
    return pending;
  }

  function el(tag: string, cls: string, text?: string) {
    const n = document.createElement(tag);
    n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  function badge(text: string, cls: string) {
    return el('span', `ml-2 text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded-full ${cls}`, text);
  }

  async function render() {
    const root = document.getElementById('org-detail');
    if (!root) return;
    let payload: Payload;
    try {
      payload = await load();
    } catch {
      document.title = 'Organización no disponible — Gobierno Vault';
      root.replaceChildren(el('p', 'text-sm text-base-content/80 bg-base-100 p-8 rounded-xl border border-base-300 text-center', 'No se pudo cargar el registro de organizaciones. Intenta recargar la página.'));
      return;
    }

    const id = new URLSearchParams(location.search).get('id') ?? '';
    const o = payload.data.find((x) => x.id === id);
    root.replaceChildren();

    if (!o) {
      document.title = 'Organización no encontrada — Gobierno Vault';
      const box = el('div', 'text-center bg-base-100 p-8 rounded-xl border border-base-300');
      box.appendChild(el('h1', 'text-xl font-bold mb-2', 'Organización no encontrada'));
      box.appendChild(el('p', 'text-sm text-base-content/80 mb-4', id ? `No hay una organización registrada con el ID «${id}».` : 'No se indicó el ID de la organización.'));
      const a = el('a', 'text-sm font-semibold text-base-content hover:underline', 'Volver a Organizaciones');
      a.href = '/organizations';
      box.appendChild(a);
      root.appendChild(box);
      return;
    }

    document.title = `${o.nombre} — Gobierno Vault`;
    const header = el('header', 'mb-8 bg-base-100 p-6 sm:p-8 rounded-2xl border-0 shadow-[var(--shadow-border)]');
    const flex = el('div', 'flex items-start gap-4');
    const icon = el('div', 'h-12 w-12 rounded-full bg-primary/15 text-base-content flex items-center justify-center shrink-0');
    icon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M16 6h.01M12 6h.01M12 10h.01M16 10h.01M8 10h.01M12 14h.01M16 14h.01M8 14h.01"/></svg>';
    flex.appendChild(icon);
    const main = el('div', 'min-w-0 flex-1');
    main.appendChild(el('h1', 'text-2xl sm:text-3xl font-bold text-base-content leading-tight', o.nombre));
    if (o.tipo) main.appendChild(el('p', 'flex items-center gap-1.5 text-sm text-base-content/80 font-medium mt-1', o.tipo));
    if (o.pais) main.appendChild(el('p', 'text-xs text-base-content/80 mt-1', `País: ${o.pais}`));
    flex.appendChild(main);
    header.appendChild(flex);
    root.appendChild(header);

    if (o.bio) {
      const bio = el('div', 'prose prose-gray max-w-none mb-8 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)] leading-relaxed');
      bio.innerHTML = o.bio;
      root.appendChild(bio);
    }

    if (o.titulares.length) {
      const section = el('section', 'mb-8 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]');
      section.appendChild(el('h2', 'text-lg font-bold text-base-content mb-4', 'Titulares de la organización'));
      const ul = el('ul', 'space-y-3');
      for (const a of o.titulares) {
        const li = el('li', 'flex items-start gap-3');
        li.appendChild(el('span', `mt-1.5 h-2.5 w-2.5 rounded-full shrink-0 ${a.actual ? 'bg-primary' : 'bg-base-300'}`));
        const div = el('div');
        const p = el('p', 'text-sm font-semibold text-base-content');
        const link = el('a', 'hover:text-base-content transition-colors', a.nombre);
        link.href = `/people/${a.personId}`;
        p.appendChild(link);
        if (a.actual) p.appendChild(badge('En ejercicio', 'bg-primary/15 text-base-content'));
        if (a.biministro) p.appendChild(badge('Biministro', 'bg-warning/20 text-warning'));
        if (a.subrogante) p.appendChild(badge('Subrogante', 'bg-warning/20 text-warning'));
        div.appendChild(p);
        div.appendChild(el('p', 'text-xs text-base-content/80 mt-0.5', `${a.cargo} · ${a.periodo}`));
        li.appendChild(div);
        ul.appendChild(li);
      }
      section.appendChild(ul);
      root.appendChild(section);
    }

    const section = el('section', 'mt-8');
    const related = (o.eventIds ?? [])
      .map((eid) => payload.eventsById[eid.split('/').pop() ?? eid])
      .filter(Boolean);
    section.appendChild(el('h2', 'text-lg font-bold text-base-content mb-4', `Eventos relacionados (${related.length})`));
    const grid = el('div', 'grid gap-4');
    for (const ev of related) {
      const a = el('a', 'block bg-base-100 p-4 rounded-xl border-0 shadow-[var(--shadow-border)] hover:shadow-md transition-shadow font-semibold text-base-content', ev.titulo);
      a.href = ev.href;
      grid.appendChild(a);
    }
    if (related.length === 0) {
      grid.appendChild(el('p', 'text-sm text-base-content/80 bg-base-100 p-8 rounded-xl border border-dashed border-base-300 text-center', 'No hay eventos registrados para esta organización.'));
    }
    section.appendChild(grid);
    root.appendChild(section);
  }

  render();
  document.addEventListener('astro:page-load', render);
</script>
