---
import Base from '../layouts/Base.astro';
import SRef from '../components/sueldos/SRef.astro';
import { DollarSign, Scale, TrendingUp, BookOpen, ExternalLink } from 'lucide-astro';
import { getSueldos } from '../lib/sueldos';

// Todos los datos viven en src/data/sueldos.yaml; los valores derivados (ratios,
// ajustes IPC, brechas) se calculan en src/lib/sueldos.ts. El template no
// escribe montos ni periodos en la prosa: los obtiene de `d`.
const d = getSueldos();
const {
  fuentes,
  presidentes,
  actualPresidente,
  indicadores,
  sueldo_minimo,
  serie_registro_publico,
} = d;
const { formatCLP, pctDiff } = d;
const {
  ratios,
  sueldosAjustados,
  maxAjustado,
  promedioPrevios,
  pctInferiorKast,
  ratioBoricVecesRedondeado,
  ratio2010sTexto,
  ratioBacheletITexto,
  ratioLegalKast,
  legalDiet,
} = d.derivados;

const cargos = d.segundo_piso.cargos;
const segundoPisoFuenteId = d.segundo_piso.fuente.id;
const topesFuenteId = d.topes_dipres.fuente.id;
const topes = d.topes_dipres.filas;
const brecha = d.brecha;
const esi = d.ingresos_esi;
const costoVida = d.costo_vida;
const imm = d.imm_2026;
const casen = d.casen_2024;
const ipcDestino = d.ipc.mes_referencia;
const [ipcYear, ipcMonth] = ipcDestino.split('-').map(Number);
const MESES = [
  'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
  'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
];
const MESES_AB = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const ipcDestinoLabel = `${MESES[ipcMonth - 1]} de ${ipcYear}`;

const fmtDecimal = (n: number) => n.toFixed(1).replace('.', ',');
const fmtMillones = (n: number) => `$${(n / 1_000_000).toFixed(0)}M`;
const fmtPorcentaje = (n: number) => `${fmtDecimal(n)}%`;
const fmtFecha = (iso: string) => iso.split('-').reverse().join('/');
const fmtMes = (iso: string | null) => {
  if (!iso) return '—';
  const [year, month] = iso.split('-').map(Number);
  return `${MESES_AB[month - 1]} ${String(year).slice(2)}`;
};
const fmtPeriodo = (periodo: string) => {
  const [year, month] = periodo.split('-').map(Number);
  return `${MESES_AB[month - 1]} ${String(year).slice(2)}`;
};
const fmtVigencia = (v: { desde?: string; hasta?: string }) => {
  if (v.desde && v.hasta) return `${fmtFecha(v.desde)}–${fmtFecha(v.hasta)}`;
  if (v.desde) return `desde ${fmtFecha(v.desde)}`;
  return 'fecha no especificada';
};
const tipoVigencia = (tipo?: string) => tipo ? tipo[0].toUpperCase() + tipo.slice(1) : 'Monto';

// --- Línea de tiempo mensual (Registro Público): geometría del SVG estático ---
const serie = serie_registro_publico.puntos;
const CH = { W: 760, H: 310, mL: 64, mR: 18, mT: 24, mB: 42 };
const yMinRaw = Math.min(...serie.map((p) => p.monto));
const yMaxRaw = Math.max(...serie.map((p) => p.monto));
const yMinChart = Math.floor((yMinRaw - 300_000) / 500_000) * 500_000;
const yMaxChart = Math.ceil((yMaxRaw + 300_000) / 500_000) * 500_000;
const chX = (i: number) => CH.mL + (i * (CH.W - CH.mL - CH.mR)) / (serie.length - 1);
const chY = (v: number) => CH.mT + (CH.H - CH.mT - CH.mB) * (1 - (v - yMinChart) / (yMaxChart - yMinChart));
const seriePath = serie
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${chX(i).toFixed(1)},${chY(p.monto).toFixed(1)}`)
  .join(' ');
const iTrans = serie.findIndex((p) => p.gobierno === 'Kast');
const xTrans = iTrans > 0 ? (chX(iTrans - 1) + chX(iTrans)) / 2 : CH.mL;
const chartGrid = Array.from(
  { length: Math.floor((yMaxChart - yMinChart) / 1_000_000) + 1 },
  (_, i) => yMinChart + i * 1_000_000,
);
const chartTicks = [...new Set([0, 3, 6, 9, 12, serie.length - 1])].filter((i) => i >= 0 && i < serie.length);
const puntoTransicion = serie[iTrans];
const puntoAnterior = iTrans > 0 ? serie[iTrans - 1] : undefined;
const puntoKastCompleto = serie[iTrans + 1];
const saltoFebAbr = puntoKastCompleto && puntoAnterior
  ? (puntoKastCompleto.monto / puntoAnterior.monto - 1) * 100
  : 0;
const chartTitle = `Remuneración bruta mensual del Presidente, ${fmtPeriodo(serie[0].periodo)} – ${fmtPeriodo(serie[serie.length - 1].periodo)}`;
const chartDesc = `Serie reportada por la Comisión para la Fijación de Remuneraciones. El último punto es ${formatCLP(serie[serie.length - 1].monto)} en ${fmtPeriodo(serie[serie.length - 1].periodo)}.`;
const bonoPuntos = serie.filter((p) => p.tipo === 'bono');
const promedioSegundoPisoKast = Math.round(cargos.reduce((sum, c) => sum + c.kast.sueldo, 0) / cargos.length);
const promedioSegundoPisoBoric = Math.round(cargos.reduce((sum, c) => sum + c.boric.sueldo, 0) / cargos.length);
const cambioPromedioSegundoPiso = ((promedioSegundoPisoKast / promedioSegundoPisoBoric) - 1) * 100;
const promedioCambiosSegundoPiso = cargos.reduce((sum, c) => sum + ((c.kast.sueldo / c.boric.sueldo) - 1), 0) / cargos.length * 100;

const umbralesCostoVida = [
  { etiqueta: 'CBA por persona', monto: costoVida.cba_persona, unidad: 'canasta básica de alimentos' },
  { etiqueta: 'Línea de pobreza · no arrendatario', monto: costoVida.linea_pobreza_no_arrendatario, unidad: 'persona equivalente' },
  { etiqueta: 'Línea de pobreza extrema · no arrendatario', monto: costoVida.linea_pobreza_extrema_no_arrendatario, unidad: 'persona equivalente' },
  { etiqueta: 'Línea de pobreza · arrendatario', monto: costoVida.linea_pobreza_arrendatario, unidad: 'persona equivalente' },
  { etiqueta: 'Línea de pobreza extrema · arrendatario', monto: costoVida.linea_pobreza_extrema_arrendatario, unidad: 'persona equivalente' },
];
---

<Base title="Sueldos y brecha salarial">
  <article class="max-w-4xl mx-auto">
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-1">
        <DollarSign class="h-6 w-6 text-primary shrink-0" />
        <h1 class="text-2xl sm:text-3xl font-bold text-base-content leading-tight">Sueldos del sector público y brecha salarial</h1>
      </div>
      <p class="text-base-content/60 text-sm">
        Remuneraciones del Registro Público 38 bis, ingresos laborales de la ESI y umbrales oficiales de costo de vida. Cada cifra conserva su periodo, unidad y fuente primaria.
      </p>
    </header>

    <section id="brecha" class="mb-10 bg-base-100 p-5 sm:p-6 rounded-2xl border border-primary/20 shadow-[var(--shadow-border)]">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary mb-2">Brecha en una mirada</p>
          <h2 class="text-xl sm:text-2xl font-bold text-base-content leading-tight">El Estado y la ciudadanía no viven la misma escala de ingresos</h2>
          <p class="text-sm text-base-content/65 mt-2">
            El último registro presidencial es bruto y de julio de 2026. La ESI mide ingresos netos de personas ocupadas en 2025; las líneas de pobreza son umbrales por persona equivalente de agosto de 2026.
          </p>
        </div>
        <div class="rounded-xl bg-primary/10 text-primary px-3 py-2 text-xs font-semibold text-right">
          <div>Presidente</div>
          <div class="text-lg tabular-nums">{formatCLP(brecha.presidente.monto)}</div>
          <div class="font-normal">bruto / mes</div>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-5">
        {brecha.tarjetas.map((t) => (
          <article class={`rounded-xl border p-4 ${t.clave === 'presidente' ? 'border-primary/40 bg-primary/5' : 'border-base-300 bg-base-200/40'}`}>
            <p class="text-xs font-semibold text-base-content/60 leading-snug">{t.etiqueta}</p>
            <p class="text-xl font-bold tabular-nums text-base-content mt-2">{formatCLP(t.monto)}</p>
            <p class="text-[11px] text-base-content/55 mt-1">{t.unidad} <SRef id={t.fuente.id} /></p>
          </article>
        ))}
      </div>

      <div class="overflow-x-auto rounded-xl border border-base-300">
        <table class="w-full text-sm border-collapse">
          <caption class="sr-only">Comparación de magnitudes entre remuneración presidencial e ingresos y umbrales de referencia</caption>
          <thead>
            <tr class="border-b border-base-300 bg-base-200/50">
              <th class="text-left py-2.5 px-3 font-semibold text-base-content/75">Referencia</th>
              <th class="text-right py-2.5 px-3 font-semibold text-base-content/75">Monto</th>
              <th class="text-right py-2.5 px-3 font-semibold text-base-content/75">Presidente ÷ referencia</th>
              <th class="text-left py-2.5 px-3 font-semibold text-base-content/75">Qué mide</th>
            </tr>
          </thead>
          <tbody>
            {brecha.comparaciones.map((c) => (
              <tr class="border-b border-base-300 last:border-0">
                <td class="py-2.5 px-3 text-base-content/85">{c.etiqueta} <SRef id={c.fuente.id} /></td>
                <td class="py-2.5 px-3 text-right tabular-nums whitespace-nowrap">{formatCLP(c.monto)}<span class="block text-[10px] text-base-content/45">{c.unidad}</span></td>
                <td class="py-2.5 px-3 text-right tabular-nums font-semibold text-primary whitespace-nowrap">{fmtDecimal(c.veces)}×</td>
                <td class="py-2.5 px-3 text-xs text-base-content/60">{c.nota}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-4 rounded-xl border border-warning/35 bg-warning/10 p-4 text-sm text-base-content/80" role="note">
        <strong class="text-base-content">Cómo leerlo:</strong> son razones de magnitud, no una equivalencia salarial. Se mezclan una remuneración bruta de julio de 2026, ingresos netos de 2025 y umbrales de agosto de 2026; además, una persona ocupada y una persona equivalente no son la misma unidad. Las comparaciones no ajustan esas diferencias por fecha, impuestos ni tamaño del hogar.
      </div>
      <p class="mt-3 text-xs text-base-content/45">
        En la ESI 2025, {fmtPorcentaje(esi.porcentaje_1m_o_mas)} de las personas ocupadas recibió $1.000.000 o más y {fmtPorcentaje(esi.porcentaje_3m_o_mas)} recibió $3.000.000 o más. <SRef id={esi.fuente.id} />
      </p>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <Scale class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">Sueldo bruto del Presidente por gobierno</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-4">
        Montos brutos mensuales del registro o de la fuente histórica indicada. Para Kast se muestra el último registro CFR disponible, no solo la dieta legal. <SRef id="cfr-registro-publico-38bis" /><SRef id="cfr-oficio-n26-2025" />
      </p>
      <div class="grid gap-4 md:grid-cols-2">
        {presidentes.map((p) => (
          <article class="rounded-xl border border-base-300 bg-base-200/50 p-4">
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-semibold text-base-content">{p.presidente}</span>
              <span class="text-xs text-base-content/60 whitespace-nowrap">{p.periodo}</span>
            </div>
            <div class="text-lg font-bold tabular-nums text-base-content mt-1">{formatCLP(p.sueldo)} <span class="text-xs font-normal text-base-content/50">brutos / mes</span></div>
            <p class="text-[11px] text-base-content/55 mt-0.5">{p.fecha_label}</p>
            {p.vigencias.length > 1 && (
              <details class="mt-4 rounded-xl border border-base-300/70 bg-base-200/30 p-3 text-xs">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-lg px-1 py-1.5 font-medium text-primary transition-colors hover:bg-base-200/70 [&::-webkit-details-marker]:hidden">
                  <span>Montos y ventanas conocidas</span>
                  <span class="text-[10px] font-normal text-base-content/45">ver detalle</span>
                </summary>
                <ul class="mt-3 space-y-3 border-t border-base-300/70 pt-3">
                  {p.vigencias.map((v) => (
                    <li class="min-w-0 rounded-r-lg border-l-2 border-base-300 bg-base-100/40 py-2.5 pl-3 pr-2">
                      <div class="grid grid-cols-1 gap-1 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-x-3">
                        <div class="min-w-0">
                          <span class="block text-[11px] font-medium text-base-content/75">{tipoVigencia(v.tipo)}</span>
                          <span class="mt-0.5 block text-[10px] text-base-content/45">{fmtVigencia(v)}</span>
                        </div>
                        <span class="text-sm font-semibold tabular-nums text-base-content sm:text-right">{formatCLP(v.monto)}</span>
                      </div>
                      <p class="mt-2 min-w-0 break-words text-[11px] leading-relaxed text-base-content/60">
                        {v.descripcion} <span class="sueldos-inline-ref"><SRef id={v.fuente} /></span>
                      </p>
                    </li>
                  ))}
                </ul>
              </details>
            )}
            <p class="text-xs text-base-content/70 leading-relaxed mt-3">{p.detalle}</p>
            <p class="mt-2 flex flex-wrap items-center gap-x-1 gap-y-1 text-[11px] leading-relaxed text-base-content/40">
              <span>Fuentes:</span>
              {p.refs.map((id) => <SRef id={id} />)}
            </p>
          </article>
        ))}
      </div>
      <p class="text-xs text-base-content/40 mt-3">
        Los montos de distintos años no son comparables sin ajustar por IPC. La diferencia entre la dieta legal de Kast y el último registro se muestra como {formatCLP(brecha.presidente.diferencia_legal)}.
      </p>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <TrendingUp class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">¿Cuántos ingresos mínimos contemporáneos?</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-4">
        Cada ratio usa el sueldo de la fecha de referencia y el ingreso mínimo vigente en esa fecha, no un mes posterior arbitrario. <SRef id="bcn-leychile-ley-21830" />
      </p>
      <div class="space-y-4">
        {ratios.map((r) => {
          const maxVeces = Math.max(...ratios.map((x) => x.veces));
          const width = Math.min(100, Math.round((r.veces / maxVeces) * 100));
          return (
            <div>
              <div class="flex justify-between text-sm mb-1 gap-3">
                <span class="font-medium text-base-content">Gobierno de {r.gobierno}</span>
                <span class="tabular-nums text-base-content/70 whitespace-nowrap">{fmtDecimal(r.veces)} veces</span>
              </div>
              <div class="h-5 bg-base-200 rounded-full overflow-hidden" aria-hidden="true">
                <div class={`h-full rounded-full ${r.gobierno === 'Kast' ? 'bg-primary' : 'bg-neutral/60'}`} style={`width: ${width}%`}></div>
              </div>
              <p class="text-[11px] text-base-content/45 mt-1">Divisor: {r.divisor}</p>
            </div>
          );
        })}
      </div>
      <div class="mt-4 p-3 rounded-lg bg-base-200 border border-base-300 text-sm text-base-content/70">
        El último registro de Kast equivale a <span class="font-semibold">{fmtDecimal(brecha.presidente.veces_imm)} veces</span> el ingreso mínimo bruto de {formatCLP(imm.categorias[0].monto)} vigente desde {fmtFecha(imm.desde)}. La dieta legal ({formatCLP(legalDiet)}) habría sido {fmtDecimal(ratioLegalKast)} veces el mínimo vigente en marzo de 2026. La base observada de Boric (~$7 millones) equivalía a <span class="font-semibold">{ratioBoricVecesRedondeado} veces</span> el mínimo de 2025. En la década de 2010 el rango fue de {ratio2010sTexto.min} a {ratio2010sTexto.max} ({ratio2010sTexto.detalle}); en 2006–2010 llegó a {ratioBacheletITexto}.
      </div>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <TrendingUp class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">Indicadores de referencia por gobierno</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-4">
        UTM y UF corresponden a enero del primer año del mandato. Para los años 1994 y 2000 se contrastan con las series históricas del SII <SRef id="sii-utm-1994" /><SRef id="sii-uf-1994" />. El IPC se calcula entre dos índices mensuales del BDE, <em>(índice final ÷ índice inicial − 1)</em>; no es una suma de tasas anuales. La serie anual histórica del BDE se conserva como contexto, no como cálculo de los ratios <SRef id="bcentral-bde-ipc-varacion-anual-historica" /><SRef id="bcentral-bde-ipc-empalmado-base-2023" />.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-base-300">
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Gobierno</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">UTM</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">UF</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">IPC entre fechas</th>
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Ventana</th>
            </tr>
          </thead>
          <tbody>
            {indicadores.map((i) => (
              <tr class={`border-b border-base-300 ${i.gobierno === 'Kast' ? 'bg-primary/10' : ''}`}>
                <td class="py-2 px-3 text-base-content font-medium">{i.gobierno}<span class="block text-[10px] text-base-content/40 font-normal">{i.periodo}</span></td>
                <td class="py-2 px-3 text-right tabular-nums">{formatCLP(i.utm)}</td>
                <td class="py-2 px-3 text-right tabular-nums">${i.uf.toLocaleString('es-CL')}</td>
                <td class="py-2 px-3 text-right tabular-nums font-medium">{i.ipc_periodo === null ? '—' : fmtPorcentaje(i.ipc_periodo)}</td>
                <td class="py-2 px-3 text-xs text-base-content/60">{fmtMes(i.ipc_inicio_fecha)} → {fmtMes(i.ipc_fin_fecha)}<span class="block text-[10px] text-base-content/40">{i.nota}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-base-content/45 mt-3">
        Como contexto, los cierres anuales publicados fueron 3,5% en 2025, 4,5% en 2024, 3,0% en 2013 y −1,4% en 2009. No se multiplican para calcular los cambios de la tabla, que usan endpoints mensuales del BDE. <SRef id="ine-2026-01-08-ipc-diciembre-2025" /><SRef id="latercera-pulso-ipc-diciembre-2024" /><SRef id="eldinamo-2014-01-08-ipc-diciembre-2013" /><SRef id="cooperativa-2010-01-07-ipc-2009-deflacion" />
      </p>
      <p class="text-xs text-base-content/40 mt-3">Para convertir montos históricos se usa la serie empalmada del BDE, base {d.ipc.base}.</p>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <TrendingUp class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">Sueldo presidencial en pesos de hoy (ajuste por IPC)</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-4">
        Dietas expresadas en pesos de <strong>{ipcDestinoLabel}</strong>, mediante <em>sueldo × (IPC destino ÷ IPC del mes de referencia)</em> <SRef id="bcentral-bde-ipc-empalmado-base-2023" />. La calculadora del INE permite reproducir estas conversiones <SRef id="ine-calculadora-ipc" />. El ajuste conserva la magnitud de cada observación; no corrige diferencias de cobertura ni entre bruto y neto.
      </p>
      <div class="space-y-4">
        {sueldosAjustados.map((s) => {
          const widthAjustado = Math.max(4, Math.round((s.ajustado / maxAjustado) * 100));
          const widthNominal = Math.max(3, Math.round((s.sueldo / maxAjustado) * 100));
          return (
            <div class="rounded-xl border border-base-300 bg-base-200/50 p-4">
              <div class="flex items-baseline justify-between gap-2 mb-2">
                <div>
                  <span class="font-semibold text-base-content">Gobierno de {s.gobierno}</span>
                  <span class="text-xs text-base-content/40 ml-2">{s.periodo} · {s.fecha}</span>
                </div>
                <div class="text-right">
                  <div class="text-sm font-bold tabular-nums text-base-content">{formatCLP(s.ajustado)}</div>
                  <div class="text-[11px] text-base-content/40">en pesos de {ipcDestinoLabel}</div>
                </div>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-20 text-[11px] text-base-content/40 shrink-0">Real (IPC)</span>
                  <div class="h-4 bg-base-200 rounded-full overflow-hidden flex-1" aria-hidden="true"><div class="h-full rounded-full bg-primary" style={`width: ${widthAjustado}%`}></div></div>
                  <span class="text-xs tabular-nums text-base-content/70 w-28 text-right shrink-0">{formatCLP(s.ajustado)}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-20 text-[11px] text-base-content/40 shrink-0">Nominal</span>
                  <div class="h-4 bg-base-200 rounded-full overflow-hidden flex-1" aria-hidden="true"><div class="h-full rounded-full bg-neutral/60" style={`width: ${widthNominal}%`}></div></div>
                  <span class="text-xs tabular-nums text-base-content/60 w-28 text-right shrink-0">{formatCLP(s.sueldo)}</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <p class="text-xs text-base-content/40 mt-3">
        Escala según el máximo real ({formatCLP(maxAjustado)}). El promedio de {formatCLP(promedioPrevios)} es el promedio de cuatro observaciones puntuales de 2006–2022, no una serie completa de salarios. La observación de Kast queda {pctInferiorKast}% por debajo de ese promedio; la dieta legal y el registro CFR se mantienen separados ({formatCLP(legalDiet)} frente a {formatCLP(actualPresidente.sueldo)}).
      </p>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
