---
import Base from '../layouts/Base.astro';
import SRef from '../components/sueldos/SRef.astro';
import { DollarSign, Scale, TrendingUp, BookOpen, ExternalLink } from 'lucide-astro';
import { getSueldos } from '../lib/sueldos';

// Todos los datos viven en src/data/sueldos.yaml; los valores derivados (ratios,
// ajustes IPC, promedios) se calculan en src/lib/sueldos.ts. Este template no
// contiene cifras escritas a mano: las que aparecen en la prosa vienen de `d`.
const d = getSueldos();
const { fuentes } = d;
const {
  ratios,
  sueldosAjustados,
  maxAjustado,
  promedioPrevios,
  pctInferiorKast,
  registroMayoAjustado,
  ratioKastVecesRedondeado,
  ratioBoricVecesRedondeado,
  ratio2010sTexto,
  ratioBacheletITexto,
  millonesRangoPrevios,
  kastAjustadoMillones,
  boricAjustadoMillones,
  freiAjustadoMillones,
  lagosAjustadoMillones,
} = d.derivados;

const cargos = d.segundo_piso.cargos;
const topes = d.topes_dipres.filas;
const {
  presidentes,
  sueldo_minimo,
  indicadores,
  formatCLP,
  pctDiff,
} = d;

// '2026-05-01' -> '01/05/2026' (formato de la tabla histórica).
const fmtFecha = (iso: string) => iso.split('-').reverse().join('/');
const fmtDecimal = (n: number) => n.toFixed(1).replace('.', ',');

// --- Línea de tiempo mensual (Registro Público): geometría del SVG estático ---
const serie = d.serie_registro_publico.puntos;
const CH = { W: 760, H: 310, mL: 64, mR: 18, mT: 24, mB: 42 };
const yMinChart = 6_500_000; // eje truncado (rotulado en la nota)
const yMaxChart = 11_600_000;
const chX = (i: number) => CH.mL + (i * (CH.W - CH.mL - CH.mR)) / (serie.length - 1);
const chY = (v: number) => CH.mT + (CH.H - CH.mT - CH.mB) * (1 - (v - yMinChart) / (yMaxChart - yMinChart));
const seriePath = serie
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${chX(i).toFixed(1)},${chY(p.monto).toFixed(1)}`)
  .join(' ');
const iTrans = serie.findIndex((p) => p.gobierno === 'Kast');
const xTrans = iTrans > 0 ? (chX(iTrans - 1) + chX(iTrans)) / 2 : CH.mL;
const MESES_AB = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
const labelPeriodo = (p: string) => {
  const [yy, mm] = p.split('-').map(Number);
  return `${MESES_AB[mm - 1]} ${String(yy).slice(2)}`;
};
const chartGrid = [7_000_000, 8_000_000, 9_000_000, 10_000_000, 11_000_000];
const chartTicks = [0, 3, 6, 9, 12, serie.length - 1];
const saltoFebAbr = ((serie[iTrans + 1]?.monto ?? 0) / (serie[iTrans - 1]?.monto ?? 1) * 100 - 100).toFixed(0);
---

<Base title="Sueldos y brecha salarial">
  <article class="max-w-4xl mx-auto">
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-1">
        <DollarSign class="h-6 w-6 text-primary shrink-0" />
        <h1 class="text-2xl sm:text-3xl font-bold text-base-content leading-tight">Sueldos del sector público y brecha salarial</h1>
      </div>
      <p class="text-base-content/60 text-sm">
        Sueldo del Presidente por gobierno (serie histórica 2006–2030, del más reciente al más antiguo), sueldo mínimo
        por gobierno, indicadores económicos de seguimiento (UTM, UF e inflación), asesores de confianza y contexto de
        costo de vida. Todos los datos están verificados contra las fuentes listadas al final de la página.
      </p>
    </header>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <Scale class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">Sueldo bruto del Presidente por gobierno</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-3">
        El 11 de marzo de 2026 entró en vigencia el nuevo sistema de remuneraciones para altas autoridades, fijado por la
        Comisión para la Fijación de Remuneraciones (Ley 21.233), que ordena la escala salarial del sector público.
        Bajo Kast, la dieta presidencial quedó en torno a los $11 millones brutos mensuales <SRef n={5} /><SRef n={9} /><SRef n={10} />.
      </p>
      <div class="grid gap-4 md:grid-cols-2">
        {presidentes.map((p) => (
          <div class="rounded-xl border border-base-300 bg-base-200/50 p-4">
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-semibold text-base-content">{p.presidente}</span>
              <span class="text-xs text-base-content/60 whitespace-nowrap">{p.periodo}</span>
            </div>
            <div class="text-lg font-bold tabular-nums text-base-content mt-1">{formatCLP(p.sueldo)}</div>
            {p.vigencias.length > 1 && (
              <p class="text-[11px] text-base-content/50 tabular-nums mt-0.5">
                Montos del mandato: {p.vigencias.map((v) => formatCLP(v.monto)).join(' → ')}
              </p>
            )}
            <p class="text-xs text-base-content/70 leading-relaxed mt-2">{p.detalle}</p>
            <p class="text-[11px] text-base-content/40 mt-2">
              Fuentes:{' '}
              {p.refs.map((n) => (
                <SRef n={n} />
              ))}
            </p>
          </div>
        ))}
      </div>
      <p class="text-xs text-base-content/40 mt-3">
        Serie histórica construida con fuentes oficiales de transparencia (Presidencia), prensa verificada y el registro
        público de la Comisión para la Fijación de Remuneraciones. Los montos son la renta bruta mensualizada de cada
        período; los cambios entre gobiernos reflejan reajustes anuales del sector público, la rebaja transitoria de 2020
        (Ley 21.233) y el nuevo sistema de remuneraciones de 2026 (Resolución N°5 de 2024). Los valores nominales no son
        directamente comparables entre períodos sin ajustar por IPC.
      </p>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <TrendingUp class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">¿Cuántos sueldos mínimos gana el Presidente?</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-4">
        Razón entre la dieta presidencial y el ingreso mínimo mensual vigente (cálculo propio sobre datos verificados).
      </p>
      <div class="space-y-4">
        {ratios.map((r) => {
          const maxVeces = Math.max(...ratios.map((x) => x.veces));
          const width = Math.min(100, Math.round((r.veces / maxVeces) * 100));
          return (
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="font-medium text-base-content">Gobierno de {r.gobierno}</span>
                <span class="tabular-nums text-base-content/70">{fmtDecimal(r.veces)} veces el sueldo mínimo</span>
              </div>
              <div class="h-5 bg-base-200 rounded-full overflow-hidden" aria-hidden="true">
                <div
                  class={`h-full rounded-full ${r.gobierno === 'Kast' ? 'bg-primary' : 'bg-neutral/60'}`}
                  style={`width: ${width}%`}
                ></div>
              </div>
              <p class="text-xs text-base-content/40 mt-1">Divisor: {r.divisor}</p>
            </div>
          );
        })}
      </div>
      <div class="mt-4 p-3 rounded-lg bg-base-200 border border-base-300 text-sm text-base-content/70">
        La dieta de Kast equivale a <span class="font-semibold">{ratioKastVecesRedondeado} veces</span> el sueldo mínimo vigente
        (según el monto de $11.070.064 fijado por la comisión autónoma <SRef n={5} /><SRef n={10} />). La base bruta de Boric (~$7 millones) equivalía a
        <span class="font-semibold"> unas {ratioBoricVecesRedondeado} veces</span> el mínimo vigente en 2025 <SRef n={7} />.
        Históricamente el ratio fue mayor: en la década de 2010 la dieta presidencial equivalía a entre {ratio2010sTexto.min} y {ratio2010sTexto.max}
        sueldos mínimos ({ratio2010sTexto.detalle} <SRef n={23} />), en parte porque el sueldo mínimo partía de valores más bajos.
        En 2006–2010 el ratio llegó a {ratioBacheletITexto} (Bachelet I <SRef n={22} />), cuando el mínimo vigente era de $165.000 (desde julio de 2009).
      </div>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <TrendingUp class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">Indicadores económicos por gobierno (seguimiento)</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-4">
        UTM y UF de enero del primer año de cada mandato (para Frei y Lagos: serie histórica del SII, valores
        de enero de cada año <SRef n={50} /><SRef n={51} />), junto a la variación anual del IPC
        (diciembre a diciembre, INE) del año de inicio y la inflación acumulada del período (cálculo propio sobre la
        serie empalmada del Banco Central <SRef n={41} /> y la serie 1928–2009 del INE
        <SRef n={49} />). La única deflación del período (IPC -1,4% en 2009)
        fue corroborada por Cooperativa <SRef n={42} />.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-base-300">
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Gobierno</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">UTM (ene, año 1°)</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">UF (ene, año 1°)</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">IPC año inicio</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">IPC acumulado mandato</th>
            </tr>
          </thead>
          <tbody>
            {indicadores.map((i) => (
              <tr class={`border-b border-base-300 ${i.gobierno === 'Kast' ? 'bg-primary/10' : ''}`}>
                <td class="py-2 px-3 text-base-content font-medium">
                  {i.gobierno}
                  <span class="text-base-content/40 font-normal"> · {i.periodo}</span>
                </td>
                <td class="py-2 px-3 text-right tabular-nums">{formatCLP(i.utm)}</td>
                <td class="py-2 px-3 text-right tabular-nums">${i.uf.toLocaleString('es-CL')}</td>
                <td class="py-2 px-3 text-right tabular-nums">{fmtDecimal(i.ipc_anual)}%</td>
                <td class="py-2 px-3 text-right tabular-nums font-medium">
                  {i.ipc_acumulado ? `${fmtDecimal(i.ipc_acumulado)}%` : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-5 space-y-3">
        <p class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Inflación acumulada del mandato (%)</p>
        {(() => {
          const maxAcum = Math.max(...indicadores.map((x) => x.ipc_acumulado ?? 0));
          return indicadores.map((i) => {
          const width = i.ipc_acumulado ? Math.max(3, Math.round((i.ipc_acumulado / maxAcum) * 100)) : 3;
          return (
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="font-medium text-base-content">Gobierno de {i.gobierno}</span>
                <span class="tabular-nums text-base-content/70">{i.ipc_acumulado ? `${fmtDecimal(i.ipc_acumulado)}%` : 'en curso'}</span>
              </div>
              <div class="h-4 bg-base-200 rounded-full overflow-hidden" aria-hidden="true">
                <div
                  class={`h-full rounded-full ${i.ipc_acumulado && i.ipc_acumulado >= 25 ? 'bg-warning/80' : 'bg-primary'}`}
                  style={`width: ${width}%`}
                ></div>
              </div>
              <p class="text-xs text-base-content/40 mt-0.5">{i.nota}</p>
            </div>
          );
          });
        })()}
      </div>
      <p class="text-xs text-base-content/40 mt-3">
        La UTM y la UF reajustan mensualmente según la inflación (IPC del mes anterior), por lo que la serie refleja el
        poder adquisitivo de cada período: en pesos de hoy, los sueldos históricos equivalen a montos muy superiores.
        Para convertirlos puede usarse la calculadora de reajuste por IPC del INE <SRef n={32} />.
      </p>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <TrendingUp class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">Sueldo presidencial en pesos de hoy (ajustado por IPC)</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-4">
        Cada dieta bruta convertida a pesos de <strong>julio de 2026</strong> (último dato disponible del índice IPC,
        serie empalmada base diciembre 2023 = 100 <SRef n={45} />), usando el índice del mes al que
        corresponde cada sueldo. Cálculo propio: <em>sueldo × (IPC jul-2026 ÷ IPC del mes)</em>. La serie muestra el
        quiebre de la Ley 19.863 (2003) — que elevó la dieta presidencial del grado máximo de la EUS (Frei ~$1,36M;
        Lagos ~2.440 USD en 2001 <SRef n={47} />) al 150% de ese grado (Lagos
        $5.229.000 brutos en 2004 <SRef n={46} />) —, y luego la rebaja transitoria de 2020 (Ley 21.233) y
        la re-fijación de 2026 (Resolución N°5 de 2024): en pesos de hoy, Frei ganaba ~${freiAjustadoMillones} millones; Lagos ~${lagosAjustadoMillones}
        millones; los presidentes de 2006–2022, entre ${millonesRangoPrevios.min} y ${millonesRangoPrevios.max} millones brutos; Boric, la mitad (~${boricAjustadoMillones} millones) y
        Kast, ~${kastAjustadoMillones} millones.
      </p>
      <div class="space-y-4">
        {sueldosAjustados.map((s) => {
          const widthAjustado = Math.max(4, Math.round((s.ajustado / maxAjustado) * 100));
          const widthNominal = Math.max(3, Math.round((s.sueldo / maxAjustado) * 100));
          return (
            <div class="rounded-xl border border-base-300 bg-base-200/50 p-4">
              <div class="flex items-baseline justify-between gap-2 mb-2">
                <div>
                  <span class="font-semibold text-base-content">Gobierno de {s.gobierno}</span>
                  <span class="text-xs text-base-content/40 ml-2">{s.periodo} · {s.fecha}</span>
                </div>
                <div class="text-right">
                  <div class="text-sm font-bold tabular-nums text-base-content">{formatCLP(s.ajustado)}</div>
                  <div class="text-[11px] text-base-content/40 tabular-nums">en pesos de jul-2026</div>
                </div>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-20 text-[11px] text-base-content/40 shrink-0">Real (IPC)</span>
                  <div class="h-4 bg-base-200 rounded-full overflow-hidden flex-1" aria-hidden="true">
                    <div class="h-full rounded-full bg-primary" style={`width: ${widthAjustado}%`}></div>
                  </div>
                  <span class="text-xs tabular-nums text-base-content/70 w-28 text-right shrink-0">{formatCLP(s.ajustado)}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-20 text-[11px] text-base-content/40 shrink-0">Nominal</span>
                  <div class="h-4 bg-base-200 rounded-full overflow-hidden flex-1" aria-hidden="true">
                    <div class="h-full rounded-full bg-neutral/60" style={`width: ${widthNominal}%`}></div>
                  </div>
                  <span class="text-xs tabular-nums text-base-content/60 w-28 text-right shrink-0">{formatCLP(s.sueldo)}</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <p class="text-xs text-base-content/40 mt-3">
        Escala relativa al máximo real ({formatCLP(maxAjustado)} en pesos de julio 2026). Para Kast se usa la dieta
        fijada de $11.070.064 (marzo 2026); con el monto del Registro Público de mayo 2026 ($11.304.748) el equivalente
        sería {formatCLP(registroMayoAjustado)}. Los valores nominales provienen de las fuentes de la sección anterior; el IPC mensual de la
        serie empalmada del Banco Central <SRef n={45} />. La estimación de Frei se ancla en la
        declaración de Lagos de enero de 2001 <SRef n={47} /> deflactada por IPC a marzo de 2000 (no
        existe registro oficial publicado para 1994-2000). Resultado: la dieta real de Kast sigue siendo
        <span class="font-medium">{pctInferiorKast}% inferior</span> al promedio real de los cuatro presidentes previos a Boric
        (2006–2022: {formatCLP(promedioPrevios)}).
      </p>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <TrendingUp class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">Bruta mensual del Presidente, mes a mes (Registro Público 38 bis)</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-4">
        Serie mensual de la remuneración bruta efectivamente reportada al Registro Público
        (fuente única: CFR, leída el 23/08/2026; cubre desde enero de 2025). Los picos de Boric son los meses con pago del
        bono por cumplimiento de metas ($10.046.124); marzo de 2026 es el mes proporcional de Kast (asunción el 11/03);
        desde abril rige la dieta nueva. El salto febrero→abril 2026 es de +{saltoFebAbr}%.
      </p>
      <figure class="overflow-x-auto">
        <svg viewBox={`0 0 ${CH.W} ${CH.H}`} class="w-full min-w-[640px]" role="img" aria-labelledby="chart-tl-title chart-tl-desc">
          <title id="chart-tl-title">Remuneración bruta mensual del Presidente de la República, enero 2025 – junio 2026</title>
          <desc id="chart-tl-desc">Boric percibió $7.033.974 brutos mensuales, con pagos de $10.046.124 en meses de bono por metas (marzo, junio, septiembre y diciembre). Desde abril de 2026, Kast percibe $11.304.748 (junio: $11.308.034). Marzo 2026 fue proporcional por la asunción del 11 de marzo.</desc>
          {/* zona de gobierno Kast */}
          <rect x={xTrans} y={CH.mT} width={CH.W - CH.mR - xTrans} height={CH.H - CH.mT - CH.mB} class="fill-primary/5" />
          {/* grilla + labels Y */}
          {chartGrid.map((v) => (
            <g>
              <line x1={CH.mL} x2={CH.W - CH.mR} y1={chY(v)} y2={chY(v)} class="stroke-base-300/60" stroke-dasharray="2 4" />
              <text x={CH.mL - 8} y={chY(v) + 3} text-anchor="end" class="fill-base-content/50" font-size="10">${v / 1_000_000}M</text>
            </g>
          ))}
          {/* línea de transición de gobierno */}
          <line x1={xTrans} x2={xTrans} y1={CH.mT - 4} y2={CH.H - CH.mB} class="stroke-warning/70" stroke-dasharray="4 3" />
          <text x={xTrans + 5} y={CH.mT + 8} class="fill-warning text-[10px] font-medium">11-mar-2026</text>
          {/* serie */}
          <path d={seriePath} fill="none" class="stroke-base-content/35" stroke-width="2" />
          {serie.map((p, i) => {
            const esKast = p.gobierno === 'Kast';
            const bono = Boolean(p.nota && p.nota.startsWith('Bono'));
            return (
              <g>
                {bono && <circle cx={chX(i)} cy={chY(p.monto)} r={7.5} fill="none" class="stroke-warning/70" stroke-width="1.5" />}
                <circle cx={chX(i)} cy={chY(p.monto)} r={4} class={esKast ? 'fill-primary' : 'fill-neutral/70'}>
                  <title>{`${labelPeriodo(p.periodo)} · ${p.gobierno} · ${formatCLP(p.monto)}${p.nota ? ` (${p.nota})` : ''}`}</title>
                </circle>
              </g>
            );
          })}
          {/* etiquetas de valor en puntos clave */}
          <text x={chX(0)} y={chY(serie[0].monto) - 12} text-anchor="start" class="fill-base-content/70" font-size="9">$7.033.974</text>
          <text x={chX(iTrans - 1)} y={chY(serie[iTrans - 1].monto) - 12} text-anchor="middle" class="fill-base-content/70" font-size="9">$10.046.124</text>
          <text x={chX(iTrans)} y={chY(serie[iTrans].monto) + 16} text-anchor="middle" class="fill-base-content/70" font-size="9">$7.536.499 (prop.)</text>
          <text x={chX(iTrans + 1)} y={chY(serie[iTrans + 1].monto) - 11} text-anchor="middle" class="fill-base-content/80 font-semibold" font-size="9">$11.304.748</text>
          <text x={chX(serie.length - 1)} y={chY(serie[serie.length - 1].monto) - 12} text-anchor="end" class="fill-base-content/80 font-semibold" font-size="9">{formatCLP(serie[serie.length - 1].monto)}</text>
          {/* eje X */}
          <line x1={CH.mL} x2={CH.W - CH.mR} y1={CH.H - CH.mB} y2={CH.H - CH.mB} class="stroke-base-300" />
          {chartTicks.map((i) => (
            <text x={chX(i)} y={CH.H - CH.mB + 14} text-anchor="middle" class="fill-base-content/50" font-size="9">{labelPeriodo(serie[i].periodo)}</text>
          ))}
        </svg>
        <figcaption class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-3 text-[11px] text-base-content/50">
          <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full bg-neutral/70"></span> Gobierno Boric</span>
          <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full bg-primary"></span> Gobierno Kast</span>
          <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full border-2 border-warning/70"></span> Mes con bono por metas ($10.046.124)</span>
          <span>Eje vertical truncado en $6,5M para visibilizar las variaciones.</span>
        </figcaption>
      </figure>
      <p class="text-xs text-base-content/40 mt-3">
        Bajo Boric la base fue $7.033.974 (constante durante todo el período registrado), con bono trimestral por
        cumplimiento de metas que llevó la bruta a $10.046.124 en marzo, junio, septiembre y diciembre. La dieta nueva de
        Kast ($11.070.064 fijados + adecuaciones reportadas) supera en +{saltoFebAbr}% la bruta sin bono de febrero de 2026 y
        en ~13% incluso a los meses con bono. Junio 2026 subió $3.286 sobre mayo, sin explicación pública aún.
        Fuente: <SRef n={28} />.
      </p>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <DollarSign class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">Sueldo mínimo (Ingreso Mínimo Mensual) por gobierno</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-3">
        Monto bruto mensual para trabajadores entre 18 y 65 años, según las leyes de reajuste. Tabla resumida
        (serie completa 1958–2027 en la fuente de Wikipedia <SRef n={1} />).
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-base-300">
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Desde</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">Monto</th>
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Gobierno</th>
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Norma</th>
            </tr>
          </thead>
          <tbody>
            {sueldo_minimo.map((s) => (
              <tr class={`border-b border-base-300 ${s.gobierno === 'Kast' ? 'bg-primary/10' : ''}`}>
                <td class="py-2 px-3 tabular-nums text-base-content/80 whitespace-nowrap">{fmtFecha(s.desde)}</td>
                <td class="py-2 px-3 text-right tabular-nums font-medium whitespace-nowrap">{formatCLP(s.monto)}</td>
                <td class="py-2 px-3 text-base-content">{s.gobierno}</td>
                <td class="py-2 px-3 text-base-content/60 text-xs">{s.ley}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-base-content/40 mt-3">
        El reajuste de mayo de 2026 ($553.553) fue despachado por el Senado el 16 de junio de 2026 (Ley 21.830 <SRef n={2} />) tras una
        negociación sin acuerdo con la CUT, que pedía cerca de $637.000 <SRef n={3} /><SRef n={4} />. Desde enero de 2027 el IMM se reajustará por IPC.
      </p>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-3">
        <BookOpen class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-lg font-semibold text-base-content">Canasta familiar y costo de vida</h2>
      </div>
      <div class="prose prose-sm max-w-none text-base-content/80 space-y-3">
        <p>
          En Chile se usan dos referencias de canasta: la <strong>Canasta Básica de Alimentos</strong> (INE / Ministerio de
          Desarrollo Social <SRef n={20} />), base de las líneas de pobreza, y la <strong>Canasta Familiar</strong> que publica
          trimestralmente la Fiscalía Nacional Económica (FNE <SRef n={21} />) para una familia de cuatro personas, junto al
          "sueldo ideal" que permitiría cubrirla.
        </p>
        <p>
          La discusión del reajuste del sueldo mínimo en 2026 giró en torno a esa brecha. En el debate del Senado
          (16/06/2026), senadores de diversos sectores sostuvieron que el incremento aprobado "es incapaz de ganarle a la
          inflación acumulada y al valor de los servicios más básicos" y que "es incapaz de cubrir las necesidades de las
          familias".
        </p>
        <p>
          La CUT rechazó la propuesta del gobierno —que ofrecía un alza cercana a $23.000 por IPC— y planteó un sueldo mínimo
          de <span class="font-medium">alrededor de $637.000</span> <SRef n={3} /><SRef n={4} />, argumentando que "hoy día las cosas son más caras en el mes de
          abril que en el mes de enero" y que el sueldo mínimo tiene "menos poder adquisitivo por el alza del petróleo".
          Referencias de contexto: la inflación acumulada de 2025 fue de 3,5% (INE <SRef n={18} />) y la PGU máxima pasó a $250.275 desde
          febrero de 2026 (ChileAtiende <SRef n={19} />), es decir, cerca del 45% de un sueldo mínimo.
        </p>
        <div class="p-3 rounded-lg bg-warning/15 border border-warning/40 text-base-content text-sm">
          <strong>Nota de verificación:</strong> los montos puntuales en pesos de la canasta básica (INE) y de la canasta
          familiar (FNE) para 2025–2026 no pudieron ser verificados en fuentes accesibles durante la elaboración de esta
          página. Conforme a la regla del proyecto (no publicar datos no verificados ni inventados), se omiten valores
          puntuales; las referencias oficiales para consulta figuran en la sección de fuentes.
        </div>
      </div>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <h2 class="text-lg font-semibold text-base-content mb-3">Topes salariales fijados por Dipres</h2>
      <p class="text-sm text-base-content/60 mb-3">
        Límites de remuneración para asesores de confianza definidos por el Oficio Circular N°15 de la Dipres, firmado por
        el ministro de Hacienda <span class="font-medium">{d.topes_dipres.firmante}</span> <SRef n={17} />.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-base-300">
              <th class="sticky left-0 z-10 bg-base-100 text-left py-2 px-3 font-medium text-base-content/80">Rango</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">Kast (tope)</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">Boric (tope)</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">Diferencia</th>
            </tr>
          </thead>
          <tbody>
            {topes.map((t) => (
              <tr class="border-b border-base-300">
                <td class="sticky left-0 bg-base-100 py-2 px-3 text-base-content">{t.rango}</td>
                <td class="py-2 px-3 text-right tabular-nums font-medium">{formatCLP(t.tope_kast)}</td>
                <td class="py-2 px-3 text-right tabular-nums text-base-content/60">
                  {t.tope_boric ? formatCLP(t.tope_boric) : '—'}
                </td>
                <td class="py-2 px-3 text-right tabular-nums text-error font-medium">
                  {t.tope_boric ? `+${pctDiff(t.tope_kast, t.tope_boric)}%` : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <h2 class="text-lg font-semibold text-base-content mb-3">Comparación cargo a cargo ({d.segundo_piso.periodo_label})</h2>
      <p class="text-sm text-base-content/60 mb-3">
        {d.segundo_piso.nota} <SRef n={16} />
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-base-300">
              <th class="sticky left-0 z-10 bg-base-100 text-left py-2 px-3 font-medium text-base-content/80">Cargo</th>
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Kast</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">Sueldo</th>
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Boric</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">Sueldo</th>
