        <div class="rounded-xl border border-base-300 bg-base-200/40 p-4">
          <p class="text-xs text-base-content/60">Promedio del ingreso autónomo del hogar</p>
          <p class="text-xl font-bold tabular-nums mt-2">{formatCLP(casen.promedio_ingreso_autonomo_hogar)}</p>
          <p class="text-[11px] text-base-content/45 mt-1">total del hogar</p>
        </div>
        <div class="rounded-xl border border-base-300 bg-base-200/40 p-4">
          <p class="text-xs text-base-content/60">Promedio del ingreso monetario del hogar</p>
          <p class="text-xl font-bold tabular-nums mt-2">{formatCLP(casen.promedio_ingreso_monetario_hogar)}</p>
