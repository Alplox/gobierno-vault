  {
    gobierno: 'Kast',
    periodo: '2026–2030',
    sueldo: 11_070_064,
    ipc: 110.75,
    fecha: 'marzo 2026 (dieta fijada; el Registro Público de mayo 2026 consigna $11.304.748)',
