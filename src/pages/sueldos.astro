  { grupo: 'Indicadores económicos', titulo: 'Valores diarios de la Unidad de Fomento (UF) por año — serie histórica oficial (1-ene: 2006 $17.973,65; 2010 $20.939,49; 2014 $23.312,57; 2018 $26.799,01; 2022 $30.996,73; 2026 $39.731,79)', medio: 'Servicio de Impuestos Internos (SII)', url: 'https://www.sii.cl/valores_y_fechas/uf/uf2026.htm' },
  { grupo: 'Indicadores económicos', titulo: 'Base de Datos Estadísticos (BDE): variación anual del IPC (dic-dic, INE empalmado) 2010–2026 — 3,0% (2010); 4,4% (2011); 1,5% (2012); 3,0% (2013); 4,6% (2014); 4,4% (2015); 2,7% (2016); 2,3% (2017); 2,6% (2018); 3,0% (2019); 3,0% (2020); 7,2% (2021); 12,8% (2022); 3,9% (2023); 4,5% (2024); 3,5% (2025); 3,5% (jul-2026)', medio: 'Banco Central de Chile', url: 'https://si3.bcentral.cl/Siete/ES/Siete/Cuadro/CAP_PRECIOS/MN_CAP_PRECIOS/IPC_VAR_ANUAL_HIST_NEW/637776000242408435' },
  { grupo: 'Indicadores económicos', titulo: 'IPC llegó a -1,4% en 2009 (deflación anual; contexto de la crisis financiera global)', medio: 'Cooperativa', url: 'https://m.cooperativa.cl/noticias/pais/consumidores/inflacion/ipc-llego-a-1-4-por-ciento-en-2009/2010-01-07/080609.html' },
  { grupo: 'Indicadores económicos', titulo: 'INE: IPC de diciembre llegó a 0,6% y 2013 cerró con inflación anual de 3,0%', medio: 'El Dínamo', url: 'https://www.eldinamo.cl/negocios/2014/01/08/ine-el-ipc-de-diciembre-llego-a-un-06-de-la-mano-del-transporte/' },
  { grupo: 'Indicadores económicos', titulo: 'Inflación en Chile: IPC de diciembre de 2024 cerró en 4,5% (serie empalmada INE)', medio: 'La Tercera', url: 'https://www.latercera.com/pulso/noticia/inflacion-en-chile-ipc-de-diciembre-del-2024/A6IRYQL7OFHAZKOBWCANFZ5HVQ/' },
  { grupo: 'Indicadores económicos', titulo: 'BDE — IPC serie empalmada (base diciembre 2023 = 100): índice mensual jul-2026 = 112,45; nov-2025 = 109,47; jun-2018 = 74,98; ene-2015 = 67,49; mar-2014 = 65,41; ene-2010 = 57,61', medio: 'Banco Central de Chile', url: 'https://si3.bcentral.cl/Siete/ES/Siete/Cuadro/CAP_PRECIOS/MN_CAP_PRECIOS/IPC_EMP_2023/638415285164039007' },
  { grupo: 'Serie histórica (Presidente)', titulo: 'El sueldo del presidente Lagos: $5.229.000 brutos mensuales informados por la Contraloría en julio de 2004', medio: 'El Universo', url: 'https://www.eluniverso.com/2004/07/18/0001/14/459558AADE8F4C929FC2B4D6ECAF8076.html/' },
  { grupo: 'Serie histórica (Presidente)', titulo: 'Lagos: "mi actual salario como gobernante, equivalente a unos 2.440 dólares mensuales" (enero 2001, régimen pre-Ley 19.863)', medio: 'Emol / Reuters', url: 'https://www.emol.com/noticias/nacional/2001/01/03/42315/lagos-habla-adamor-salario-y-retos-en-internet.html' },
  { grupo: 'Serie histórica (Presidente)', titulo: 'Remuneraciones de las principales autoridades y funcionarios del país (2018): el Presidente de la República recibe 35 ingresos mínimos mensuales (grado más alto de la EUS)', medio: 'Biblioteca del Congreso Nacional', url: 'https://obtienearchivo.bcn.cl/obtienearchivo?id=repositorio/10221/25576/2/Remuneraciones_de_las_mas_altas_autoridades_del_pais_REV_FINAL_Dip_def-1.pdf' },
  { grupo: 'Indicadores económicos', titulo: 'Serie histórica empalmada del IPC general (índices) 1928–2009 — base de cálculo de las variaciones dic-dic 1994–2006 (8,9% 1994; 8,2% 1995; 6,6% 1996; 6,0% 1997; 4,7% 1998; 2,3% 1999; 4,5% 2000; 2,6% 2001; 2,8% 2002; 1,1% 2003; 2,4% 2004; 3,7% 2005; 2,6% 2006)', medio: 'Instituto Nacional de Estadísticas (INE)', url: 'https://www.ine.gob.cl/docs/default-source/%C3%ADndice-de-precios-al-consumidor/cuadros-estadisticos/series-empalmadas-y-antecedentes-historicos/series-historicas-empalmadas-1928-al-2009/serie-hist%C3%B3rica-empalmada-ipc-general-(%C3%ADndices)-1928---2009.xls' },
  { grupo: 'Indicadores económicos', titulo: 'Valores de la Unidad Tributaria Mensual (UTM) por año — enero 1994: $18.638; enero 2000: $26.441 (serie histórica oficial)', medio: 'Servicio de Impuestos Internos (SII)', url: 'https://www.sii.cl/pagina/valores/utm/utm1994.htm' },
  { grupo: 'Indicadores económicos', titulo: 'Valores diarios de la Unidad de Fomento (UF) — 1-ene-1994: $10.623,53; 1-ene-2000: $15.067,93 (serie histórica oficial)', medio: 'Servicio de Impuestos Internos (SII)', url: 'https://www.sii.cl/pagina/valores/uf/uf1994.htm' },
