// ajustado = sueldo × (IPC jul-2026 / IPC del mes). Cálculo propio sobre la serie oficial.
const IPC_JUL_2026 = 112.45;
// Índice IPC mensual de cada sueldo, alineado a la serie oficial BCCh (base dic-2023 = 100):
// mar-2026 = 110,75 · nov-2025 = 109,47 · jun-2018 = 74,98 · ene-2015 = 67,49 · mar-2014 = 65,41 · ene-2010 = 57,61
