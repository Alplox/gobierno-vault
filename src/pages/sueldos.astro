      </p>
      <div class="space-y-4">
        {sueldosAjustados.map((s) => {
          const widthAjustado = Math.max(4, Math.round((s.ajustado / maxAjustado) * 100));
          const widthNominal = Math.max(3, Math.round((s.sueldo / maxAjustado) * 100));
          return (
            <div class="rounded-xl border border-gray-100 bg-gray-50/50 p-4">
              <div class="flex items-baseline justify-between gap-2 mb-2">
                <div>
                  <span class="font-semibold text-gray-900">Gobierno de {s.gobierno}</span>
                  <span class="text-xs text-gray-400 ml-2">{s.periodo} · {s.fecha}</span>
                </div>
                <div class="text-right">
                  <div class="text-sm font-bold tabular-nums text-gray-900">{formatCLP(s.ajustado)}</div>
                  <div class="text-[11px] text-gray-400 tabular-nums">en pesos de jul-2026</div>
                </div>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-20 text-[11px] text-gray-400 shrink-0">Real (IPC)</span>
                  <div class="h-4 bg-gray-100 rounded-full overflow-hidden flex-1" aria-hidden="true">
                    <div class="h-full rounded-full bg-blue-600" style={`width: ${widthAjustado}%`}></div>
                  </div>
                  <span class="text-xs tabular-nums text-gray-600 w-28 text-right shrink-0">{formatCLP(s.ajustado)}</span>
