  {
    gobierno: 'Frei',
    periodo: '1994–2000',
    sueldo: 1_362_000,
    ipc: 42.26,
    fecha: 'marzo 2000 (estimación del régimen pre-Ley 19.863)',
  },
].map((s) => ({ ...s, ajustado: Math.round((s.sueldo * IPC_JUL_2026) / s.ipc) }));

// Valores derivados en runtime para la sección (evitan divergencias entre texto y barras)
const maxAjustado = Math.max(...sueldosAjustados.map((x) => x.ajustado));
const promedioPrevios = Math.round(
  sueldosAjustados.slice(2, 6).reduce((acc, s) => acc + s.ajustado, 0) / 4
); // Piñera II, Bachelet II, Piñera I y Bachelet I (los cuatro gobiernos previos a Boric)
const pctInferiorKast = Math.round((1 - sueldosAjustados[0].ajustado / promedioPrevios) * 100);

const formatCLP = (n: number) => '$' + n.toLocaleString('es-CL');
const pct = (a: number, b: number) => ((a - b) / b * 100).toFixed(1);

