      <p class="text-sm text-base-content/60 mb-3">{d.segundo_piso.nota} <SRef id={segundoPisoFuenteId} /></p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-base-300">
              <th class="sticky left-0 z-10 bg-base-100 text-left py-2 px-3 font-medium text-base-content/80">Cargo</th>
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Kast</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">Sueldo</th>
              <th class="text-left py-2 px-3 font-medium text-base-content/80">Boric</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">Sueldo</th>
              <th class="text-right py-2 px-3 font-medium text-base-content/80">Δ</th>
            </tr>
          </thead>
          <tbody>
            {cargos.map((c) => (
              <tr class="border-b border-base-300 hover:bg-base-200">
                <td class="sticky left-0 bg-base-100 py-2 px-3 text-base-content font-medium">{c.cargo}</td>
                <td class="py-2 px-3 text-base-content/80">{c.kast.nombre}</td>
                <td class="py-2 px-3 text-right tabular-nums font-medium">{formatCLP(c.kast.sueldo)}</td>
                <td class="py-2 px-3 text-base-content/60">{c.boric.nombre}</td>
                <td class="py-2 px-3 text-right tabular-nums text-base-content/60">{formatCLP(c.boric.sueldo)}</td>
                <td class="py-2 px-3 text-right tabular-nums text-error font-medium">+{pctDiff(c.kast.sueldo, c.boric.sueldo)}%</td>
