---
import Base from '../../../layouts/Base.astro';
import EventConnections from '../../../components/EventConnections.astro';
import EventTimelineConnector from '../../../components/EventTimelineConnector.astro';
import { render } from 'astro:content';
import { getAllEvents, getPeopleMap, getTopicsMap, getOrgsMap, getEventEntities, getCifrasRegistry } from '../../../lib/queries';
import { getEventConnections, buildEventsByBasename, buildIncomingIndex } from '../../../lib/relations';
import { resolveReferences } from '../../../lib/registry';
import {
  ArrowLeft,
  Calendar,
  Tag,
  User,
  Building2,
  TrendingUp,
  BookOpen,
  ExternalLink,
  Clock,
  Layers,
  Hash,
  Activity,
  FileText,
} from 'lucide-astro';
import { TIPO_LABELS, TIPO_STYLES } from '../../../lib/eventTypes';

export async function getStaticPaths() {
  const events = await getAllEvents();
  return events.map((event) => {
    const filename = event.id.split('/').pop() ?? event.id;
    return {
      params: {
        year: new Date(event.data.fecha).getFullYear().toString(),
        id: filename,
      },
      props: { event },
    };
  });
}

const { event } = Astro.props;
const { titulo, fecha, tipo, tema, etiquetas, impacto, creado, actualizado } = event.data;
const filename = event.id.split('/').pop() ?? event.id;
const { Content } = await render(event);

const dateObj = new Date(fecha);
const fechaStr = dateObj.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const entities = getEventEntities(event.id);
const [peopleMap, topicsMap, orgsMap] = await Promise.all([getPeopleMap(), getTopicsMap(), getOrgsMap()]);

const personaNombres = entities.personas.map((id) => ({ id, nombre: peopleMap.get(id) ?? id }));
const orgNombres = entities.organizaciones.map((id) => ({ id, nombre: orgsMap.get(id) ?? id }));
const temaNombres = tema.map((id) => ({ id, nombre: topicsMap.get(id) ?? id }));

const cifrasRegistry = getCifrasRegistry();
const cifraConceptos = [...new Set(entities.cifras.map((c) => c.concepto))].map((concepto) => ({
  concepto,
  nombre: cifrasRegistry[concepto]?.nombre ?? concepto,
}));

const refs = resolveReferences(entities.fuentesAll);
const allEvents = await getAllEvents();
const connections = getEventConnections(event, allEvents, buildEventsByBasename(allEvents), buildIncomingIndex(allEvents));
---

<Base title={titulo}>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8 bg-white p-6 sm:p-8 rounded-2xl border border-gray-200/80 shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <a href="/events" class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-700 bg-blue-50 px-2.5 py-1 rounded-lg transition-colors">
          <ArrowLeft class="h-3.5 w-3.5" />
          <span>Volver a Eventos</span>
        </a>
      </div>
      <h1 transition:name={`event-title-${filename}`} class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 leading-tight text-balance">{titulo}</h1>
      <div class="flex flex-wrap items-center gap-3 text-xs text-gray-600">
        <span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold ring-1 ring-inset ${TIPO_STYLES[tipo] || 'bg-gray-100 text-gray-700 ring-gray-200'}`}>
          <FileText class="h-3.5 w-3.5 shrink-0" />
          {TIPO_LABELS[tipo] || tipo}
        </span>
        <time class="inline-flex items-center gap-1.5 text-gray-500 font-medium bg-gray-50 px-2.5 py-1 rounded-md border border-gray-200/60">
          <Calendar class="h-3.5 w-3.5 text-gray-400 shrink-0" />
          {fechaStr}
        </time>
      </div>
    </header>

    <section class="prose prose-gray max-w-none mb-10 bg-white p-6 sm:p-8 rounded-2xl border border-gray-200/80 shadow-sm leading-relaxed text-gray-800">
      <Content />
    </section>

    {impacto && (impacto.colectivos?.length > 0 || impacto.sectores?.length > 0) && (
      <section class="mb-8 bg-amber-50/50 border border-amber-200/70 rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-3">
          <Activity class="h-5 w-5 text-amber-700 shrink-0" />
          <h2 class="text-base font-bold text-amber-950">Impacto y Alcance</h2>
        </div>
        <div class="space-y-3 text-sm">
          {impacto.colectivos?.length > 0 && (
            <div>
              <span class="font-semibold text-amber-900">Colectivos afectados: </span>
              <span class="text-amber-800">{impacto.colectivos.join(', ')}</span>
            </div>
          )}
          {impacto.sectores?.length > 0 && (
            <div>
              <span class="font-semibold text-amber-900">Sectores involucrados: </span>
              <span class="text-amber-800">{impacto.sectores.join(', ')}</span>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="mb-10 bg-white p-6 rounded-2xl border border-gray-200/80 shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <Tag class="h-5 w-5 text-blue-600 shrink-0" />
        <h2 class="text-base font-bold text-gray-900">Entidades y Etiquetas</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
        <div>
          <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
            <Layers class="h-3.5 w-3.5 text-gray-400" />
            Temas
          </h3>
          <div class="flex gap-1.5 flex-wrap">
            {temaNombres.map((t) => (
              <a href={`/topics/${t.id}`} transition:name={`topic-title-${t.id}`} class="inline-flex items-center gap-1 text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-2.5 py-1 rounded-lg transition-colors">
                <Tag class="h-3 w-3 text-gray-400" />
                {t.nombre}
              </a>
            ))}
          </div>
        </div>

        {personaNombres.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
              <User class="h-3.5 w-3.5 text-gray-400" />
              Personas
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {personaNombres.map((p) => (
                <a href={`/people/${p.id}`} transition:name={`person-title-${p.id}`} class="inline-flex items-center gap-1 text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-2.5 py-1 rounded-lg transition-colors">
                  <User class="h-3 w-3 text-gray-400" />
                  {p.nombre}
                </a>
              ))}
            </div>
          </div>
        )}

        {orgNombres.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
              <Building2 class="h-3.5 w-3.5 text-gray-400" />
              Organizaciones
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {orgNombres.map((o) => (
                <a href={`/organizations/${o.id}`} transition:name={`org-title-${o.id}`} class="inline-flex items-center gap-1 text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-2.5 py-1 rounded-lg transition-colors">
                  <Building2 class="h-3 w-3 text-gray-400" />
                  {o.nombre}
                </a>
              ))}
            </div>
          </div>
        )}

        {cifraConceptos.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
              <TrendingUp class="h-3.5 w-3.5 text-blue-500" />
              Cifras Destacadas
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {cifraConceptos.map((c) => (
                <a href={`/stats/${c.concepto}`} class="inline-flex items-center gap-1 text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 font-medium px-2.5 py-1 rounded-lg transition-colors border border-blue-200/60">
                  <TrendingUp class="h-3 w-3 text-blue-500" />
                  {c.nombre}
                </a>
              ))}
            </div>
          </div>
        )}

        {etiquetas.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
              <Hash class="h-3.5 w-3.5 text-gray-400" />
              Etiquetas libres
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {etiquetas.map((e) => (
                <span class="inline-flex items-center text-xs bg-gray-100/70 text-gray-600 px-2 py-0.5 rounded-md font-mono">
                  #{e}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <EventTimelineConnector connections={connections} />

    <EventConnections connections={connections} topicsMap={topicsMap} />

    {refs.length > 0 && (
      <section class="mb-10 bg-white p-6 rounded-2xl border border-gray-200/80 shadow-sm">
        <div class="flex items-center gap-2 mb-4">
          <BookOpen class="h-5 w-5 text-blue-600 shrink-0" />
          <h2 class="text-base font-bold text-gray-900">Referencias y Fuentes ({refs.length})</h2>
        </div>
        <ol class="space-y-3 text-sm">
          {refs.map((ref, i) => (
            <li id={`ref-${i + 1}`} class="flex items-start gap-2.5 text-gray-700 scroll-mt-20 p-2.5 rounded-lg hover:bg-gray-50 transition-colors border border-transparent hover:border-gray-200/60">
              <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-blue-100 text-blue-700 font-mono text-xs shrink-0 font-semibold mt-0.5">
                {i + 1}
              </span>
              <div class="min-w-0 flex-1">
                {ref.url ? (
                  <a href={ref.url} class="inline-flex items-center gap-1 font-semibold text-blue-600 hover:text-blue-800 hover:underline" target="_blank" rel="noopener">
                    <span>{ref.titulo}</span>
                    <ExternalLink class="h-3.5 w-3.5 shrink-0 text-blue-500" />
                  </a>
                ) : (
                  <span class="font-semibold text-gray-900">{ref.titulo}</span>
                )}
                {ref.url && (
                  <span class="inline-flex items-center gap-1 ml-2">
                    <a href={`https://web.archive.org/web/${ref.url}`} class="text-[10px] font-medium text-gray-400 hover:text-blue-500 transition-colors" target="_blank" rel="noopener" title="Wayback Machine">Archive</a>
                    <a href={`https://archive.ph/${ref.url}`} class="text-[10px] font-medium text-gray-400 hover:text-orange-500 transition-colors" target="_blank" rel="noopener" title="archive.ph">archive.ph</a>
                    <a href={`https://ghostarchive.org/search?term=${encodeURIComponent(ref.url)}`} class="text-[10px] font-medium text-gray-400 hover:text-purple-500 transition-colors" target="_blank" rel="noopener" title="Ghostarchive">Ghost</a>
                    <a href={`https://timetravel.mementoweb.org/memento/${ref.url}`} class="text-[10px] font-medium text-gray-400 hover:text-teal-500 transition-colors" target="_blank" rel="noopener" title="Memento Time Travel">Memento</a>
                    <a href={`https://r.jina.ai/${ref.url}`} class="text-[10px] font-medium text-gray-400 hover:text-green-500 transition-colors" target="_blank" rel="noopener" title="Versión Texto Limpio">Reader</a>
                    <a href={`https://www.paywallskip.com/article?url=${encodeURIComponent(ref.url)}`} class="text-[10px] font-medium text-gray-400 hover:text-amber-500 transition-colors" target="_blank" rel="noopener" title="Paywall Skip">Paywall</a>
                    <a href={`https://defuddle.md/${ref.url}`} class="text-[10px] font-medium text-gray-400 hover:text-indigo-500 transition-colors" target="_blank" rel="noopener" title="Defuddle">Defuddle</a>
                    <a href={`https://markdown.new/${ref.url}`} class="text-[10px] font-medium text-gray-400 hover:text-pink-500 transition-colors" target="_blank" rel="noopener" title="Markdown">MD</a>
                  </span>
                )}
                <p class="text-xs text-gray-500 mt-0.5">
                  Medio: <span class="font-medium text-gray-700">{ref.medio}</span> {ref.autor ? `· Autor: ${ref.autor}` : ''}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <footer class="flex items-center gap-2 text-xs text-gray-400 border-t border-gray-200/60 pt-4">
      <Clock class="h-3.5 w-3.5 text-gray-400" />
      <span>Creado: {creado.toLocaleDateString('es-ES')} · Actualizado: {actualizado.toLocaleDateString('es-ES')}</span>
    </footer>
  </article>
</Base>

