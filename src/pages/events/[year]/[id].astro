    const all = gvVoices();
    const es = all.filter((v) => v.lang.toLowerCase().startsWith('es'));
    const rest = all.filter((v) => !es.includes(v));
    const sorted = [...es, ...rest];
    if (sorted.length === 0) return;
    // Voz guardada o, por defecto, la mejor es-CL/es-ES.
    const saved = localStorage.getItem(TTS_KEY);
    const best =
      sorted.find((v) => v.name === saved) ??
      sorted.find((v) => v.lang.startsWith('es-CL')) ??
      sorted.find((v) => v.lang.startsWith('es-ES')) ??
      sorted.find((v) => v.lang.startsWith('es')) ??
      sorted[0];
    for (const v of sorted) {
      const opt = document.createElement('option');
      opt.value = v.name;
      opt.textContent = `${v.name} (${v.lang})`;
      if (v === best) opt.selected = true;
