<script>
  // TTS (con selector de voz: navegador + Piper neural) + copiar markdown + ChatGPT.
  import * as tts from '@realtimex/piper-tts-web';
  import { play } from 'cuelume';
  const PIPER_PREFIX = 'piper:';
  let gvPiperAudio: HTMLAudioElement | null = null;
  // Clave (voz|texto) del artículo cuyos trozos ya están en gvChunkUrls. El estado vive a
  // nivel de módulo (window persiste entre navegaciones View Transitions): Detener pausa en
  // vez de destruir, y volver a la página retoma desde el mismo trozo sin resintetizar.
  let gvCacheKey: string | null = null;
  // Reproducción por trozos: una object URL por trozo (~1,3 MB cada uno), en orden, y el
  // índice del que suena. Cada trozo ya viene como WAV Blob de predict(), así que no hay
  // ni concatenación ni un WAV gigante en memoria: el resaltado es el índice del trozo.
  let gvChunkUrls: string[] = [];
  let gvChunkEls: (Element | null)[] = [];
  let gvIdx = 0;
  let gvActiveIdx = -1;
  // Estados del transporte. 'waiting' = el audio terminó pero la síntesis del siguiente
  // trozo sigue corriendo (caso límite: la síntesis es más rápida que el audio).
  let gvTtsState: 'idle' | 'playing' | 'paused' | 'waiting' | 'ended' = 'idle';
  let gvSynthDone = false;
  // LRU de trozos por (voz|texto de trozo), en vez de un único WAV por artículo. Al
  // volver a un párrafo ya leído no se resintetiza, y cambiar de artículo no tira todo.
  const GV_CHUNK_CACHE_MAX = 12;
  const gvChunkCache = new Map<string, string>();
  function gvChunkCacheGet(key: string): string | null {
    const url = gvChunkCache.get(key);
    if (!url) return null;
    gvChunkCache.delete(key); // re-insert = refrescar recencia
    gvChunkCache.set(key, url);
    return url;
  }
  function gvChunkCacheSet(key: string, url: string) {
    gvChunkCache.set(key, url);
    // Invariante: nunca revocar una URL que todavía se va a reproducir, no solo la que
    // suena ahora. En un evento largo el cache crece por synthesis y la reproducción va
    // detrás: revocar por antigüedad dejaba blobs ya pendientes y el audio moría en el
    // primer onerror. Solo se poda lo que no está ni en gvChunkUrls ni sonando.
    while (gvChunkCache.size > GV_CHUNK_CACHE_MAX) {
      let victim: string | null = null;
      for (const k of gvChunkCache.keys()) {
        if (k === key) continue; // la que se está insertando: aún no está en gvChunkUrls
        const u = gvChunkCache.get(k);
        if (u && !gvChunkUrls.includes(u) && u !== gvPiperAudio?.src) { victim = k; break; }
      }
      if (victim === null) break; // todo lo que sobra está pendiente: no hay nada que podar
      const old = gvChunkCache.get(victim);
      if (old) URL.revokeObjectURL(old);
      gvChunkCache.delete(victim);
    }
  }
  // Poda lo que quedó del artículo anterior al empezar uno nuevo, respetando lo pendiente.
  function gvPruneChunkCache() {
    for (const [k, u] of [...gvChunkCache]) {
      if (gvChunkCache.size <= GV_CHUNK_CACHE_MAX) break;
      if (gvChunkUrls.includes(u) || u === gvPiperAudio?.src) continue;
      URL.revokeObjectURL(u);
      gvChunkCache.delete(k);
    }
  }
  function gvShowTtsControls(show: boolean) {
    for (const id of ['btn-tts-restart', 'btn-tts-prev', 'btn-tts-next']) {
      const el = document.getElementById(id);
      if (!el) continue;
      el.classList.toggle('hidden', !show);
      el.classList.toggle('inline-flex', show);
    }
  }
  function gvClearHighlight() {
    document.querySelector('.gv-tts-active')?.classList.remove('gv-tts-active');
    gvActiveIdx = -1;
  }
  // Resalta el bloque del trozo en reproducción. Con audio por trozos el índice es
  // gvIdx: no hace falta interpolar posiciones dentro de un WAV concatenado.
  function gvSyncHighlight() {
    if (!gvPiperAudio || gvChunkEls.length === 0) return;
    const idx = Math.min(gvIdx, gvChunkEls.length - 1);
    if (idx === gvActiveIdx) return;
    document.querySelector('.gv-tts-active')?.classList.remove('gv-tts-active');
    gvActiveIdx = idx;
    const el = gvChunkEls[idx];
    if (!el?.isConnected) return;
    el.classList.add('gv-tts-active');
    const r = el.getBoundingClientRect();
    if (r.bottom < 90 || r.top > window.innerHeight - 90) {
      el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
  }
  // Los saltos solo aplican al audio Piper ya sintetizado y con la voz Piper aún elegida.
  function gvJumpable(): boolean {
    const selNow = document.getElementById('tts-voice') as HTMLSelectElement | null;
    if (!selNow?.value.startsWith(PIPER_PREFIX)) return false;
    return !!gvPiperAudio && !!gvCacheKey && gvChunkUrls.length > 0;
  }
  function gvMarkPlaying() {
    const label = document.querySelector('[data-tts-label]');
    if (label) label.textContent = 'Detener';
    gvSetTtsPlaying(true);
  }
  function gvStopAll() {
    window.speechSynthesis?.cancel();
    // Pausa (NO revoca los blobs): los trozos quedan cacheados para reanudar al instante.
    if (gvPiperAudio && !gvPiperAudio.paused) {
      gvPiperAudio.pause();
      if (gvTtsState === 'playing') gvTtsState = 'paused';
    }
  }
  if (!(window as any).__gvEventActionsInit) {
    (window as any).__gvEventActionsInit = true;
    document.addEventListener('astro:page-load', gvStopAll);
  }
  const TTS_KEY = 'gv-tts-voice';
  const RATE_KEY = 'gv-tts-rate';
  // 1,25× recorta un evento promedio (~5 min) a ~4 sin alterar el timbre: los pitch
  // correctores de WebAudio introducen latencia solo si el navegador no los trae.
  const GV_RATES = [0.9, 1, 1.25, 1.5];
  function gvRate(): number {
    const v = Number(localStorage.getItem(RATE_KEY));
    return GV_RATES.includes(v) ? v : 1;
  }
  // El rate es una propiedad del elemento vivo: se reaplica en cada transición de
  // transporte (no solo al asignar src) para que sobreviva a pausas y saltos.
  function gvApplyRate(audio?: HTMLAudioElement | null) {
    const a = audio ?? gvPiperAudio;
    if (!a) return;
    const r = gvRate();
    a.playbackRate = r;
    // Safari expone el preservador de tono con prefijo; ambos son inofensivos si faltan.
    (a as any).preservesPitch = true;
    (a as any).webkitPreservesPitch = true;
  }
  function gvSyncRateUi() {
    const el = document.getElementById('tts-rate') as HTMLSelectElement | null;
    if (el) el.value = String(gvRate());
  }
  // El <select> se recrea en cada navegación (ClientRouter), así que tras poblarlo hay que
  // reseleccionar la voz guardada: sin esto se pierde el "selected" al rehacer el DOM.
  function gvSyncVoiceUi() {
    const sel = document.getElementById('tts-voice') as HTMLSelectElement | null;
    if (!sel || sel.options.length === 0) return;
    const saved = localStorage.getItem(TTS_KEY);
    if (saved && [...sel.options].some((o) => o.value === saved)) sel.value = saved;
  }
  function gvVoices() {
    return window.speechSynthesis?.getVoices() ?? [];
  }
  // Voces neurales Piper (es): se descargan la primera vez desde HF CDN y se cachean en OPFS.
  // Estas tres NO están en el mirror de la librería (diffusionstudio) sino en rhasspy/piper-
  // voices (~60 MB cada una, verificado). Se registran en PATH_MAP y se bajan de ahí a OPFS
  // a mano; el resto de voces es que exponga el mirror se sigue resolviendo por tts.download().
  const AR_BASE = 'https://huggingface.co/rhasspy/piper-voices/resolve/main/';
  const GV_PIPER_PATHS: Record<string, string> = {
    'es_MX-claude-high': 'es/es_MX/claude/high/es_MX-claude-high.onnx',
    'es_AR-daniela-high': 'es/es_AR/daniela/high/es_AR-daniela-high.onnx',
    'es_ES-davefx-medium': 'es/es_ES/davefx/medium/es_ES-davefx-medium.onnx',
  };
  // Curadas primero en el selector: el vault es chileno y es_MX es el acento latinoamericano
  // más neutro disponible en Piper (es_AR suena rioplatense, es_ES europeo). Las pistas van
  // en title/aria-label porque el option va truncado por el max-w del select.
  const GV_PIPER_CURATED = [
    {
      key: 'es_MX-claude-high',
      label: 'Latinoamericana',
      tag: 'es_MX',
      hint: 'Acento mexicano neutro; la más cercana a una voz de televisión para texto latinoamericano.',
    },
    { key: 'es_AR-daniela-high', label: 'Rioplatense', tag: 'es_AR', hint: 'Acento de Río de la Plata.' },
    {
      key: 'es_ES-davefx-medium',
      label: 'Española',
      tag: 'es_ES',
      hint: 'Acento de España. Mismo tamaño de descarga (~60 MB) que las otras dos.',
    },
  ];
  function gvRegPiperPaths() {
    try {
      const map = (tts as any).PATH_MAP;
      if (!map) return;
      for (const [key, path] of Object.entries(GV_PIPER_PATHS)) map[key] = path;
    } catch { /* ya no soporta mutar */ }
  }
  // Descarga .onnx y .onnx.json directo a OPFS (misma estructura de cache que la librería).
  // Verifica existencia por archivo antes de bajar: idempotente, se puede llamar siempre.
  async function gvCachePiperFiles(voiceId: string, onProgress?: (p: number) => void) {
    const path = GV_PIPER_PATHS[voiceId];
    if (!path) throw new Error(`Voz Piper sin ruta en HF: ${voiceId}`);
    const blame = (u: string) => u.split('/').at(-1) as string;
    const total = 2;
    let doneFiles = 0;
    const root = await navigator.storage.getDirectory();
    const dir = await root.getDirectoryHandle('piper', { create: true });
    for (const suffix of ['', '.json']) {
      const url = `${AR_BASE}${path}${suffix}`;
      try {
        const file = await dir.getFileHandle(blame(url), { create: false });
        await file.getFile(); // existe ya → no re-descarga
        doneFiles++;
        onProgress?.(Math.round((doneFiles / total) * 100));
        continue;
      } catch { /* no existe, descargar */ }
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status} para ${blame(url)}`);
      const blob = await res.blob();
      const file = await dir.getFileHandle(blame(url), { create: true });
      const w = await file.createWritable();
      await w.write(blob);
      await w.close();
      doneFiles++;
      onProgress?.(Math.round((doneFiles / total) * 100));
    }
  }
  // ClientRouter reemplaza el <select> al cambiar de evento: la caché de
  // voces neurales debe vivir por elemento, no en un booleano de página.
  const gvPiperFilledSelects = new WeakSet<HTMLSelectElement>();
  const gvPiperFillingSelects = new WeakSet<HTMLSelectElement>();
  async function gvFillPiperVoices() {
    const sel = document.getElementById('tts-voice') as HTMLSelectElement | null;
    if (!sel || gvPiperFilledSelects.has(sel) || gvPiperFillingSelects.has(sel)) return;
    gvPiperFillingSelects.add(sel);
    try {
      gvRegPiperPaths();
      const saved = localStorage.getItem(TTS_KEY);
      // Las curadas se pintan de forma síncrona: el select nunca queda deshabilitado
      // por culpa de la red, y el mirror solo agrega extras (no define la oferta).
      const curated = document.createElement('optgroup');
      curated.label = 'Voz neural (Piper, descarga única)';
      for (const v of GV_PIPER_CURATED) {
        const opt = document.createElement('option');
        opt.value = PIPER_PREFIX + v.key;
        opt.textContent = `${v.label} (${v.tag}) Piper`;
        opt.title = v.hint;
        opt.setAttribute('aria-label', `${v.label} (${v.tag}). ${v.hint}`);
        if (saved === opt.value) opt.selected = true;
        curated.appendChild(opt);
      }
      sel.appendChild(curated);
      // Extras del mirror, deduplicadas contra las curadas. Si el mirror no responde,
      // las curadas siguen en pie: no es un fallo silencioso de disponibilidad.
      try {
        const extra = (await tts.voices()).filter((v) => v.key.startsWith('es_') && !GV_PIPER_PATHS[v.key]);
        if (extra.length > 0) {
          const more = document.createElement('optgroup');
          more.label = 'Otras voces en español';
          for (const v of extra) {
            const opt = document.createElement('option');
            opt.value = PIPER_PREFIX + v.key;
            opt.textContent = `${v.name} (${v.language?.code ?? v.key}) Piper`;
            if (saved === opt.value) opt.selected = true;
            more.appendChild(opt);
          }
          sel.appendChild(more);
        }
      } catch (err) {
        console.warn('Listado de voces Piper no disponible', err);
      }
      sel.removeAttribute('disabled');
      gvPiperFilledSelects.add(sel);
    } catch (err) {
      console.warn('Piper no disponible', err);
    } finally {
      gvPiperFillingSelects.delete(sel);
    }
  }
  // Rellena el <select>: primero las voces en español de la plataforma/neurales,
  // luego el resto (por si no hay es, que al menos sigan funcionando).
  function gvFillVoices() {
    const sel = document.getElementById('tts-voice') as HTMLSelectElement | null;
    if (!sel || sel.options.length > 0) return;
    const all = gvVoices();
    const es = all.filter((v) => v.lang.toLowerCase().startsWith('es'));
    const rest = all.filter((v) => !es.includes(v));
    const sorted = [...es, ...rest];
    if (sorted.length === 0) return;
    // Voz guardada o, por defecto, la mejor es-CL/es-ES.
    const saved = localStorage.getItem(TTS_KEY);
    const best =
      sorted.find((v) => v.name === saved) ??
      sorted.find((v) => v.lang.startsWith('es-CL')) ??
      sorted.find((v) => v.lang.startsWith('es-ES')) ??
      sorted.find((v) => v.lang.startsWith('es')) ??
      sorted[0];
    for (const v of sorted) {
      const opt = document.createElement('option');
      opt.value = v.name;
      opt.textContent = `${v.name} (${v.lang})`;
      if (v === best) opt.selected = true;
      sel.appendChild(opt);
    }
    sel.removeAttribute('disabled');
  }
  function gvSpanishVoice(voices: SpeechSynthesisVoice[]) {
    return (
      voices.find((v) => v.lang.startsWith('es-CL')) ??
      voices.find((v) => v.lang.startsWith('es-ES')) ??
      voices.find((v) => v.lang.startsWith('es'))
    );
  }
  function gvSetTtsPlaying(playing: boolean) {
    document.querySelector('[data-tts-icon="playing"]')?.classList.toggle('hidden', !playing);
    document.querySelector('[data-tts-icon="idle"]')?.classList.toggle('hidden', playing);
  }
  function gvUtt(msg: HTMLElement | null) {
    const label = document.querySelector('[data-tts-label]');
    if (label) label.textContent = 'Escuchar';
    gvSetTtsPlaying(false);
    if (msg) msg.textContent = '';
  }
  let gvFilled = false;
  function gvEnsureVoices() {
    if (gvFilled || gvVoices().length > 0) { gvFillVoices(); gvFilled = true; }
  }
  // Piper: primera escucha descarga el modelo (~60-75MB, 1 vez, a OPFS); luego sintetiza offline.
  let gvPiperBusy = false;
  // Pre-descarga la voz al seleccionarla (evento 'change'), no al hacer play; evita la espera del modelo.
  const gvPreloading = new Set<string>();
  const gvTtsBusyTasks = new Set<string>();
  function gvSetTtsBusy(task: string, busy: boolean) {
    if (busy) gvTtsBusyTasks.add(task);
    else gvTtsBusyTasks.delete(task);
    const active = gvTtsBusyTasks.size > 0;
    const button = document.getElementById('btn-tts');
    if (!button) return;
    button.setAttribute('aria-busy', String(active));
    // Estado estático desde la tarea real: sin rAF, canvas ni animación continua.
    button.style.boxShadow = active
      ? '0 0 0 2px color-mix(in oklab, var(--color-primary) 30%, transparent)'
      : '';
  }
  async function gvPreloadPiper(voiceId: string) {
    if (gvPreloading.has(voiceId)) return;
    gvPreloading.add(voiceId);
    const task = `preload:${voiceId}`;
    const label = document.querySelector('[data-tts-label]');
    const msg = document.getElementById('tts-msg');
    try {
      const stored = await tts.stored();
      if (stored.includes(voiceId)) return; // ya cacheada en OPFS, no bajar de nuevo
      gvSetTtsBusy(task, true);
      if (label) label.textContent = 'Descargando…';
      if (msg) msg.textContent = 'Preparando voz… (primera vez)';
      if (GV_PIPER_PATHS[voiceId]) {
        // Las curadas no pasan por tts.download(): se bajan desde HF a OPFS con
        // verificación por archivo, que ya es idempotente.
        await gvCachePiperFiles(voiceId, (p) => {
          if (msg) msg.textContent = `Preparando voz… ${p}%`;
        });
      } else {
        // 'download' cachea en OPFS sin sintetizar; el play posterior es instantáneo.
        await tts.download(voiceId, (p) => {
          if (msg && p.total > 0) msg.textContent = `Preparando voz… ${Math.round((p.loaded / p.total) * 100)}%`;
        });
      }
      if (label) label.textContent = 'Escuchar';
      if (msg) msg.textContent = '';
    } catch (err) {
      console.warn('Pre-descarga Piper falló', err);
    } finally {
      gvPreloading.delete(voiceId);
      gvSetTtsBusy(task, false);
    }
  }
  // Bloques legibles del artículo: cada uno se sintetiza/resalta como unidad.
  // El texto de cada bloque se normaliza igual que el body leído antes.
  function gvBlockParts(prose: Element | null): { el: Element; text: string }[] {
    if (!prose) return [];
    const sel = 'p, h1, h2, h3, h4, h5, h6, li, blockquote, pre';
    const all = Array.from(prose.querySelectorAll(sel));
    // Bloque más externo solamente (blockquote > p cuenta como blockquote).
    const blocks = all.filter((el) => !all.some((o) => o !== el && o.contains(el)));
    const parts: { el: Element; text: string }[] = [];
    for (const el of blocks) {
      if (el.closest('.not-prose')) continue;
      const clone = el.cloneNode(true) as Element;
      // Los marcadores inline de referencia son ruido hablado ("uno", "dos"… por cada
      // fuente). Se sustituyen por un espacio en vez de borrarse del todo, para que
      // "palabra<sup>[2]</sup>palabra" no quede pegado sin separación.
      clone.querySelectorAll('.source-ref').forEach((n) => n.replaceWith(' '));
      const text = (clone.textContent ?? '')
        .replace(/\s+/g, ' ')
        // Ese espacio deja "sus viviendas ." / "11 de marzo ;": se despega de la
        // puntuación, que en el markdown original iba justo después del marcador.
        .replace(/\s+([.,;:!?…])/g, '$1')
        .trim();
      if (text) parts.push({ el, text });
    }
    return parts;
  }
  // Texto completo del artículo (lo que se habla; también clave del cache).
  function gvProseText(prose: Element | null): string {
    return gvBuildChunks(gvBlockParts(prose)).map((c) => c.text).join(' ');
  }
  // `predict()` de @realtimex/piper-tts-web es singleton: la primera voz carga el .onnx en
  // _ortSession y para toda la vida de la página solo se reescribe la propiedad voiceId
  // (dist/piper-tts-web.js:263-268). Cambiar de voz, por tanto, no recarga el modelo y se
  // sigue oyendo la primera. Se descarta el _instance para forzar una sesión nueva; el
  // .onnx ya está en OPFS, así que no vuelve a bajarlo.
  let gvSessionVoice: string | null = null;
  async function gvEnsureSessionVoice(voiceId: string, onMsg?: (m: string) => void) {
    if (gvSessionVoice === voiceId) return;
    gvSessionVoice = voiceId;
    try {
      (tts as any).TtsSession._instance = null;
      await tts.TtsSession.create({ voiceId });
      onMsg?.('');
    } catch (err) {
      // Si la sesión no se puede crear, se limpia el marcador para reintentar la próxima.
      gvSessionVoice = null;
      throw err;
    }
  }
  async function gvPiperToggle(voiceId: string, prose: Element | null, msg: HTMLElement | null) {
    const label = document.querySelector('[data-tts-label]');
    // Sintetizando → segundo clic CANCELA (revisado entre trozos; latencia ~1 trozo).
    if (gvPiperBusy) {
      gvSynthCancel = true;
      return;
    }
    const chunks = gvBuildChunks(gvBlockParts(prose));
    if (chunks.length === 0) return;
    const text = chunks.map((c) => c.text).join(' ');
    const key = `${voiceId}|${text}`;
    // Ya están todos los trozos de este artículo con esta voz → reproducir/pausar sin
    // resintetizar. Re-zipea los elementos DOM (mismo índice ⇒ mismo bloque; DOM determinista).
    if (gvCacheKey === key && gvChunkUrls.length === chunks.length) {
      gvChunkEls = chunks.map((c) => c.el);
      gvSynthDone = true;
      gvSynthCancel = false;
      if (gvTtsState === 'playing') {
        gvPiperAudio?.pause();
        gvTtsState = 'paused';
        if (label) label.textContent = 'Reanudar';
        gvSetTtsPlaying(false);
        if (msg) msg.textContent = '';
        return;
      }
      // 'paused'/'waiting' siguen donde estaban; 'ended' (o 'idle') vuelven al inicio.
      const from = gvTtsState === 'paused' || gvTtsState === 'waiting' ? gvIdx : 0;
      gvShowTtsControls(true);
      if (label) label.textContent = 'Detener';
      gvSetTtsPlaying(true);
      await gvPiperPlayIdx(from, msg);
      return;
    }
    if (gvPiperAudio && !gvPiperAudio.paused) gvStopAll();
    gvClearHighlight();
    gvPiperBusy = true;
    gvSetTtsBusy('synthesis', true);
    gvSynthCancel = false;
    if (label) label.textContent = 'Cancelar';
    if (msg) msg.textContent = 'Descargando modelo de voz (primera vez)…';
    try {
      // El phonemizer wasm falla con textos muy largos (codes espeak); por eso PCHUNK.
      // Cada trozo se reproduce en cuanto existe: no se espera a sintetizar el artículo
      // entero para empezar a oírlo.
      gvCacheKey = key;
      await gvPiperLoad(chunks, voiceId, msg, label);
    } catch (err) {
      gvChunkUrls = [];
      gvCacheKey = null;
      gvTtsState = 'idle';
      gvShowTtsControls(false);
      if (gvSynthCancel || (err as DOMException)?.name === 'AbortError') {
        gvUtt(msg);
        if (msg) msg.textContent = 'Síntesis cancelada';
      } else {
        console.error('Piper TTS falló', err);
        gvUtt(msg);
        if (msg) msg.textContent = 'Voz neural no disponible en tu red. Prueba una voz del navegador.';
      }
    } finally {
      gvPiperBusy = false;
      gvSetTtsBusy('synthesis', false);
    }
  }
  // Estado del mensaje según la fase real: no se anuncia "leyendo" mientras aún no suena,
  // y una vez que suena se anuncia aunque la síntesis siga en curso.
  function gvStatus(msg: HTMLElement | null, i: number, total: number, phase: string, cancelable = false) {
    if (!msg) return;
    if (cancelable) msg.textContent = `${phase}… ${i + 1}/${total} (clic para cancelar)`;
    else if (total > 1) msg.textContent = `${phase}… ${i + 1}/${total}`;
    else msg.textContent = `${phase}…`;
  }
  // Carga el trozo i y deja reproduciendo. Repite el mismo src si ya está cargado.
  async function gvPiperPlayIdx(i: number, msg: HTMLElement | null) {
    if (gvSynthCancel || i < 0 || i >= gvChunkUrls.length) return;
    const audio = (gvPiperAudio ??= new Audio());
    gvIdx = i;
    gvApplyRate(audio);
    audio.src = gvChunkUrls[i];
    audio.ontimeupdate = () => gvSyncHighlight();
    audio.onended = () => gvOnChunkEnded(msg);
    audio.onerror = () => {
      if (gvSynthCancel) return;
      // Un trozo ilegible (blob revocado, decodificación fallida) no debe abortar todo:
      // se salta al siguiente y solo se detiene si era el último.
      const next = gvIdx + 1;
      if (next < gvChunkUrls.length) {
        void gvPiperPlayIdx(next, msg);
        return;
      }
      gvSynthCancel = true;
      gvStopAll();
      gvTtsState = 'ended';
      gvUtt(msg);
    };
    gvTtsState = 'playing';
    try {
      await audio.play();
      gvSyncHighlight();
    } catch { /* política de autoplay: el estado queda listo para reintentar */ }
  }
  function gvOnChunkEnded(msg: HTMLElement | null) {
    gvClearHighlight();
    if (gvSynthCancel) return;
    const next = gvIdx + 1;
    if (next < gvChunkUrls.length) {
      void gvPiperPlayIdx(next, msg);
      return;
    }
    // Caso límite: terminó el audio pero el siguiente trozo aún se está sintetizando.
    if (!gvSynthDone) {
      gvTtsState = 'waiting';
      if (msg) msg.textContent = 'Preparando el siguiente párrafo…';
      return;
    }
    gvTtsState = 'ended';
    gvStopAll();
    gvUtt(msg);
  }
  // Sintetiza (o reutiliza del LRU) cada trozo. Arranca a reproducir el primero en cuanto
  // está listo y sigue con el resto en segundo plano; no concatena ni arma un WAV grande.
  async function gvPiperLoad(
    chunks: { el: Element; text: string }[],
    voiceId: string,
    msg: HTMLElement | null,
    label: Element | null
  ) {
    const keys = chunks.map((c) => `${voiceId}|${c.text}`);
    const cached = keys.map((k) => gvChunkCacheGet(k));
    gvChunkEls = chunks.map((c) => c.el);
    gvChunkUrls = [];
    gvIdx = 0;
    gvActiveIdx = -1;
    gvSynthDone = false;
    gvTtsState = 'idle';
    // Los trozos del artículo anterior ya no están en gvChunkUrls: se pueden podar.
    gvPruneChunkCache();
    // Todo en cache (volver al artículo, o saltar atrás): reproducir sin sintetizar.
    if (cached.every((u): u is string => !!u)) {
      gvChunkUrls = cached;
      gvSynthDone = true;
      gvShowTtsControls(true);
      if (label) label.textContent = 'Detener';
      gvSetTtsPlaying(true);
      await gvPiperPlayIdx(0, msg);
      return;
    }
    for (let i = 0; i < chunks.length; i++) {
      if (gvSynthCancel) throw new DOMException('Síntesis cancelada', 'AbortError');
      // Antes del primer predict: si la voz es nueva, la sesión singleton debe recrearse
      // o se sintetizaría con el modelo de la voz anterior.
      if (i === 0 && !cached[i]) await gvEnsureSessionVoice(voiceId, (m) => gvStatus(msg, 0, chunks.length, m));
      let url = gvChunkCacheGet(keys[i]);
      if (!url) {
        gvStatus(msg, i, chunks.length, 'Sintetizando', true);
        const blob = await tts.predict({ text: chunks[i].text, voiceId }, (p) => {
          if (p.total > 0) gvStatus(msg, i, chunks.length, 'Descargando voz');
        });
        url = URL.createObjectURL(blob);
        gvChunkCacheSet(keys[i], url);
      }
      gvChunkUrls.push(url);
      if (i === 0) {
        // Primer trozo listo → empieza a sonar ya, sin esperar el resto.
        gvShowTtsControls(true);
        if (label) label.textContent = 'Detener';
        gvSetTtsPlaying(true);
        await gvPiperPlayIdx(0, msg);
        if (msg) msg.textContent = chunks.length > 1 ? `Leyendo… (quedan ${chunks.length - 1} párrafos)` : 'Leyendo con voz neural…';
      } else if (gvTtsState === 'waiting') {
        void gvPiperPlayIdx(gvIdx + 1, msg);
      }
    }
    gvSynthDone = true;
    if (gvTtsState === 'waiting') void gvPiperPlayIdx(gvIdx + 1, msg);
    else if (gvTtsState === 'playing' && msg) msg.textContent = 'Leyendo con voz neural…';
  }
  // Tamaño máximo de trozo: el phonemizer wasm aborta con inputs muy largos
  // (codes espeak), así que los bloques se subdividen antes de sintetizar.
  const PCHUNK = 900;
  // Cancelación cooperativa: gvPiperToggle lo activa con un segundo clic y el
  // loop revisa entre trozos (no se puede abortar mid-chunk sin tocar el worker).
  let gvSynthCancel = false;
  // Divide un bloque > max por oraciones (el phonemizer wasm aborta con inputs largos).
  function gvSplitLong(text: string, max: number): string[] {
    const sentences = text.split(/(?<=[.!?…])\s+/);
    const out: string[] = [];
    let cur = '';
    for (const s of sentences) {
      if (!cur) {
        if (s.length > max) {
          // Oración gigante: cortar por palabras.
          let rest = s;
          while (rest.length > max) {
            let cut = rest.lastIndexOf(' ', max);
            if (cut === -1) cut = max;
            out.push(rest.slice(0, cut).trim());
            rest = rest.slice(cut).trim();
          }
          cur = rest;
        } else cur = s;
        continue;
      }
      if (cur.length + 1 + s.length > max) { out.push(cur); cur = s; }
      else cur += ' ' + s;
    }
    if (cur) out.push(cur);
    return out;
  }
  // Trozos sintetizables desde los bloques: bloques cortos van enteros; los
  // largos se subdividen por oración conservando el el de origen (highlight).
  function gvBuildChunks(parts: { el: Element; text: string }[]): { el: Element; text: string }[] {
    const chunks: { el: Element; text: string }[] = [];
    for (const p of parts) {
      if (p.text.length <= PCHUNK) chunks.push(p);
      else for (const t of gvSplitLong(p.text, PCHUNK)) chunks.push({ el: p.el, text: t });
    }
    return chunks;
  }
  type CopyFeedbackState = 'copied' | 'error';
  const gvCopyResetTimers = new WeakMap<HTMLButtonElement, number>();
  function gvSetCopyFeedback(button: HTMLButtonElement, state: CopyFeedbackState) {
    const iconSwap = button.querySelector<HTMLElement>('[data-copy-swap]');
    const status = button.parentElement?.querySelector<HTMLElement>(':scope > [data-copy-status]');
    const previousTimer = gvCopyResetTimers.get(button);
    if (previousTimer) window.clearTimeout(previousTimer);

    if (iconSwap) iconSwap.dataset.state = state;
    if (status) {
      status.textContent = state === 'copied'
        ? button.dataset.copySuccessMessage ?? 'Contenido copiado al portapapeles.'
        : button.dataset.copyErrorMessage ?? 'No se pudo copiar el contenido.';
    }

    gvCopyResetTimers.set(button, window.setTimeout(() => {
      if (iconSwap?.isConnected) iconSwap.dataset.state = 'idle';
      if (status?.isConnected) status.textContent = '';
      gvCopyResetTimers.delete(button);
    }, state === 'copied' ? 2000 : 2500));
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const prose = document.querySelector('.prose');
    const exportEl = document.getElementById('event-export-data');
    const promptEl = document.getElementById('event-export-data');
    // A nivel del listener: las ramas de reinicio/siguiente también necesitan el nodo de
    // estado, no solo la de #btn-tts (declararlo dentro de esa rama daba ReferenceError).
    const msg = document.getElementById('tts-msg');
    gvEnsureVoices();

    if (target.closest('#btn-tts')) {
      e.preventDefault();
      const sel = document.getElementById('tts-voice') as HTMLSelectElement | null;
      const voiceId = sel?.value ?? '';
      if (voiceId.startsWith(PIPER_PREFIX)) {
        gvPiperToggle(voiceId.slice(PIPER_PREFIX.length), prose, msg);
        return;
      }
      if (!window.speechSynthesis) return;
      // Corta el audio Piper previo (sonando o pausado): solo una voz a la vez,
      // y su resaltado ya no corresponde a este motor.
      gvStopAll();
      gvClearHighlight();
      if (speechSynthesis.speaking || speechSynthesis.paused) {
        speechSynthesis.cancel();
        gvUtt(msg);
        return;
      }
      const text = gvProseText(prose);
      if (!text) return;
      const utter = new SpeechSynthesisUtterance(text);
      const voice = (sel && gvVoices().find((v) => v.name === sel.value)) || gvSpanishVoice(gvVoices());
      if (voice) { utter.voice = voice; utter.lang = voice.lang; }
      // La misma velocidad que en Piper; sobre ~2 el navegador suena roto, así que se topa.
      utter.rate = Math.min(0.98 * gvRate(), 2);
      utter.onend = utter.onerror = () => gvUtt(msg);
      speechSynthesis.speak(utter);
      const label = document.querySelector('[data-tts-label]');
      if (label) label.textContent = 'Detener';
      gvSetTtsPlaying(true);
      if (msg) msg.textContent = 'Lectura en voz alta en progreso…';
      return;
    }
    if (target.closest('#btn-tts-restart')) {
      e.preventDefault();
      if (!gvJumpable()) return;
      gvSynthCancel = false;
      void gvPiperPlayIdx(0, msg).then(gvMarkPlaying);
      return;
    }
    if (target.closest('#btn-tts-prev')) {
      e.preventDefault();
      if (!gvJumpable()) return;
      gvSynthCancel = false;
      // Párrafo anterior; en el primero se reinicia ese mismo (no hay a dónde ir).
      void gvPiperPlayIdx(Math.max(0, gvIdx - 1), msg).then(gvMarkPlaying);
      return;
    }
    if (target.closest('#btn-tts-next')) {
      e.preventDefault();
      if (!gvJumpable()) return;
      gvSynthCancel = false;
      // Salta al párrafo siguiente; tras el último, vuelve al inicio.
      void gvPiperPlayIdx((gvIdx + 1) % gvChunkUrls.length, msg).then(gvMarkPlaying);
      return;
    }
    if (target.closest('#tts-rate') || target.closest('#tts-voice')) return; // los gestiona 'change'
    // La persistencia de #tts-voice y #tts-rate vive en el listener de 'change': con
    // teclado el <select> emite change sin click, y ahí es donde se guarda.
    if (target.closest('#btn-copy-md')) {
      const btn = target.closest<HTMLButtonElement>('#btn-copy-md');
      const markdown = exportEl?.getAttribute('data-md') ?? '';
      if (!btn) return;
      if (!navigator.clipboard || !markdown) {
        gvSetCopyFeedback(btn, 'error');
        return;
      }
      void navigator.clipboard.writeText(markdown).then(() => {
        play('success');
        gvSetCopyFeedback(btn, 'copied');
      }).catch(() => {
        gvSetCopyFeedback(btn, 'error');
      });
      return;
    }
    // Los enlaces solo inyectan el prefill; el botón dedicado es el que copia
    // el prompt completo, para no sobrescribir el portapapeles sin avisar.
    const aiLink = target.closest<HTMLAnchorElement>('a[data-ai-prefill]');
    if (aiLink) {
      const prefill = promptEl?.getAttribute('data-ai-prefill');
      if (prefill) {
        try {
          const url = new URL(aiLink.href);
          url.searchParams.set('q', prefill);
          aiLink.href = url.toString();
        } catch { /* href inválida: conserva el fallback corto */ }
      }
      return;
    }
    if (target.closest('[data-copy-prompt]')) {
      const fullPrompt = promptEl?.getAttribute('data-prompt') ?? '';
      const btn = target.closest<HTMLButtonElement>('[data-copy-prompt]');
      if (!btn) return;
      if (!navigator.clipboard || !fullPrompt) {
        gvSetCopyFeedback(btn, 'error');
        return;
      }
      void navigator.clipboard.writeText(fullPrompt).then(() => {
        play('success');
        gvSetCopyFeedback(btn, 'copied');
      }).catch(() => {
        gvSetCopyFeedback(btn, 'error');
      });
    }
  });
  // Chrome/Edge cargan las voces de forma asíncrona; re-llena cuando estén listas.
  if (window.speechSynthesis) {
    window.speechSynthesis.addEventListener?.('voiceschanged', () => { gvFillVoices(); gvFilled = true; });
  }
  // Si el texto de esta página ya está sintetizado (cache) y pausado, el botón
  // debe mostrar "Reanudar" en vez de "Escuchar"; re-zipea los bloques para que
  // el resaltado/salto funcionen sin resintetizar.
  function gvMarkResumable() {
    if (!gvPiperAudio || !gvCacheKey) return;
    const sel = document.getElementById('tts-voice') as HTMLSelectElement | null;
    if (!sel?.value.startsWith(PIPER_PREFIX)) return;
    const prose = document.querySelector('.prose');
    const chunks = gvBuildChunks(gvBlockParts(prose));
    const key = `${sel.value.slice(PIPER_PREFIX.length)}|${chunks.map((c) => c.text).join(' ')}`;
    if (key !== gvCacheKey || gvChunkUrls.length !== chunks.length) return;
    gvChunkEls = chunks.map((c) => c.el);
    const label = document.querySelector('[data-tts-label]');
    if (label) label.textContent = 'Reanudar';
    gvShowTtsControls(true);
  }
  function gvInitTts() {
    gvEnsureVoices();
    gvSyncRateUi();
    gvSyncVoiceUi();
    // gvFillPiperVoices() es async: el optgroup neural se agrega después, así que la voz
    // guardada se re-sincroniza cuando termine de poblarse el select.
    void gvFillPiperVoices().then(gvSyncVoiceUi);
    gvMarkResumable();
  }
  gvInitTts();
  document.addEventListener('astro:page-load', gvInitTts);
  document.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement | null;
    if (target?.id === 'tts-rate') {
      // Cambiar la velocidad no corta el audio: se aplica sobre el elemento en vivo.
      localStorage.setItem(RATE_KEY, target.value);
      gvApplyRate();
      return;
    }
    if (target?.id === 'tts-voice') {
      localStorage.setItem(TTS_KEY, target.value);
      const next = target.value.startsWith(PIPER_PREFIX) ? target.value.slice(PIPER_PREFIX.length) : null;
      const prev = gvCacheKey?.split('|')[0] ?? null;
      // Cambiar de voz corta toda reproducción previa (Piper y navegador): nunca deben
      // sonar dos motores a la vez, y el resaltado del anterior ya no corresponde.
      gvSynthCancel = true;
      gvPiperBusy = false;
      gvStopAll();
      gvClearHighlight();
      if (next && next !== prev) {
        // Los trozos en cache son de la voz anterior: se sueltan para que el resaltado y
        // los saltos no apunten a audio que ya no se está usando.
        gvCacheKey = null;
        gvChunkUrls = [];
        gvChunkEls = [];
        gvIdx = 0;
        gvSynthDone = false;
        gvTtsState = 'idle';
      }
      gvShowTtsControls(false);
      gvUtt(document.getElementById('tts-msg'));
      if (next) gvPreloadPiper(next);
    }
  });
</script>

<style>
  .copy-icon-swap {
    position: relative;
    display: inline-grid;
    width: 1rem;
    height: 1rem;
  }
  .copy-icon-swap > .copy-icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    opacity: 0;
    filter: blur(4px);
    transform: scale(0.25);
    pointer-events: none;
    transition:
      opacity 200ms cubic-bezier(0.2, 0, 0, 1),
      filter 200ms cubic-bezier(0.2, 0, 0, 1),
      transform 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  .copy-icon-swap[data-state='idle'] > [data-icon='idle'],
  .copy-icon-swap[data-state='copied'] > [data-icon='copied'],
  .copy-icon-swap[data-state='error'] > [data-icon='error'] {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .copy-icon-swap > .copy-icon { transition: none; }
  }
</style>

