---
import Base from '../../../layouts/Base.astro';
import EventConnections from '../../../components/EventConnections.astro';
import EventTimelineConnector from '../../../components/EventTimelineConnector.astro';
import EgoGraph from '../../../components/EgoGraph.astro';
import { render } from 'astro:content';
import { getAllEvents, getPeopleMap, getTopicsMap, getOrgsMap, getEventEntities, getCifrasRegistry } from '../../../lib/queries';
import { getEventConnections, buildConnectionIndex } from '../../../lib/relations';
import { resolveReferences } from '../../../lib/registry';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import {
  ArrowLeft,
  Calendar,
  Tag,
  User,
  Building2,
  TrendingUp,
  BookOpen,
  ExternalLink,
  Clock,
  Layers,
  Hash,
  Activity,
  FileText,
  Volume2,
  VolumeX,
  RotateCcw,
  SkipForward,
  Copy,
  Check,
  TriangleAlert,
  Bot,
  Bug,
} from 'lucide-astro';
import { TIPO_LABELS, TIPO_STYLES } from '../../../lib/eventTypes';

export async function getStaticPaths() {
  const events = await getAllEvents();
  return events.map((event) => {
    const filename = event.id.split('/').pop() ?? event.id;
    return {
      params: {
        year: new Date(event.data.fecha).getFullYear().toString(),
        id: filename,
      },
      props: { event },
    };
  });
}

const { event } = Astro.props;
const { titulo, fecha, tipo, tema, etiquetas, impacto, creado, actualizado, svg_backup } = event.data;
const filename = event.id.split('/').pop() ?? event.id;
const { Content } = await render(event);

// URL canónica del evento (origen) para incluirla al copiar.
const eventUrl = new URL(`/events/${new Date(fecha).getFullYear()}/${filename}/`, Astro.site).href;

const dateObj = new Date(fecha);
const fechaStr = dateObj.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const entities = getEventEntities(event.id);
const [peopleMap, topicsMap, orgsMap] = await Promise.all([getPeopleMap(), getTopicsMap(), getOrgsMap()]);

const personaNombres = entities.personas.map((id) => ({ id, nombre: peopleMap.get(id) ?? id }));
const orgNombres = entities.organizaciones.map((id) => ({ id, nombre: orgsMap.get(id) ?? id }));
const temaNombres = tema.map((id) => ({ id, nombre: topicsMap.get(id) ?? id }));

const cifrasRegistry = getCifrasRegistry();
const cifraConceptos = [...new Set(entities.cifras.map((c) => c.concepto))].map((concepto) => ({
  concepto,
  nombre: cifrasRegistry[concepto]?.nombre ?? concepto,
}));

const refs = resolveReferences(entities.fuentesAll);
const allEvents = await getAllEvents();
const connectionIndex = buildConnectionIndex(allEvents);
const connections = connectionIndex.get(filename) ?? { outgoing: [], incoming: [], inferred: [] };

// Export markdown (SSG): base = el archivo .md fuente, más sección de referencias con URLs.
const rawMd = readFileSync(join(process.cwd(), 'src', 'content', 'events', `${event.id}.md`), 'utf8');
const bodyMd = rawMd.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, '').trim();
const refLines = refs
  .map((r, i) => `- [${i + 1}] ${r.titulo}${r.url ? ` — ${r.url}` : ''}${r.medio ? ` (${r.medio}${r.autor ? `, ${r.autor}` : ''})` : ''}`)
  .join('\n');
const exportMd = [
  `# ${titulo}`,
  '',
  `${bodyMd}`,
  '',
  `---`,
  '',
  `**Fuente (Gobierno Vault):** ${eventUrl}`,
  refLines ? `**Referencias:**\n${refLines}` : '',
].join('\n');
// Contexto compacto para IAs: conserva nombres legibles de entidades y un extracto
// acotado del cuerpo. La URL canónica permite verificar el evento en servicios con web.
const aiEntityMaps: Record<string, Map<string, string>> = {
  people: peopleMap,
  organizations: orgsMap,
  topics: topicsMap,
};
function aiExcerpt(markdown: string, maxChars = 650) {
  const plain = markdown
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)]\([^)]*\)/g, '$1')
    .replace(/\[\[(people|organizations|topics|sources|cifras|events)\/([^\]|]+)(?:\|([^\]]+))?\]\]/g,
      (_match: string, kind: string, id: string, label?: string) => {
        if (label) return label;
        if (kind === 'sources') return 'fuente registrada';
        if (kind === 'cifras') {
          const parts = id.split('/');
          return `${parts.at(-2) ?? 'cifra'} ${parts.at(-1) ?? ''}`.trim();
        }
        return aiEntityMaps[kind]?.get(id) ?? id.split('/').at(-1) ?? id;
      },
    )
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^>\s?/gm, '')
    .replace(/[*_`~]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (plain.length <= maxChars) return plain;
  return `${plain.slice(0, maxChars).replace(/\s+\S*$/, '')}…`;
}
const aiTopics = temaNombres.map((t) => t.nombre).join(', ') || 'sin tema asignado';
const aiGuardrails = [
  'Usa Gobierno Vault como contexto de referencia para analizar este evento público. Verifica sus datos con las fuentes y no presentes el extracto como una verdad automática.',
  '',
  'Tarea: explica qué ocurrió, por qué importa y qué aspectos requieren verificación. Distingue hechos documentados de inferencias, responde en español y cita las fuentes disponibles.',
  'Si no puedes abrir la URL, no inventes su contenido: usa únicamente el extracto y las fuentes indicadas.',
];
const aiMetadata = [
  `- Evento: ${titulo}`,
  `- URL canónica: ${eventUrl}`,
  `- Fecha: ${fechaStr}`,
  `- Tipo: ${TIPO_LABELS[tipo] || tipo}`,
  `- Temas: ${aiTopics}`,
];
const aiSourceTitles = refs.slice(0, 2).map((r) => {
  const rawTitle = String(r.titulo ?? 'fuente sin título');
  return rawTitle.length > 100 ? `${rawTitle.slice(0, 99)}…` : rawTitle;
}).join('; ');
const aiSourceSummary = refs.length
  ? `${refs.length} ${refs.length === 1 ? 'fuente registrada' : 'fuentes registradas'}: ${aiSourceTitles}. Las URLs completas están en la página canónica.`
  : 'No hay fuentes registradas.';
const chatPrompt = [
  ...aiGuardrails,
  '',
  ...aiMetadata,
  '',
  'Extracto del evento:',
  aiExcerpt(bodyMd) || '(sin texto disponible)',
  '',
  'Fuentes registradas en Gobierno Vault:',
  refLines || '(sin fuentes registradas)',
].join('\n');
function aiPrefill(text: string, maxChars = 1400) {
  if (text.length <= maxChars) return text;
  return `${text.slice(0, maxChars - 1).replace(/\s+\S*$/, '')}…`;
}
const chatPrefill = aiPrefill([
  ...aiGuardrails,
  '',
  ...aiMetadata,
  '',
  `Fuentes: ${aiSourceSummary}`,
  'Extracto del evento:',
  aiExcerpt(bodyMd, 500) || '(sin texto disponible)',
].join('\n'));
// Los href SSR llevan solo un fallback corto con la URL del evento. El click
// inyecta el prompt compacto guardado una sola vez en data-ai-prefill.
const encodedAiFallbackPrompt = encodeURIComponent(`Consulta y analiza este evento público de Gobierno Vault: ${eventUrl}`);
const aiTargets: Array<{ id: string; label: string; url: string; title: string; noLogin?: boolean; accountRequired?: boolean }> = [
  {
    id: 'chatgpt',
    label: 'ChatGPT',
    url: `https://chatgpt.com/?q=${encodedAiFallbackPrompt}`,
    title: 'Abrir ChatGPT con el contexto. Funciona sin cuenta; el registro es opcional para guardar el historial.',
    noLogin: true,
  },
  {
    id: 'claude',
    label: 'Claude',
    url: `https://claude.ai/new?q=${encodedAiFallbackPrompt}`,
    title: 'Abrir Claude con el contexto de Gobierno Vault. Requiere una cuenta de Claude.',
    accountRequired: true,
  },
  {
    id: 'perplexity',
    label: 'Perplexity',
    url: `https://www.perplexity.ai/search?q=${encodedAiFallbackPrompt}`,
    title: 'Abrir Perplexity con el contexto. La consulta inicial funciona sin cuenta; el registro es opcional para guardar el historial.',
    noLogin: true,
  },
  {
    id: 'duck',
    label: 'Duck.ai',
    url: `https://duck.ai/?q=${encodedAiFallbackPrompt}`,
    title: 'Abrir Duck.ai con el contexto. Funciona sin cuenta; DuckDuckGo anonimiza los metadatos de la solicitud.',
    noLogin: true,
  },
];
const aiActionClass = 'inline-flex items-center gap-1.5 whitespace-nowrap rounded-md border border-success/25 bg-base-100/70 px-2.5 py-1.5 text-xs font-medium text-success transition-colors hover:bg-success/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-success/40';
// Reportar error: abre un issue de GitHub pre-rellenado con el evento y su URL.
const reportUrl = `https://github.com/Alplox/gobierno-vault/issues/new?title=${encodeURIComponent(`[Evento] ${titulo}`)}&body=${encodeURIComponent(`Evento: ${eventUrl}

Describe el error o la corrección sugerida.`)}`;
---

<Base title={titulo}>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8 bg-base-100 p-6 sm:p-8 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-4">
        <a href="/events" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary bg-primary/10 px-2.5 py-1 rounded-lg transition-colors">
          <ArrowLeft class="h-3.5 w-3.5" />
          <span>Volver a Eventos</span>
        </a>
      </div>
      <h1 transition:name={`event-title-${filename}`} class="text-2xl sm:text-3xl font-bold text-base-content mb-4 leading-tight text-balance">{titulo}</h1>
      <div class="flex flex-wrap items-center gap-3 text-xs text-base-content/70">
        <span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold ring-1 ring-inset ${TIPO_STYLES[tipo] || 'bg-base-200 text-base-content/80 ring-base-300'}`}>
          <FileText class="h-3.5 w-3.5 shrink-0" />
          {TIPO_LABELS[tipo] || tipo}
        </span>
        <time class="inline-flex items-center gap-1.5 text-base-content/60 font-medium bg-base-200 px-2.5 py-1 rounded-md border border-base-300/60">
          <Calendar class="h-3.5 w-3.5 text-base-content/40 shrink-0" />
          {fechaStr}
        </time>
      </div>
    </header>

    <div class="mb-5 flex flex-wrap items-center gap-2.5 not-prose">
      <button id="btn-tts" type="button" class="inline-flex items-center gap-1.5 text-xs font-semibold text-base-content/80 bg-base-200 hover:bg-base-300 px-3 py-1.5 rounded-lg transition-[color,background-color,box-shadow] duration-150 min-w-[9rem] justify-center">
        <Volume2 data-tts-icon="idle" class="h-4 w-4" />
        <VolumeX data-tts-icon="playing" class="h-4 w-4 hidden" />
        <span data-tts-label>Escuchar</span>
      </button>
      {/* Controles de salto Piper: ocultos hasta que haya audio sintetizado */}
      <button id="btn-tts-restart" type="button" class="hidden items-center p-2 text-base-content/70 bg-base-200 hover:bg-base-300 rounded-lg transition-colors" title="Reiniciar desde el inicio" aria-label="Reiniciar desde el inicio">
        <RotateCcw class="h-4 w-4" />
      </button>
      <button id="btn-tts-next" type="button" class="hidden items-center p-2 text-base-content/70 bg-base-200 hover:bg-base-300 rounded-lg transition-colors" title="Siguiente parrafo" aria-label="Siguiente parrafo">
        <SkipForward class="h-4 w-4" />
      </button>
      <label class="inline-flex items-center gap-1.5 text-xs font-medium text-base-content/60">
        Voz
        <select id="tts-voice" class="text-xs border border-base-300/70 rounded-lg bg-base-100 px-2 py-1.5 text-base-content/80 focus:outline-none focus:ring-1 focus:ring-primary max-w-[16rem]"></select>
      </label>
      <span id="tts-msg" class="text-[11px] text-base-content/40 font-medium" role="status"></span>
    </div>

    <section class="prose prose-gray max-w-none mb-10 bg-base-100 p-6 sm:p-8 rounded-2xl border-0 shadow-[var(--shadow-border)] leading-relaxed text-base-content">
      <Content />

      {(svg_backup?.archivo || svg_backup?.svg) && (
        <figure class="not-prose my-8 rounded-xl border border-base-300 bg-base-200/60 p-4 sm:p-6">
          <div class="mb-3 flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-warning bg-warning/15 border border-warning/40 px-2.5 py-1 rounded-md">
              <FileText class="h-3.5 w-3.5 shrink-0" />
              Respaldo ASCII de la imagen
            </span>
          </div>
          <div class="overflow-x-auto rounded-lg bg-base-100 border border-base-300/60 p-3 sm:p-4">
            {svg_backup.archivo ? (
              <img src={svg_backup.archivo} alt={`Respaldo ASCII de la imagen del evento${svg_backup.fuente ? ` (fuente: ${svg_backup.fuente})` : ''}`} class="ascii-svg-img mx-auto max-w-full h-auto rounded-lg" loading="lazy" />
            ) : (
              <div class="ascii-svg mx-auto" set:html={svg_backup.svg} />
            )}
          </div>
          <figcaption class="mt-3 text-xs text-base-content/60 leading-relaxed">
            Representación en arte ASCII de la imagen del evento, generada con una herramienta web externa
            {svg_backup.fuente ? (
              <> y guardada como respaldo verificable visualmente. Fuente de la imagen:{' '}
                <a href={svg_backup.fuente} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-medium text-primary hover:text-primary hover:underline">
                  <span class="break-all">{svg_backup.fuente}</span>
                  <ExternalLink class="h-3 w-3 shrink-0 text-primary" />
                </a>
              </>
            ) : (
              <> y guardada como respaldo verificable visualmente. La imagen original se referencia en las fuentes del evento.</>
            )}
          </figcaption>
        </figure>
      )}

      <div class="mt-10 pt-5 border-t border-base-300/70 flex flex-wrap items-center gap-2.5 not-prose">
        <div class="inline-flex min-h-9 items-stretch overflow-hidden rounded-lg border border-primary/20 bg-primary/10 text-primary shadow-xs" role="group" aria-label="Acciones de Markdown">
          <a href={`/events/${new Date(fecha).getFullYear()}/${filename}.md`} class="inline-flex min-h-9 items-center gap-1.5 px-3 py-1.5 text-xs font-semibold transition-colors hover:bg-primary/10 focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary">
            <FileText class="h-4 w-4 shrink-0" />
            <span>Ver en Markdown</span>
          </a>
          <button
            id="btn-copy-md"
            type="button"
            class="inline-flex size-9 shrink-0 items-center justify-center border-l border-primary/20 transition-[color,background-color,scale] duration-150 hover:bg-primary/10 focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary active:scale-[0.96]"
            aria-label="Copiar Markdown"
            title="Copiar Markdown al portapapeles"
            data-copy-success-message="Markdown copiado al portapapeles."
            data-copy-error-message="No se pudo copiar Markdown."
          >
            <span class="copy-icon-swap" data-copy-swap data-state="idle" aria-hidden="true">
              <span class="copy-icon" data-icon="idle"><Copy class="h-4 w-4 shrink-0" /></span>
              <span class="copy-icon" data-icon="copied"><Check class="h-4 w-4 shrink-0" /></span>
              <span class="copy-icon" data-icon="error"><TriangleAlert class="h-4 w-4 shrink-0" /></span>
            </span>
          </button>
          <span data-copy-status class="sr-only" role="status" aria-live="polite" aria-atomic="true"></span>
        </div>
        <!-- Consultas IA: el prefill incluye contexto; el botón conserva la versión completa. -->
        <div class="flex w-full flex-col gap-2 rounded-xl border border-success/30 bg-success/10 p-2 sm:w-auto sm:flex-row sm:items-center" role="group" aria-label="Consultar este evento con una IA usando el contexto de Gobierno Vault">
          <span class="inline-flex shrink-0 flex-col gap-0.5 px-1 text-xs font-semibold text-success sm:border-r sm:border-success/25 sm:pr-3">
            <span class="inline-flex items-center gap-1.5">
              <Bot class="h-4 w-4 shrink-0" />
              <span>Consultar con IA</span>
            </span>
            <span class="text-[10px] font-medium text-base-content/65">Contexto: Gobierno Vault</span>
          </span>
          <div class="flex flex-wrap items-center gap-1.5">
            {aiTargets.map((target) => (
              <a
                id={`btn-ai-${target.id}`}
                href={target.url}
                target="_blank"
                rel="noopener noreferrer"
                data-ai-prefill
                class={aiActionClass}
                title={target.title}
                aria-label={`Abrir ${target.label} con el contexto de Gobierno Vault${target.noLogin ? ', sin cuenta' : target.accountRequired ? ', requiere cuenta' : ''}`}
              >
                <span>{target.label}</span>
                {target.noLogin && (
                  <span class="rounded-full bg-base-200 px-1.5 py-0.5 text-[10px] font-medium text-base-content/60">sin cuenta</span>
                )}
                {target.accountRequired && (
                  <span class="rounded-full bg-base-200 px-1.5 py-0.5 text-[10px] font-medium text-base-content/60">requiere cuenta</span>
                )}
              </a>
            ))}
            <button
              id="btn-copy-prompt"
              type="button"
              data-copy-prompt
              class={`${aiActionClass} transition-[color,background-color,border-color,scale] duration-150 active:scale-[0.96]`}
              title="Copiar el contexto completo, incluidas las fuentes, para pegarlo en cualquier IA"
              data-copy-success-message="Prompt completo copiado al portapapeles."
              data-copy-error-message="No se pudo copiar el prompt."
            >
              <span class="copy-icon-swap" data-copy-swap data-state="idle" aria-hidden="true">
                <span class="copy-icon" data-icon="idle"><Copy class="h-3.5 w-3.5 shrink-0" /></span>
                <span class="copy-icon" data-icon="copied"><Check class="h-3.5 w-3.5 shrink-0" /></span>
                <span class="copy-icon" data-icon="error"><TriangleAlert class="h-3.5 w-3.5 shrink-0" /></span>
              </span>
              <span data-copy-label>Copiar prompt</span>
            </button>
            <span data-copy-status class="sr-only" role="status" aria-live="polite" aria-atomic="true"></span>
          </div>
        </div>
        <a href={reportUrl} target="_blank" rel="noopener"
           class="inline-flex items-center gap-1.5 text-xs font-semibold text-warning bg-warning/15 hover:bg-warning/20 px-3 py-1.5 rounded-lg transition-colors"
           title="Abrir un issue de GitHub para reportar un error o sugerir una corrección en este evento">
          <Bug class="h-4 w-4 shrink-0" />
          <span>Reportar error</span>
        </a>
      </div>
    </section>

    <div id="event-export-data" class="hidden" data-md={exportMd} data-prompt={chatPrompt} data-ai-prefill={chatPrefill} aria-hidden="true"></div>

    {impacto && (impacto.colectivos?.length > 0 || impacto.sectores?.length > 0) && (
      <section class="mb-8 bg-warning/10 border border-warning/40 rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-3">
          <Activity class="h-5 w-5 text-warning shrink-0" />
          <h2 class="text-base font-bold text-base-content">Impacto y Alcance</h2>
        </div>
        <div class="space-y-3 text-sm">
          {impacto.colectivos?.length > 0 && (
            <div>
              <span class="font-semibold text-base-content">Colectivos afectados: </span>
              <span class="text-base-content/70">{impacto.colectivos.join(', ')}</span>
            </div>
          )}
          {impacto.sectores?.length > 0 && (
            <div>
              <span class="font-semibold text-base-content">Sectores involucrados: </span>
              <span class="text-base-content/70">{impacto.sectores.join(', ')}</span>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border-0 shadow-[var(--shadow-border)]">
      <div class="flex items-center gap-2 mb-4">
        <Tag class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-base font-bold text-base-content">Entidades y Etiquetas</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
        <div>
          <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">
            <Layers class="h-3.5 w-3.5 text-base-content/40" />
            Temas
          </h3>
          <div class="flex gap-1.5 flex-wrap">
            {temaNombres.map((t) => (
              <a href={`/topics/${t.id}`} transition:name={`topic-title-${t.id}`} class="inline-flex items-center gap-1 text-xs bg-base-200 hover:bg-base-300 text-base-content/80 font-medium px-2.5 py-1 rounded-lg transition-colors">
                <Tag class="h-3 w-3 text-base-content/40" />
                {t.nombre}
              </a>
            ))}
          </div>
        </div>

        {personaNombres.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">
              <User class="h-3.5 w-3.5 text-base-content/40" />
              Personas
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {personaNombres.map((p) => (
                <a href={`/people/${p.id}`} transition:name={`person-title-${p.id}`} class="inline-flex items-center gap-1 text-xs bg-base-200 hover:bg-base-300 text-base-content/80 font-medium px-2.5 py-1 rounded-lg transition-colors">
                  <User class="h-3 w-3 text-base-content/40" />
                  {p.nombre}
                </a>
              ))}
            </div>
          </div>
        )}

        {orgNombres.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">
              <Building2 class="h-3.5 w-3.5 text-base-content/40" />
              Organizaciones
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {orgNombres.map((o) => (
                <a href={`/organizations/${o.id}`} transition:name={`org-title-${o.id}`} class="inline-flex items-center gap-1 text-xs bg-base-200 hover:bg-base-300 text-base-content/80 font-medium px-2.5 py-1 rounded-lg transition-colors">
                  <Building2 class="h-3 w-3 text-base-content/40" />
                  {o.nombre}
                </a>
              ))}
            </div>
          </div>
        )}

        {cifraConceptos.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">
              <TrendingUp class="h-3.5 w-3.5 text-primary" />
              Cifras Destacadas
            </h3>
