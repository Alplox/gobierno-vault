---
import Base from '../../../layouts/Base.astro';
import EventConnections from '../../../components/EventConnections.astro';
import EventTimelineConnector from '../../../components/EventTimelineConnector.astro';
import EgoGraph from '../../../components/EgoGraph.astro';
import { render } from 'astro:content';
import { getAllEvents, getPeopleMap, getTopicsMap, getOrgsMap, getEventEntities, getCifrasRegistry } from '../../../lib/queries';
import { getEventConnections, buildConnectionIndex } from '../../../lib/relations';
import { resolveReferences } from '../../../lib/registry';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import {
  ArrowLeft,
  Calendar,
  Tag,
  User,
  Building2,
  TrendingUp,
  BookOpen,
  ExternalLink,
  Clock,
  Layers,
  Hash,
  Activity,
  FileText,
  Volume2,
  VolumeX,
  RotateCcw,
  SkipForward,
  Copy,
  Bot,
  Bug,
} from 'lucide-astro';
import { TIPO_LABELS, TIPO_STYLES } from '../../../lib/eventTypes';

export async function getStaticPaths() {
  const events = await getAllEvents();
  return events.map((event) => {
    const filename = event.id.split('/').pop() ?? event.id;
    return {
      params: {
        year: new Date(event.data.fecha).getFullYear().toString(),
        id: filename,
      },
      props: { event },
    };
  });
}

const { event } = Astro.props;
const { titulo, fecha, tipo, tema, etiquetas, impacto, creado, actualizado, svg_backup } = event.data;
const filename = event.id.split('/').pop() ?? event.id;
const { Content } = await render(event);

// URL canónica del evento (origen) para incluirla al copiar.
const eventUrl = new URL(`/events/${new Date(fecha).getFullYear()}/${filename}/`, Astro.site).href;

const dateObj = new Date(fecha);
const fechaStr = dateObj.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const entities = getEventEntities(event.id);
const [peopleMap, topicsMap, orgsMap] = await Promise.all([getPeopleMap(), getTopicsMap(), getOrgsMap()]);

const personaNombres = entities.personas.map((id) => ({ id, nombre: peopleMap.get(id) ?? id }));
const orgNombres = entities.organizaciones.map((id) => ({ id, nombre: orgsMap.get(id) ?? id }));
const temaNombres = tema.map((id) => ({ id, nombre: topicsMap.get(id) ?? id }));

const cifrasRegistry = getCifrasRegistry();
const cifraConceptos = [...new Set(entities.cifras.map((c) => c.concepto))].map((concepto) => ({
  concepto,
  nombre: cifrasRegistry[concepto]?.nombre ?? concepto,
}));

const refs = resolveReferences(entities.fuentesAll);
const allEvents = await getAllEvents();
const connectionIndex = buildConnectionIndex(allEvents);
const connections = connectionIndex.get(filename) ?? { outgoing: [], incoming: [], inferred: [] };

// Export markdown (SSG): base = el archivo .md fuente, más sección de referencias con URLs.
const rawMd = readFileSync(join(process.cwd(), 'src', 'content', 'events', `${event.id}.md`), 'utf8');
const bodyMd = rawMd.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, '').trim();
const refLines = refs
  .map((r, i) => `- [${i + 1}] ${r.titulo}${r.url ? ` — ${r.url}` : ''}${r.medio ? ` (${r.medio}${r.autor ? `, ${r.autor}` : ''})` : ''}`)
  .join('\n');
const exportMd = [
  `# ${titulo}`,
  '',
  `${bodyMd}`,
  '',
  `---`,
  '',
  `**Fuente (Gobierno Vault):** ${eventUrl}`,
  refLines ? `**Referencias:**\n${refLines}` : '',
].join('\n');
// Prompt para IAs: título en su propio párrafo (línea en blanco antes y después),
// fuentes como lista debajo - evita que el título quede pegado a las fuentes.
const chatPrompt = `Analiza y contextualiza este evento y propón fuentes o datos adicionales que lo confirmen o contradigan.

Título: ${titulo}

## Fuentes conocidas:
${refLines || '(sin fuentes registradas)'}`;
// Best-effort: el prefill vía URL corta los mensajes largos, así que se envía un
// prompt corto; el botón "Copiar prompt" deja el prompt completo para pegar.
const chatPrefill = chatPrompt.slice(0, 1500);
const chatGptUrl = `https://chatgpt.com/?q=${encodeURIComponent(chatPrefill)}`;
const claudeUrl = `https://claude.ai/new?q=${encodeURIComponent(chatPrefill)}`;
// Reportar error: abre un issue de GitHub pre-rellenado con el evento y su URL.
const reportUrl = `https://github.com/Alplox/gobierno-vault/issues/new?title=${encodeURIComponent(`[Evento] ${titulo}`)}&body=${encodeURIComponent(`Evento: ${eventUrl}

Describe el error o la corrección sugerida.`)}`;
---

<Base title={titulo}>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8 bg-base-100 p-6 sm:p-8 rounded-2xl border border-base-300 shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <a href="/events" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary bg-primary/10 px-2.5 py-1 rounded-lg transition-colors">
          <ArrowLeft class="h-3.5 w-3.5" />
          <span>Volver a Eventos</span>
        </a>
      </div>
      <h1 transition:name={`event-title-${filename}`} class="text-2xl sm:text-3xl font-bold text-base-content mb-4 leading-tight text-balance">{titulo}</h1>
      <div class="flex flex-wrap items-center gap-3 text-xs text-base-content/70">
        <span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold ring-1 ring-inset ${TIPO_STYLES[tipo] || 'bg-base-200 text-base-content/80 ring-base-300'}`}>
          <FileText class="h-3.5 w-3.5 shrink-0" />
          {TIPO_LABELS[tipo] || tipo}
        </span>
        <time class="inline-flex items-center gap-1.5 text-base-content/60 font-medium bg-base-200 px-2.5 py-1 rounded-md border border-base-300/60">
          <Calendar class="h-3.5 w-3.5 text-base-content/40 shrink-0" />
          {fechaStr}
        </time>
      </div>
    </header>

    <div class="mb-5 flex flex-wrap items-center gap-2.5 not-prose">
      <button id="btn-tts" type="button" class="inline-flex items-center gap-1.5 text-xs font-semibold text-base-content/80 bg-base-200 hover:bg-base-300 px-3 py-1.5 rounded-lg transition-colors min-w-[9rem] justify-center">
        <Volume2 data-tts-icon="idle" class="h-4 w-4" />
        <VolumeX data-tts-icon="playing" class="h-4 w-4 hidden" />
        <span data-tts-label>Escuchar</span>
      </button>
      {/* Controles de salto Piper: ocultos hasta que haya audio sintetizado */}
      <button id="btn-tts-restart" type="button" class="hidden items-center p-2 text-base-content/70 bg-base-200 hover:bg-base-300 rounded-lg transition-colors" title="Reiniciar desde el inicio" aria-label="Reiniciar desde el inicio">
        <RotateCcw class="h-4 w-4" />
      </button>
      <button id="btn-tts-next" type="button" class="hidden items-center p-2 text-base-content/70 bg-base-200 hover:bg-base-300 rounded-lg transition-colors" title="Siguiente parrafo" aria-label="Siguiente parrafo">
        <SkipForward class="h-4 w-4" />
      </button>
      <label class="inline-flex items-center gap-1.5 text-xs font-medium text-base-content/60">
        Voz
        <select id="tts-voice" class="text-xs border border-base-300/70 rounded-lg bg-base-100 px-2 py-1.5 text-base-content/80 focus:outline-none focus:ring-1 focus:ring-primary max-w-[16rem]"></select>
      </label>
      <span id="tts-msg" class="text-[11px] text-base-content/40 font-medium" role="status"></span>
    </div>

    <section class="prose prose-gray max-w-none mb-10 bg-base-100 p-6 sm:p-8 rounded-2xl border border-base-300 shadow-sm leading-relaxed text-base-content">
      <Content />

      {(svg_backup?.archivo || svg_backup?.svg) && (
        <figure class="not-prose my-8 rounded-xl border border-base-300 bg-base-200/60 p-4 sm:p-6">
          <div class="mb-3 flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-warning bg-warning/15 border border-warning/40 px-2.5 py-1 rounded-md">
              <FileText class="h-3.5 w-3.5 shrink-0" />
              Respaldo ASCII de la imagen
            </span>
          </div>
          <div class="overflow-x-auto rounded-lg bg-base-100 border border-base-300/60 p-3 sm:p-4">
            {svg_backup.archivo ? (
              <img src={svg_backup.archivo} alt={`Respaldo ASCII de la imagen del evento${svg_backup.fuente ? ` (fuente: ${svg_backup.fuente})` : ''}`} class="ascii-svg-img mx-auto max-w-full h-auto" loading="lazy" />
            ) : (
              <div class="ascii-svg mx-auto" set:html={svg_backup.svg} />
            )}
          </div>
          <figcaption class="mt-3 text-xs text-base-content/60 leading-relaxed">
            Representación en arte ASCII de la imagen del evento, generada con una herramienta web externa
            {svg_backup.fuente ? (
              <> y guardada como respaldo verificable visualmente. Fuente de la imagen:{' '}
                <a href={svg_backup.fuente} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-medium text-primary hover:text-primary hover:underline">
                  <span class="break-all">{svg_backup.fuente}</span>
                  <ExternalLink class="h-3 w-3 shrink-0 text-primary" />
                </a>
              </>
            ) : (
              <> y guardada como respaldo verificable visualmente. La imagen original se referencia en las fuentes del evento.</>
            )}
          </figcaption>
        </figure>
      )}

      <div class="mt-10 pt-5 border-t border-base-300/70 flex flex-wrap items-center gap-2.5 not-prose">
        <a href={`/events/${new Date(fecha).getFullYear()}/${filename}.md`} class="inline-flex items-center gap-1.5 text-xs font-semibold text-base-content/80 bg-base-200 hover:bg-base-300 px-3 py-1.5 rounded-lg transition-colors">
          <FileText class="h-4 w-4 shrink-0" />
          <span>Ver en Markdown</span>
        </a>
        <button id="btn-copy-md" type="button" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary bg-primary/10 hover:bg-primary/15 px-3 py-1.5 rounded-lg transition-colors">
          <Copy class="h-4 w-4 shrink-0" />
          <span data-copy-label>Copiar como Markdown</span>
        </button>
        <!-- Button group: preguntar a una IA + copiar prompt completo -->
        <div class="inline-flex flex-wrap items-center rounded-lg border border-success/30 bg-success/10 overflow-hidden" role="group" aria-label="Preguntar a una IA sobre este evento">
          <span class="inline-flex items-center gap-1.5 pl-3 pr-2 py-1.5 text-xs font-semibold text-emerald-700">
            <Bot class="h-4 w-4 shrink-0" />
            <span>Preguntar a</span>
          </span>
          <a id="btn-ai-chatgpt" href={chatGptUrl} target="_blank" rel="noopener" data-ai-copy
             class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold text-success hover:bg-success/15 transition-colors border-l border-success/30"
             title="Abrir ChatGPT con el evento como prompt">ChatGPT</a>
          <a id="btn-ai-claude" href={claudeUrl} target="_blank" rel="noopener" data-ai-copy
             class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold text-success hover:bg-success/15 transition-colors border-l border-success/30"
             title="Abrir Claude con el evento como prompt">Claude</a>
          <button id="btn-copy-prompt" type="button" data-copy-prompt
                  class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold text-success hover:bg-success/15 transition-colors border-l border-success/30"
                  title="Copiar el prompt completo para pegarlo en cualquier IA">
            <Copy class="h-3.5 w-3.5 shrink-0" />
            <span data-copy-label>Copiar prompt</span>
          </button>
        </div>
        <a href={reportUrl} target="_blank" rel="noopener"
           class="inline-flex items-center gap-1.5 text-xs font-semibold text-warning bg-warning/15 hover:bg-warning/20 px-3 py-1.5 rounded-lg transition-colors"
           title="Abrir un issue de GitHub para reportar un error o sugerir una corrección en este evento">
          <Bug class="h-4 w-4 shrink-0" />
          <span>Reportar error</span>
        </a>
      </div>
    </section>

    <div id="event-export-data" class="hidden" data-md={exportMd} data-prompt={chatPrompt} aria-hidden="true"></div>

    {impacto && (impacto.colectivos?.length > 0 || impacto.sectores?.length > 0) && (
      <section class="mb-8 bg-warning/10 border border-warning/40 rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-3">
          <Activity class="h-5 w-5 text-warning shrink-0" />
          <h2 class="text-base font-bold text-base-content">Impacto y Alcance</h2>
        </div>
        <div class="space-y-3 text-sm">
          {impacto.colectivos?.length > 0 && (
            <div>
              <span class="font-semibold text-base-content">Colectivos afectados: </span>
              <span class="text-base-content/70">{impacto.colectivos.join(', ')}</span>
            </div>
          )}
          {impacto.sectores?.length > 0 && (
            <div>
              <span class="font-semibold text-base-content">Sectores involucrados: </span>
              <span class="text-base-content/70">{impacto.sectores.join(', ')}</span>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="mb-10 bg-base-100 p-6 rounded-2xl border border-base-300 shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <Tag class="h-5 w-5 text-primary shrink-0" />
        <h2 class="text-base font-bold text-base-content">Entidades y Etiquetas</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
        <div>
          <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">
            <Layers class="h-3.5 w-3.5 text-base-content/40" />
            Temas
          </h3>
          <div class="flex gap-1.5 flex-wrap">
            {temaNombres.map((t) => (
              <a href={`/topics/${t.id}`} transition:name={`topic-title-${t.id}`} class="inline-flex items-center gap-1 text-xs bg-base-200 hover:bg-base-300 text-base-content/80 font-medium px-2.5 py-1 rounded-lg transition-colors">
                <Tag class="h-3 w-3 text-base-content/40" />
                {t.nombre}
              </a>
            ))}
          </div>
        </div>

        {personaNombres.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">
              <User class="h-3.5 w-3.5 text-base-content/40" />
              Personas
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {personaNombres.map((p) => (
                <a href={`/people/${p.id}`} transition:name={`person-title-${p.id}`} class="inline-flex items-center gap-1 text-xs bg-base-200 hover:bg-base-300 text-base-content/80 font-medium px-2.5 py-1 rounded-lg transition-colors">
                  <User class="h-3 w-3 text-base-content/40" />
                  {p.nombre}
                </a>
              ))}
            </div>
          </div>
        )}

        {orgNombres.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">
              <Building2 class="h-3.5 w-3.5 text-base-content/40" />
              Organizaciones
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {orgNombres.map((o) => (
                <a href={`/organizations/${o.id}`} transition:name={`org-title-${o.id}`} class="inline-flex items-center gap-1 text-xs bg-base-200 hover:bg-base-300 text-base-content/80 font-medium px-2.5 py-1 rounded-lg transition-colors">
                  <Building2 class="h-3 w-3 text-base-content/40" />
                  {o.nombre}
                </a>
              ))}
            </div>
          </div>
        )}

        {cifraConceptos.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">
              <TrendingUp class="h-3.5 w-3.5 text-primary" />
              Cifras Destacadas
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {cifraConceptos.map((c) => (
                <a href={`/stats/${c.concepto}`} class="inline-flex items-center gap-1 text-xs bg-primary/10 hover:bg-primary/15 text-primary font-medium px-2.5 py-1 rounded-lg transition-colors border border-primary/30/60">
                  <TrendingUp class="h-3 w-3 text-primary" />
                  {c.nombre}
                </a>
              ))}
            </div>
          </div>
        )}

        {etiquetas.length > 0 && (
          <div>
            <h3 class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">
              <Hash class="h-3.5 w-3.5 text-base-content/40" />
              Etiquetas libres
            </h3>
            <div class="flex gap-1.5 flex-wrap">
              {etiquetas.map((e) => (
                <span class="inline-flex items-center text-xs bg-base-200/70 text-base-content/70 px-2 py-0.5 rounded-md font-mono">
                  #{e}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <EventTimelineConnector connections={connections} eventFecha={event.data.fecha} />

    <EventConnections connections={connections} topicsMap={topicsMap}>
      <EgoGraph event={event} connections={connections} slot="graph" />
    </EventConnections>

    {refs.length > 0 && (
      <section class="mb-10 bg-base-100 p-6 rounded-2xl border border-base-300 shadow-sm">
        <div class="flex items-center gap-2 mb-4">
          <BookOpen class="h-5 w-5 text-primary shrink-0" />
          <h2 class="text-base font-bold text-base-content">Referencias y Fuentes ({refs.length})</h2>
        </div>
        <ol class="space-y-3 text-sm">
          {refs.map((ref, i) => (
            <li id={`ref-${i + 1}`} class="flex items-start gap-2.5 text-base-content/80 scroll-mt-20 p-2.5 rounded-lg hover:bg-base-200 transition-colors border border-transparent hover:border-base-300/60">
              <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-primary/15 text-primary font-mono text-xs shrink-0 font-semibold mt-0.5">
                {i + 1}
              </span>
              <div class="min-w-0 flex-1">
                {ref.url ? (
                  <a href={ref.url} class="inline-flex items-center gap-1 font-semibold text-primary hover:text-primary hover:underline" target="_blank" rel="noopener">
                    <span>{ref.titulo}</span>
                    <ExternalLink class="h-3.5 w-3.5 shrink-0 text-primary" />
                  </a>
                ) : (
                  <span class="font-semibold text-base-content">{ref.titulo}</span>
                )}
                {ref.url && (
                  <span class="flex flex-wrap items-center gap-x-1.5 gap-y-1 mt-1">
                    <a href={`https://web.archive.org/web/${ref.url}`} class="text-[10px] font-medium text-base-content/40 hover:text-primary transition-colors" target="_blank" rel="noopener" title="Wayback Machine">Archive</a>
                    <a href={`https://archive.ph/${ref.url}`} class="text-[10px] font-medium text-base-content/40 hover:text-orange-500 transition-colors" target="_blank" rel="noopener" title="archive.ph">archive.ph</a>
                    <a href={`https://ghostarchive.org/search?term=${encodeURIComponent(ref.url)}`} class="text-[10px] font-medium text-base-content/40 hover:text-purple-500 transition-colors" target="_blank" rel="noopener" title="Ghostarchive">Ghost</a>
                    <a href={`https://timetravel.mementoweb.org/memento/${ref.url}`} class="text-[10px] font-medium text-base-content/40 hover:text-teal-500 transition-colors" target="_blank" rel="noopener" title="Memento Time Travel">Memento</a>
                    <a href={`https://r.jina.ai/${ref.url}`} class="text-[10px] font-medium text-base-content/40 hover:text-green-500 transition-colors" target="_blank" rel="noopener" title="Versión Texto Limpio">Reader</a>
                    <a href={`https://www.paywallskip.com/article?url=${encodeURIComponent(ref.url)}`} class="text-[10px] font-medium text-base-content/40 hover:text-warning transition-colors" target="_blank" rel="noopener" title="Paywall Skip">Paywall</a>
                    <a href={`https://defuddle.md/${ref.url}`} class="text-[10px] font-medium text-base-content/40 hover:text-indigo-500 transition-colors" target="_blank" rel="noopener" title="Defuddle">Defuddle</a>
                    <a href={`https://markdown.new/${ref.url}`} class="text-[10px] font-medium text-base-content/40 hover:text-pink-500 transition-colors" target="_blank" rel="noopener" title="Markdown">MD</a>
                  </span>
                )}
                <p class="text-xs text-base-content/60 mt-0.5">
                  Medio: <span class="font-medium text-base-content/80">{ref.medio}</span> {ref.autor ? `· Autor: ${ref.autor}` : ''}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <footer class="flex items-center gap-2 text-xs text-base-content/40 border-t border-base-300/60 pt-4">
      <Clock class="h-3.5 w-3.5 text-base-content/40" />
      <span>Creado: {creado.toLocaleDateString('es-ES')} · Actualizado: {actualizado.toLocaleDateString('es-ES')}</span>
    </footer>
  </article>
</Base>

<script>
  // TTS (con selector de voz: navegador + Piper neural) + copiar markdown + ChatGPT.
  import * as tts from '@realtimex/piper-tts-web';
  import { play } from 'cuelume';
  const PIPER_PREFIX = 'piper:';
  let gvPiperAudio: HTMLAudioElement | null = null;
  let gvPiperUrl: string | null = null;
  // Clave (voz|texto) del blob actualmente cacheado. El audio vive a nivel de
  // módulo (window persiste entre navegaciones View Transitions): Detener pausa
  // en vez de destruir, y volver a la página retoma desde el mismo segundo sin
  // resintetizar. Eviction LRU de 1 entrada al sintetizar otro texto/voz.
  let gvCacheKey: string | null = null;
  // Segundo de inicio de cada trozo sintetizado dentro del WAV cacheado, y el
  // elemento DOM que le corresponde (mismo índice) para resaltar lo leído.
  let gvBounds: number[] = [];
  let gvChunkEls: (Element | null)[] = [];
  let gvActiveIdx = -1;
  function gvShowTtsControls(show: boolean) {
    for (const id of ['btn-tts-restart', 'btn-tts-next']) {
      const el = document.getElementById(id);
      if (!el) continue;
      el.classList.toggle('hidden', !show);
      el.classList.toggle('inline-flex', show);
    }
  }
  function gvClearHighlight() {
    document.querySelector('.gv-tts-active')?.classList.remove('gv-tts-active');
    gvActiveIdx = -1;
  }
  // Sincroniza el resaltado con la posición de reproducción: busca el trozo
  // activo por gvBounds y mueve la clase .gv-tts-active a su bloque.
  function gvSyncHighlight() {
