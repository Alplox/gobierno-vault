<script>
  // TTS (con selector de voz: navegador + Piper neural) + copiar markdown + ChatGPT.
  import * as tts from '@realtimex/piper-tts-web';
  import { play } from 'cuelume';
  const PIPER_PREFIX = 'piper:';
  let gvPiperAudio: HTMLAudioElement | null = null;
  let gvPiperUrl: string | null = null;
  // Clave (voz|texto) del blob actualmente cacheado. El audio vive a nivel de
  // módulo (window persiste entre navegaciones View Transitions): Detener pausa
  // en vez de destruir, y volver a la página retoma desde el mismo segundo sin
  // resintetizar. Eviction LRU de 1 entrada al sintetizar otro texto/voz.
  let gvCacheKey: string | null = null;
  // Segundo de inicio de cada trozo sintetizado dentro del WAV cacheado, y el
  // elemento DOM que le corresponde (mismo índice) para resaltar lo leído.
  let gvBounds: number[] = [];
  let gvChunkEls: (Element | null)[] = [];
  let gvActiveIdx = -1;
  function gvShowTtsControls(show: boolean) {
    for (const id of ['btn-tts-restart', 'btn-tts-next']) {
      const el = document.getElementById(id);
      if (!el) continue;
      el.classList.toggle('hidden', !show);
      el.classList.toggle('inline-flex', show);
    }
  }
  function gvClearHighlight() {
    document.querySelector('.gv-tts-active')?.classList.remove('gv-tts-active');
    gvActiveIdx = -1;
  }
  // Sincroniza el resaltado con la posición de reproducción: busca el trozo
  // activo por gvBounds y mueve la clase .gv-tts-active a su bloque.
  function gvSyncHighlight() {
    if (!gvPiperAudio || gvBounds.length === 0 || gvBounds.length !== gvChunkEls.length) return;
    const t = gvPiperAudio.currentTime ?? 0;
    let idx = 0;
    for (let i = gvBounds.length - 1; i >= 0; i--) {
      if (t >= gvBounds[i] - 0.05) { idx = i; break; }
    }
    if (idx === gvActiveIdx) return;
    document.querySelector('.gv-tts-active')?.classList.remove('gv-tts-active');
    gvActiveIdx = idx;
    const el = gvChunkEls[idx];
    if (!el?.isConnected) return;
    el.classList.add('gv-tts-active');
    const r = el.getBoundingClientRect();
    if (r.bottom < 90 || r.top > window.innerHeight - 90) {
      el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
  }
  function gvStopAll() {
    window.speechSynthesis?.cancel();
    // Pausa (NO revoca el blob): el WAV queda cacheado para reanudar al instante.
    if (gvPiperAudio && !gvPiperAudio.paused) gvPiperAudio.pause();
  }
  if (!(window as any).__gvEventActionsInit) {
    (window as any).__gvEventActionsInit = true;
    document.addEventListener('astro:page-load', gvStopAll);
  }
  const TTS_KEY = 'gv-tts-voice';
  function gvVoices() {
    return window.speechSynthesis?.getVoices() ?? [];
  }
  // Voces neurales Piper (es): se descargan la primera vez desde HF CDN y se cachean en OPFS.
  // 'es_AR-daniela-high' NO existe en el mirror de la librería (diffusionstudio), solo en
  // rhasspy/piper-voices. Se registra en PATH_MAP y se baja de ahí a OPFS manualmente.
  const AR_VOICE = 'es_AR-daniela-high';
  const AR_VOICE_PATH = 'es/es_AR/daniela/high/es_AR-daniela-high.onnx';
  const AR_BASE = 'https://huggingface.co/rhasspy/piper-voices/resolve/main/';
  function gvRegArVoice() {
    try { (tts as any).PATH_MAP[AR_VOICE] = AR_VOICE_PATH; } catch { /* ya no soporta mutar */ }
  }
  // Descarga .onnx y .onnx.json directo a OPFS (misma estructura de cache que la librería).
  async function gvCacheArFiles(onProgress?: (p: number) => void) {
    const blame = (u: string) => u.split('/').at(-1) as string;
    const opts = { method: 'GET' };
    const total = 2;
    let doneFiles = 0;
    const root = await navigator.storage.getDirectory();
    const dir = await root.getDirectoryHandle('piper', { create: true });
    for (const suffix of ['', '.json']) {
      const url = `${AR_BASE}${AR_VOICE_PATH}${suffix}`;
      try {
        const file = await dir.getFileHandle(blame(url), { create: false });
        await file.getFile(); // existe ya → no re-descarga
        doneFiles++;
        onProgress?.(Math.round((doneFiles / total) * 100));
        continue;
      } catch { /* no existe, descargar */ }
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status} para ${blame(url)}`);
      const blob = await res.blob();
      const file = await dir.getFileHandle(blame(url), { create: true });
      const w = await file.createWritable();
      await w.write(blob);
      await w.close();
      doneFiles++;
      onProgress?.(Math.round((doneFiles / total) * 100));
    }
  }
  // ClientRouter reemplaza el <select> al cambiar de evento: la caché de
  // voces neurales debe vivir por elemento, no en un booleano de página.
  const gvPiperFilledSelects = new WeakSet<HTMLSelectElement>();
  const gvPiperFillingSelects = new WeakSet<HTMLSelectElement>();
  async function gvFillPiperVoices() {
    const sel = document.getElementById('tts-voice') as HTMLSelectElement | null;
    if (!sel || gvPiperFilledSelects.has(sel) || gvPiperFillingSelects.has(sel)) return;
    gvPiperFillingSelects.add(sel);
    try {
      gvRegArVoice();
      const all = await tts.voices();
      const es = all.filter((v) => v.key.startsWith('es_'));
      if (es.length === 0) return;
      const saved = localStorage.getItem(TTS_KEY);
      const group = document.createElement('optgroup');
      group.label = 'Voz neural (Piper, descarga única)';
      for (const v of es) {
        const opt = document.createElement('option');
        opt.value = PIPER_PREFIX + v.key;
        opt.textContent = `${v.name} (${v.language?.code ?? v.key}) Piper`;
        if (saved === opt.value) opt.selected = true;
        group.appendChild(opt);
      }
      const arOpt = document.createElement('option');
      arOpt.value = PIPER_PREFIX + AR_VOICE;
      arOpt.textContent = 'Daniela (es_AR) Piper';
      if (saved === arOpt.value) arOpt.selected = true;
      group.appendChild(arOpt);
      sel.appendChild(group);
      sel.removeAttribute('disabled');
      gvPiperFilledSelects.add(sel);
    } catch (err) {
      console.warn('Piper no disponible', err);
    } finally {
      gvPiperFillingSelects.delete(sel);
    }
  }
  // Rellena el <select>: primero las voces en español de la plataforma/neurales,
  // luego el resto (por si no hay es, que al menos sigan funcionando).
  function gvFillVoices() {
    const sel = document.getElementById('tts-voice') as HTMLSelectElement | null;
    if (!sel || sel.options.length > 0) return;
    const all = gvVoices();
    const es = all.filter((v) => v.lang.toLowerCase().startsWith('es'));
    const rest = all.filter((v) => !es.includes(v));
    const sorted = [...es, ...rest];
    if (sorted.length === 0) return;
    // Voz guardada o, por defecto, la mejor es-CL/es-ES.
    const saved = localStorage.getItem(TTS_KEY);
    const best =
      sorted.find((v) => v.name === saved) ??
      sorted.find((v) => v.lang.startsWith('es-CL')) ??
      sorted.find((v) => v.lang.startsWith('es-ES')) ??
      sorted.find((v) => v.lang.startsWith('es')) ??
      sorted[0];
    for (const v of sorted) {
      const opt = document.createElement('option');
      opt.value = v.name;
      opt.textContent = `${v.name} (${v.lang})`;
      if (v === best) opt.selected = true;
      sel.appendChild(opt);
    }
    sel.removeAttribute('disabled');
  }
  function gvSpanishVoice(voices: SpeechSynthesisVoice[]) {
    return (
      voices.find((v) => v.lang.startsWith('es-CL')) ??
      voices.find((v) => v.lang.startsWith('es-ES')) ??
      voices.find((v) => v.lang.startsWith('es'))
    );
  }
  function gvSetTtsPlaying(playing: boolean) {
    document.querySelector('[data-tts-icon="playing"]')?.classList.toggle('hidden', !playing);
    document.querySelector('[data-tts-icon="idle"]')?.classList.toggle('hidden', playing);
  }
  function gvUtt(msg: HTMLElement | null) {
    const label = document.querySelector('[data-tts-label]');
    if (label) label.textContent = 'Escuchar';
    gvSetTtsPlaying(false);
    if (msg) msg.textContent = '';
  }
  let gvFilled = false;
  function gvEnsureVoices() {
    if (gvFilled || gvVoices().length > 0) { gvFillVoices(); gvFilled = true; }
  }
  // Piper: primera escucha descarga el modelo (~60-75MB, 1 vez, a OPFS); luego sintetiza offline.
  let gvPiperBusy = false;
  // Pre-descarga la voz al seleccionarla (evento 'change'), no al hacer play; evita la espera del modelo.
  const gvPreloading = new Set<string>();
  const gvTtsBusyTasks = new Set<string>();
  function gvSetTtsBusy(task: string, busy: boolean) {
    if (busy) gvTtsBusyTasks.add(task);
    else gvTtsBusyTasks.delete(task);
    const active = gvTtsBusyTasks.size > 0;
    const button = document.getElementById('btn-tts');
    if (!button) return;
    button.setAttribute('aria-busy', String(active));
    // Estado estático desde la tarea real: sin rAF, canvas ni animación continua.
    button.style.boxShadow = active
      ? '0 0 0 2px color-mix(in oklab, var(--color-primary) 30%, transparent)'
      : '';
  }
  async function gvPreloadPiper(voiceId: string) {
    if (gvPreloading.has(voiceId)) return;
    gvPreloading.add(voiceId);
    const task = `preload:${voiceId}`;
    const label = document.querySelector('[data-tts-label]');
    const msg = document.getElementById('tts-msg');
    try {
      const stored = await tts.stored();
      if (stored.includes(voiceId)) return; // ya cacheada en OPFS, no bajar de nuevo
      gvSetTtsBusy(task, true);
      if (label) label.textContent = 'Descargando…';
      if (msg) msg.textContent = 'Preparando voz… (primera vez)';
      if (voiceId === AR_VOICE) {
        await gvCacheArFiles((p) => {
          if (msg) msg.textContent = `Preparando voz… ${p}%`;
        });
      } else {
        // 'download' cachea en OPFS sin sintetizar; el play posterior es instantáneo.
        await tts.download(voiceId, (p) => {
          if (msg && p.total > 0) msg.textContent = `Preparando voz… ${Math.round((p.loaded / p.total) * 100)}%`;
        });
      }
      if (label) label.textContent = 'Escuchar';
      if (msg) msg.textContent = '';
    } catch (err) {
      console.warn('Pre-descarga Piper falló', err);
    } finally {
      gvPreloading.delete(voiceId);
      gvSetTtsBusy(task, false);
    }
  }
  // Bloques legibles del artículo: cada uno se sintetiza/resalta como unidad.
  // El texto de cada bloque se normaliza igual que el body leído antes.
  function gvBlockParts(prose: Element | null): { el: Element; text: string }[] {
    if (!prose) return [];
    const sel = 'p, h1, h2, h3, h4, h5, h6, li, blockquote, pre';
    const all = Array.from(prose.querySelectorAll(sel));
    // Bloque más externo solamente (blockquote > p cuenta como blockquote).
    const blocks = all.filter((el) => !all.some((o) => o !== el && o.contains(el)));
    const parts: { el: Element; text: string }[] = [];
    for (const el of blocks) {
      if (el.closest('.not-prose')) continue;
      const clone = el.cloneNode(true) as Element;
      clone.querySelectorAll('.source-ref-tip').forEach((t) => t.remove());
      const text = (clone.textContent ?? '').replace(/\s+/g, ' ').trim();
      if (text) parts.push({ el, text });
    }
    return parts;
  }
  // Texto completo del artículo (lo que se habla; también clave del cache).
  function gvProseText(prose: Element | null): string {
    return gvBuildChunks(gvBlockParts(prose)).map((c) => c.text).join(' ');
  }
  async function gvPiperToggle(voiceId: string, prose: Element | null, msg: HTMLElement | null) {
    const label = document.querySelector('[data-tts-label]');
    // Sintetizando → segundo clic CANCELA (revisado entre trozos; latencia ~1 trozo).
    if (gvPiperBusy) {
      gvSynthCancel = true;
      return;
    }
    const chunks = gvBuildChunks(gvBlockParts(prose));
    if (chunks.length === 0) return;
    const text = chunks.map((c) => c.text).join(' ');
    const key = `${voiceId}|${text}`;
    // Reproduciendo este texto → pausar (reanuda desde el mismo punto).
    if (gvPiperAudio && gvCacheKey === key && !gvPiperAudio.paused) {
      gvPiperAudio.pause();
      if (label) label.textContent = 'Reanudar';
      gvSetTtsPlaying(false);
      if (msg) msg.textContent = '';
      return;
    }
    // Cacheado y pausado/terminado → reproducir/reanudar sin resintetizar.
    // Re-zipea los elementos DOM (mismo índice ⇒ mismo bloque; DOM determinista).
    if (gvPiperAudio && gvCacheKey === key && gvBounds.length === chunks.length) {
      gvChunkEls = chunks.map((c) => c.el);
      gvPiperAudio.ontimeupdate = () => gvSyncHighlight();
      gvPiperAudio.onended = () => { gvStopAll(); gvUtt(msg); };
      try { await gvPiperAudio.play(); } catch { /* política de autoplay */ }
      gvSyncHighlight();
      gvShowTtsControls(true);
      if (label) label.textContent = 'Detener';
      gvSetTtsPlaying(true);
      if (msg) msg.textContent = 'Leyendo con voz neural…';
      return;
    }
    if (gvPiperAudio && !gvPiperAudio.paused) gvStopAll();
    gvClearHighlight();
    gvPiperBusy = true;
    gvSetTtsBusy('synthesis', true);
    gvSynthCancel = false;
    if (label) label.textContent = 'Cancelar';
    if (msg) msg.textContent = 'Descargando modelo de voz (primera vez)…';
    try {
      // El phonemizer wasm falla con textos muy largos (codes espeak); se trocea y se unen los PCM.
      const { wav, bounds } = await gvPiperSpeak(chunks.map((c) => c.text), voiceId, (t) => {
        if (msg) msg.textContent = t;
      });
      if (!gvPiperAudio) gvPiperAudio = new Audio();
      if (gvPiperUrl) URL.revokeObjectURL(gvPiperUrl); // eviction LRU (1 entrada)
      gvPiperUrl = URL.createObjectURL(wav);
      gvCacheKey = key;
      gvBounds = bounds;
      gvChunkEls = chunks.map((c) => c.el);
      gvActiveIdx = -1;
      gvPiperAudio.src = gvPiperUrl;
      gvPiperAudio.ontimeupdate = () => gvSyncHighlight();
      gvPiperAudio.onended = () => { gvStopAll(); gvUtt(msg); };
      await gvPiperAudio.play();
      gvShowTtsControls(true);
      if (label) label.textContent = 'Detener';
      gvSetTtsPlaying(true);
      if (msg) msg.textContent = 'Leyendo con voz neural…';
    } catch (err) {
      if (gvSynthCancel || (err as DOMException)?.name === 'AbortError') {
        gvUtt(msg);
        if (msg) msg.textContent = 'Síntesis cancelada';
      } else {
        console.error('Piper TTS falló', err);
        gvUtt(msg);
        if (msg) msg.textContent = 'Voz neural no disponible en tu red. Prueba una voz del navegador.';
      }
    } finally {
      gvPiperBusy = false;
      gvSetTtsBusy('synthesis', false);
    }
  }
  // Sintetiza por trozos de PCHUNK chars (el phononizer wasm aborta con inputs muy largos)
  // y concatena los PCM mono 16-bit en un solo WAV (misma tasa, misma voz por llamada).
  const PCHUNK = 900;
  // Cancelación cooperativa: gvPiperToggle lo activa con un segundo clic y el
  // loop revisa entre trozos (no se puede abortar mid-chunk sin tocar el worker).
  let gvSynthCancel = false;
  // Divide un bloque > max por oraciones (el phonemizer wasm aborta con inputs largos).
  function gvSplitLong(text: string, max: number): string[] {
    const sentences = text.split(/(?<=[.!?…])\s+/);
    const out: string[] = [];
    let cur = '';
    for (const s of sentences) {
      if (!cur) {
        if (s.length > max) {
          // Oración gigante: cortar por palabras.
          let rest = s;
          while (rest.length > max) {
            let cut = rest.lastIndexOf(' ', max);
            if (cut === -1) cut = max;
            out.push(rest.slice(0, cut).trim());
            rest = rest.slice(cut).trim();
          }
          cur = rest;
        } else cur = s;
        continue;
      }
      if (cur.length + 1 + s.length > max) { out.push(cur); cur = s; }
      else cur += ' ' + s;
    }
    if (cur) out.push(cur);
    return out;
  }
  // Trozos sintetizables desde los bloques: bloques cortos van enteros; los
  // largos se subdividen por oración conservando el el de origen (highlight).
  function gvBuildChunks(parts: { el: Element; text: string }[]): { el: Element; text: string }[] {
    const chunks: { el: Element; text: string }[] = [];
    for (const p of parts) {
      if (p.text.length <= PCHUNK) chunks.push(p);
      else for (const t of gvSplitLong(p.text, PCHUNK)) chunks.push({ el: p.el, text: t });
    }
    return chunks;
  }
  async function gvPiperSpeak(chunks: string[], voiceId: string, onMsg: (m: string) => void): Promise<{ wav: Blob; bounds: number[] }> {
    const parts: Int16Array[] = [];
    const bounds: number[] = [];
    let sampleRate = 22050;
    let totalSamples = 0;
    for (let i = 0; i < chunks.length; i++) {
      if (gvSynthCancel) throw new DOMException('Síntesis cancelada', 'AbortError');
      if (chunks.length > 1) onMsg(`Sintetizando… ${i + 1}/${chunks.length} (clic para cancelar)`);
      const wav = await tts.predict({ text: chunks[i], voiceId }, (p) => {
        if (p.total > 0) onMsg(`Descargando voz… ${Math.round((p.loaded / p.total) * 100)}%`);
      });
      const buf = new Uint8Array(await wav.arrayBuffer());
      if (buf.byteLength < 44) throw new Error('WAV inválido');
      const dv = new DataView(buf.buffer, buf.byteOffset, buf.byteLength);
      if (i === 0) sampleRate = dv.getUint32(24, true);
      const part = new Int16Array(buf.buffer, buf.byteOffset + 44, (buf.byteLength - 44) / 2);
      bounds.push(totalSamples / sampleRate);
      parts.push(part);
      totalSamples += part.length;
    }
    if (parts.length === 0 || gvSynthCancel) {
      if (gvSynthCancel) throw new DOMException('Síntesis cancelada', 'AbortError');
      throw new Error('Sin audio');
    }
    const pcm = new Int16Array(totalSamples);
    let off = 0;
    for (const p of parts) { pcm.set(p, off); off += p.length; }
    return { wav: gvWav(pcm, sampleRate), bounds };
  }
  function gvWav(pcm: Int16Array, sampleRate: number): Blob {
    const header = 44;
    const ab = new ArrayBuffer(header + pcm.length * 2);
    const v = new DataView(ab);
    v.setUint32(0, 1179011410, true); // RIFF
    v.setUint32(4, ab.byteLength - 8, true);
    v.setUint32(8, 1163280727, true); // WAVE
    v.setUint32(12, 544501094, true); // fmt
    v.setUint32(16, 16, true);
    v.setUint16(20, 1, true);
    v.setUint16(22, 1, true);
    v.setUint32(24, sampleRate, true);
    v.setUint32(28, sampleRate * 2, true);
    v.setUint16(32, 2, true);
    v.setUint16(34, 16, true);
    v.setUint32(36, 1635017060, true); // data
    v.setUint32(40, pcm.length * 2, true);
    new Int16Array(ab, header).set(pcm);
    return new Blob([ab], { type: 'audio/wav' });
  }
  type CopyFeedbackState = 'copied' | 'error';
  const gvCopyResetTimers = new WeakMap<HTMLButtonElement, number>();
  function gvSetCopyFeedback(button: HTMLButtonElement, state: CopyFeedbackState) {
    const iconSwap = button.querySelector<HTMLElement>('[data-copy-swap]');
    const status = button.parentElement?.querySelector<HTMLElement>(':scope > [data-copy-status]');
    const previousTimer = gvCopyResetTimers.get(button);
    if (previousTimer) window.clearTimeout(previousTimer);

    if (iconSwap) iconSwap.dataset.state = state;
    if (status) {
      status.textContent = state === 'copied'
        ? button.dataset.copySuccessMessage ?? 'Contenido copiado al portapapeles.'
        : button.dataset.copyErrorMessage ?? 'No se pudo copiar el contenido.';
    }

    gvCopyResetTimers.set(button, window.setTimeout(() => {
      if (iconSwap?.isConnected) iconSwap.dataset.state = 'idle';
      if (status?.isConnected) status.textContent = '';
      gvCopyResetTimers.delete(button);
    }, state === 'copied' ? 2000 : 2500));
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const prose = document.querySelector('.prose');
    const exportEl = document.getElementById('event-export-data');
    const promptEl = document.getElementById('event-export-data');
    gvEnsureVoices();

    if (target.closest('#btn-tts')) {
      e.preventDefault();
      const msg = document.getElementById('tts-msg');
      const sel = document.getElementById('tts-voice') as HTMLSelectElement | null;
      const voiceId = sel?.value ?? '';
      if (voiceId.startsWith(PIPER_PREFIX)) {
        gvPiperToggle(voiceId.slice(PIPER_PREFIX.length), prose, msg);
        return;
      }
      if (!window.speechSynthesis) return;
      // Corta el audio Piper previo (sonando o pausado): solo una voz a la vez,
      // y su resaltado ya no corresponde a este motor.
      gvStopAll();
      gvClearHighlight();
      if (speechSynthesis.speaking || speechSynthesis.paused) {
        speechSynthesis.cancel();
        gvUtt(msg);
        return;
      }
      const text = gvProseText(prose);
      if (!text) return;
      const utter = new SpeechSynthesisUtterance(text);
      const voice = (sel && gvVoices().find((v) => v.name === sel.value)) || gvSpanishVoice(gvVoices());
      if (voice) { utter.voice = voice; utter.lang = voice.lang; }
      utter.rate = 0.98;
      utter.onend = utter.onerror = () => gvUtt(msg);
      speechSynthesis.speak(utter);
      const label = document.querySelector('[data-tts-label]');
      if (label) label.textContent = 'Detener';
      gvSetTtsPlaying(true);
      if (msg) msg.textContent = 'Lectura en voz alta en progreso…';
      return;
    }
    if (target.closest('#btn-tts-restart')) {
      e.preventDefault();
      const selNow = document.getElementById('tts-voice') as HTMLSelectElement | null;
      if (!selNow?.value.startsWith(PIPER_PREFIX)) return; // no resucitar Piper si el usuario cambió de voz
      if (!gvPiperAudio || !gvCacheKey) return;
      gvPiperAudio.currentTime = 0;
      void gvPiperAudio.play().catch(() => { /* política de autoplay */ });
      gvSyncHighlight();
      const label = document.querySelector('[data-tts-label]');
      if (label) label.textContent = 'Detener';
      gvSetTtsPlaying(true);
      return;
    }
    if (target.closest('#btn-tts-next')) {
      e.preventDefault();
      const selNow = document.getElementById('tts-voice') as HTMLSelectElement | null;
      if (!selNow?.value.startsWith(PIPER_PREFIX)) return; // no resucitar Piper si el usuario cambió de voz
      if (!gvPiperAudio || !gvCacheKey || gvBounds.length === 0) return;
      const t = gvPiperAudio.currentTime ?? 0;
      // Salta al inicio del siguiente trozo (~parrafo); tras el último, vuelve al inicio.
      const next = gvBounds.find((b) => b > t + 0.15);
      gvPiperAudio.currentTime = next ?? 0;
      void gvPiperAudio.play().catch(() => { /* política de autoplay */ });
      gvSyncHighlight();
      const label = document.querySelector('[data-tts-label]');
      if (label) label.textContent = 'Detener';
      gvSetTtsPlaying(true);
      return;
    }
    if (target.closest('#tts-voice')) {
      const selectEl = target as HTMLSelectElement;
      localStorage.setItem(TTS_KEY, selectEl.value);
      if (selectEl.value.startsWith(PIPER_PREFIX)) gvPreloadPiper(selectEl.value.slice(PIPER_PREFIX.length));
      return;
    }
    if (target.closest('#btn-copy-md')) {
      const btn = target.closest<HTMLButtonElement>('#btn-copy-md');
      const markdown = exportEl?.getAttribute('data-md') ?? '';
      if (!btn) return;
      if (!navigator.clipboard || !markdown) {
        gvSetCopyFeedback(btn, 'error');
        return;
      }
      void navigator.clipboard.writeText(markdown).then(() => {
        play('success');
        gvSetCopyFeedback(btn, 'copied');
      }).catch(() => {
        gvSetCopyFeedback(btn, 'error');
      });
      return;
    }
    // Los enlaces solo inyectan el prefill; el botón dedicado es el que copia
    // el prompt completo, para no sobrescribir el portapapeles sin avisar.
    const aiLink = target.closest<HTMLAnchorElement>('a[data-ai-prefill]');
    if (aiLink) {
      const prefill = promptEl?.getAttribute('data-ai-prefill');
      if (prefill) {
        try {
          const url = new URL(aiLink.href);
          url.searchParams.set('q', prefill);
          aiLink.href = url.toString();
        } catch { /* href inválida: conserva el fallback corto */ }
      }
      return;
    }
    if (target.closest('[data-copy-prompt]')) {
      const fullPrompt = promptEl?.getAttribute('data-prompt') ?? '';
      const btn = target.closest<HTMLButtonElement>('[data-copy-prompt]');
      if (!btn) return;
      if (!navigator.clipboard || !fullPrompt) {
        gvSetCopyFeedback(btn, 'error');
        return;
      }
      void navigator.clipboard.writeText(fullPrompt).then(() => {
        play('success');
        gvSetCopyFeedback(btn, 'copied');
      }).catch(() => {
        gvSetCopyFeedback(btn, 'error');
      });
    }
  });
  // Chrome/Edge cargan las voces de forma asíncrona; re-llena cuando estén listas.
  if (window.speechSynthesis) {
    window.speechSynthesis.addEventListener?.('voiceschanged', () => { gvFillVoices(); gvFilled = true; });
  }
  // Si el texto de esta página ya está sintetizado (cache) y pausado, el botón
  // debe mostrar "Reanudar" en vez de "Escuchar"; re-zipea los bloques para que
  // el resaltado/salto funcionen sin resintetizar.
  function gvMarkResumable() {
    if (!gvPiperAudio || !gvCacheKey) return;
    const sel = document.getElementById('tts-voice') as HTMLSelectElement | null;
    if (!sel?.value.startsWith(PIPER_PREFIX)) return;
    const prose = document.querySelector('.prose');
    const chunks = gvBuildChunks(gvBlockParts(prose));
    const key = `${sel.value.slice(PIPER_PREFIX.length)}|${chunks.map((c) => c.text).join(' ')}`;
    if (key !== gvCacheKey || gvBounds.length !== chunks.length) return;
    gvChunkEls = chunks.map((c) => c.el);
    const label = document.querySelector('[data-tts-label]');
    if (label) label.textContent = 'Reanudar';
    gvShowTtsControls(true);
  }
  function gvInitTts() {
    gvEnsureVoices();
    void gvFillPiperVoices();
    gvMarkResumable();
  }
  // Inicializa también en la carga directa: astro:page-load puede emitirse
  // antes de que este módulo termine de evaluarse en una transición.
  gvInitTts();
  document.addEventListener('astro:page-load', gvInitTts);
  document.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement | null;
    if (target?.id === 'tts-voice') {
      // Cambiar de voz corta toda reproducción previa (Piper y navegador):
      // nunca deben sonar dos motores a la vez; y se limpia el resaltado
      // del motor anterior (el nuevo no lo sincroniza).
      gvStopAll();
      gvClearHighlight();
      // Los controles de salto solo aplican al audio Piper cacheado.
      gvShowTtsControls(target.value.startsWith(PIPER_PREFIX) && !!gvCacheKey);
      gvUtt(document.getElementById('tts-msg'));
      if (target.value.startsWith(PIPER_PREFIX)) gvPreloadPiper(target.value.slice(PIPER_PREFIX.length));
    }
  });
</script>

<style>
  .copy-icon-swap {
    position: relative;
    display: inline-grid;
    width: 1rem;
    height: 1rem;
  }
  .copy-icon-swap > .copy-icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    opacity: 0;
    filter: blur(4px);
    transform: scale(0.25);
    pointer-events: none;
    transition:
      opacity 200ms cubic-bezier(0.2, 0, 0, 1),
      filter 200ms cubic-bezier(0.2, 0, 0, 1),
      transform 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  .copy-icon-swap[data-state='idle'] > [data-icon='idle'],
  .copy-icon-swap[data-state='copied'] > [data-icon='copied'],
  .copy-icon-swap[data-state='error'] > [data-icon='error'] {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .copy-icon-swap > .copy-icon { transition: none; }
  }
</style>

