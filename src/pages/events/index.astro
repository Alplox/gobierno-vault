---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import EventGraph from '../../components/EventGraph.astro';
import FilterBar from '../../components/FilterBar.astro';
import TimelineNav from '../../components/TimelineNav.astro';
import { getAllEvents, getUniqueTopics, getUniquePeople, getUniqueOrgs, eventHasPerson, eventHasOrg, getTopicsMap, getPeopleMap, getOrgsMap, getEventEntities } from '../../lib/queries';
import { buildConnectionIndex, eventBasename, eventYearFromDate, countExplicitConnections } from '../../lib/relations';
import { Calendar, ChevronDown } from 'lucide-astro';

const allEvents = await getAllEvents();
const topicIds = await getUniqueTopics();
const personIds = await getUniquePeople();
const orgIds = await getUniqueOrgs();
const connectionIndex = buildConnectionIndex(allEvents);

const [topicsMap, peopleMap, orgsMap] = await Promise.all([
  getTopicsMap(),
  getPeopleMap(),
  getOrgsMap(),
]);

const topics = topicIds.map((id) => ({ id, label: topicsMap.get(id) ?? id }));
const people = personIds.map((id) => ({ id, label: peopleMap.get(id) ?? id }));
const orgs = orgIds.map((id) => ({ id, label: orgsMap.get(id) ?? id }));

const tema = Astro.url.searchParams.get('tema');
const persona = Astro.url.searchParams.get('persona');
const org = Astro.url.searchParams.get('org');

let filtered = allEvents;
if (tema) filtered = filtered.filter((e) => e.data.tema.includes(tema));
if (persona) filtered = filtered.filter((e) => eventHasPerson(e.id, persona));
if (org) filtered = filtered.filter((e) => eventHasOrg(e.id, org));

// La primera tanda se renderiza en SSR (pintado inmediato + SEO); el resto viaja
// como JSON compacto y se pinta bajo demanda en el cliente al hacer scroll.
const SSR_LIMIT = 12;
const ssrEvents = filtered.slice(0, SSR_LIMIT);
const lazyEvents = filtered.slice(SSR_LIMIT);
const ssrIds = new Set(ssrEvents.map((e) => eventBasename(e.id)));

const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

interface MonthGroup {
  key: string;
  month: number;
  year: number;
  events: typeof filtered;
}
interface YearGroup {
  year: number;
  months: MonthGroup[];
}

const years: YearGroup[] = [];
for (const event of filtered) {
  const d = new Date(event.data.fecha);
  const year = eventYearFromDate(d);
  const month = parseInt(
    new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Santiago', month: '2-digit' }).format(d),
    10
  );
  let yearGroup = years.find((y) => y.year === year);
  if (!yearGroup) {
    yearGroup = { year, months: [] };
    years.push(yearGroup);
  }
  const key = `${year}-${String(month).padStart(2, '0')}`;
  let monthGroup = yearGroup.months.find((m) => m.key === key);
  if (!monthGroup) {
    monthGroup = { key, month, year, events: [] };
    yearGroup.months.push(monthGroup);
  }
  monthGroup.events.push(event);
}
years.sort((a, b) => b.year - a.year);
for (const yearGroup of years) {
  yearGroup.months.sort((a, b) => (b.key < a.key ? -1 : 1));
}

const currentYear = new Date().getFullYear();
const activeFilters = Boolean(tema || persona || org);

const navSections = years.map((y) => ({
  id: `year-${y.year}`,
  label: `${y.year}`,
  children: y.months.map((m) => ({
    id: `month-${m.key}`,
    label: `${monthNames[m.month - 1]} ${m.year}`,
  })),
}));

// JSON compacto para el cliente: solo lo que necesita la tarjeta.
const lazyData = lazyEvents.map((event) => {
  const id = eventBasename(event.id);
  const d = new Date(event.data.fecha);
  const conn = connectionIndex.get(id);
  const previews = conn ? [...conn.outgoing, ...conn.incoming].slice(0, 2) : [];
  const entities = getEventEntities(event.id);
  return {
    id,
    year: eventYearFromDate(d),
    month: parseInt(new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Santiago', month: '2-digit' }).format(d), 10),
    fechaStr: d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }),
    tipo: event.data.tipo,
    titulo: event.data.titulo,
    personas: entities.personas.map((p) => peopleMap.get(p) ?? p),
    temas: event.data.tema.map((t) => topicsMap.get(t) ?? t),
    links: conn ? countExplicitConnections(conn) : 0,
    previews: previews.map((edge) => ({
      tipo: edge.tipo,
      arrow: edge.direction === 'outgoing' ? '→' : '←',
      titulo: edge.titulo,
    })),
  };
});
---

<Base title="Eventos">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <Calendar class="h-6 w-6 text-blue-600 shrink-0" />
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">Catálogo de Eventos</h1>
    </div>
    <p class="text-gray-500 text-sm">Explora acontecimientos, decretos y declaraciones registrados cronológicamente, agrupados por año y mes.</p>
  </div>

  <FilterBar topics={topics} people={people} orgs={orgs} />

  <EventGraph events={filtered} connectionIndex={connectionIndex} size="mini" />

  {filtered.length === 0 ? (
    <p class="text-sm text-gray-500 bg-white p-12 rounded-2xl border border-dashed border-gray-300 text-center">
      No se encontraron eventos con los filtros seleccionados.
    </p>
  ) : (
    <div class="relative mt-6">
      <div id="event-index-root" class="space-y-8">
        {years.map((yearGroup) => (
          <section id={`year-${yearGroup.year}`} class="scroll-mt-32">
            <details class="group/year" open={yearGroup.year === currentYear || activeFilters} data-persist={`events-year-${yearGroup.year}`}>
              <summary class="flex cursor-pointer list-none items-center gap-2 border-b-2 border-gray-200 py-2 [&::-webkit-details-marker]:hidden">
                <ChevronDown class="h-4 w-4 shrink-0 text-gray-400 transition-transform duration-200 group-open/year:rotate-180" />
                <span class="text-lg font-bold tracking-tight text-gray-900">{yearGroup.year}</span>
                <span class="text-xs text-gray-400">
                  {yearGroup.months.reduce((a, m) => a + m.events.length, 0)} {yearGroup.months.reduce((a, m) => a + m.events.length, 0) === 1 ? 'evento' : 'eventos'}
                </span>
              </summary>

              <div class="pt-4">
                {yearGroup.months.map((monthGroup) => (
                  <section id={`month-${monthGroup.key}`} class="scroll-mt-32 mb-8">
                    <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-gray-500">
                      <span class="h-1.5 w-1.5 rounded-full bg-gray-400" />
                      {monthNames[monthGroup.month - 1]} {monthGroup.year}
                      <span class="ml-auto text-[11px] font-normal normal-case text-gray-400">
                        {monthGroup.events.length} {monthGroup.events.length === 1 ? 'evento' : 'eventos'}
                      </span>
                    </h2>
                    <div class="event-grid grid grid-cols-1 md:grid-cols-2 gap-4">
                      {monthGroup.events.map((event) => {
                        if (!ssrIds.has(eventBasename(event.id))) return null;
                        return <EventCard event={event} connectionIndex={connectionIndex} />;
                      })}
                    </div>
                  </section>
                ))}
              </div>
            </details>
          </section>
        ))}
      </div>

      <TimelineNav sections={navSections} />
    </div>
  )}

  <script type="application/json" id="event-index-data" set:html={JSON.stringify(lazyData)} />

  <script>
    import { initEventList } from '../../scripts/eventListClient.js';
    initEventList();
  </script>

  <script>
    import '../../scripts/force-graph.js';
  </script>

  <script>
    const STORAGE_KEY = 'gobierno-vault-events-collapsed';

    function loadPersisted(): Record<string, boolean> {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      } catch {
        return {};
      }
    }

    document.querySelectorAll<HTMLDetailsElement>('details[data-persist]').forEach((el) => {
      el.addEventListener('toggle', () => {
        const state = loadPersisted();
        state[el.dataset.persist!] = !el.open;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      });
    });

    const persisted = loadPersisted();
    document.querySelectorAll<HTMLDetailsElement>('details[data-persist]').forEach((el) => {
      const key = el.dataset.persist!;
      if (persisted[key] !== undefined) {
        el.open = !persisted[key];
      }
    });
  </script>
</Base>