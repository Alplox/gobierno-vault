---
import Base from '../../layouts/Base.astro';
import { getAllCifras, getCifrasRegistry, getAllEvents } from '../../lib/queries';
import { ArrowLeft, TrendingUp, Calendar, Hash, ExternalLink } from 'lucide-astro';

export async function getStaticPaths() {
  const allCifras = getAllCifras();
  const registry = getCifrasRegistry();
  const conceptos = [...new Set(allCifras.map((c) => c.concepto))];

  return conceptos.map((concepto) => ({
    params: { concepto },
    props: { concepto, registry },
  }));
}

const { concepto, registry } = Astro.props;
const allCifras = getAllCifras();
const events = await getAllEvents();
const reg = registry[concepto];

const conceptoCifras = allCifras
  .filter((c) => c.concepto === concepto)
  .reverse();

const eventMap = new Map(events.map((e) => [e.id, e]));

const total = conceptoCifras.reduce((sum, c) => sum + c.valor, 0);
---

<Base title={reg?.nombre ?? concepto}>
  <article class="max-w-3xl mx-auto">
    <div class="mb-6">
      <a href="/stats" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary bg-primary/10 px-2.5 py-1 rounded-lg transition-colors">
        <ArrowLeft class="h-3.5 w-3.5" />
        <span>Volver a Estadísticas</span>
      </a>
    </div>

    <header class="mb-8 bg-base-100 p-6 sm:p-8 rounded-2xl border border-base-300 shadow-sm">
      <div class="flex items-start gap-4">
        <div class="h-12 w-12 rounded-full bg-primary/15 text-primary flex items-center justify-center font-bold text-lg shrink-0">
          <TrendingUp class="h-6 w-6" />
        </div>
        <div class="min-w-0 flex-1">
          <span class="text-[11px] font-mono font-medium text-base-content/40 block mb-1">{concepto}</span>
          <h1 class="text-2xl sm:text-3xl font-bold text-base-content leading-tight">{reg?.nombre ?? concepto}</h1>
          <p class="text-sm text-base-content/70 mt-2">
            Total acumulado: <strong class="text-primary font-mono text-base font-bold">{Math.round(total).toLocaleString('es-ES')}</strong>
            {reg?.unidad_default ? ` ${reg.unidad_default}` : ''}
            · <span class="text-base-content/60 font-medium">{conceptoCifras.length} registro{conceptoCifras.length !== 1 ? 's' : ''}</span>
          </p>
        </div>
      </div>
    </header>

    {conceptoCifras.length > 0 ? (
      <section>
        <h2 class="text-lg font-bold text-base-content mb-4 flex items-center gap-2">
          <Calendar class="h-5 w-5 text-primary" />
          <span>Registros por evento</span>
        </h2>
        <div class="space-y-3">
          {conceptoCifras.map((cifra) => {
            const event = eventMap.get(cifra.eventId);
            const year = event ? new Date(event.data.fecha).getFullYear() : cifra.fecha.getFullYear();
            const filename = cifra.eventId.split('/').pop() ?? cifra.eventId;
            return (
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 bg-base-100 rounded-xl border border-base-300 shadow-sm hover:border-primary/50 transition-colors">
                <div class="flex items-baseline gap-2">
                  <span class="text-xl font-extrabold text-primary font-mono">
                    {cifra.raw}
                  </span>
                  {cifra.unidad && (
                    <span class="text-xs font-semibold text-base-content/60 bg-base-200 px-2 py-0.5 rounded">{cifra.unidad}</span>
                  )}
                </div>
                <div class="min-w-0 flex-1 sm:text-right">
                  {event && (
                    <a href={`/events/${year}/${filename}`} class="text-sm font-semibold text-base-content hover:text-primary transition-colors block truncate">
                      {event.data.titulo}
                    </a>
                  )}
                  <time class="text-xs text-base-content/40 font-mono mt-0.5 block">
                    {cifra.fecha.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ) : (
      <p class="text-sm text-base-content/60 bg-base-100 p-8 rounded-xl border border-dashed border-base-300 text-center">
        No hay registros para este concepto.
      </p>
    )}
  </article>
</Base>

