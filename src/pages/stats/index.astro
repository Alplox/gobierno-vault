---
import Base from '../../layouts/Base.astro';
import { getAllCifras, getCifrasRegistry } from '../../lib/queries';
import { BarChart3, TrendingUp, Hash, ChevronRight } from 'lucide-astro';

const allCifras = getAllCifras();
const registry = getCifrasRegistry();

const byConcepto = new Map<string, { nombre: string; entries: typeof allCifras; years: Map<string, number> }>();

for (const cifra of allCifras) {
  if (!byConcepto.has(cifra.concepto)) {
    const reg = registry[cifra.concepto];
    byConcepto.set(cifra.concepto, {
      nombre: reg?.nombre ?? cifra.concepto,
      entries: [],
      years: new Map(),
    });
  }
  const group = byConcepto.get(cifra.concepto)!;
  group.entries.push(cifra);
  const year = cifra.fecha.getFullYear().toString();
  group.years.set(year, (group.years.get(year) ?? 0) + cifra.valor);
}

const allYears = [...new Set(allCifras.map((c) => c.fecha.getFullYear().toString()))].sort();
const conceptos = [...byConcepto.entries()].sort((a, b) => b[1].entries.length - a[1].entries.length);
---

<Base title="Estadisticas">
  <article class="max-w-5xl mx-auto">
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-1">
        <BarChart3 class="h-6 w-6 text-primary shrink-0" />
        <h1 class="text-2xl sm:text-3xl font-bold text-base-content leading-tight">Estadísticas y Cifras Clave</h1>
      </div>
      <p class="text-base-content/60 text-sm">Resumen cuantitativo de cifras extraídas de la base de eventos.</p>
    </div>

    {conceptos.length > 0 ? (
      <section class="bg-base-100 rounded-2xl border border-base-300 shadow-sm p-6 overflow-hidden">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-bold text-base-content flex items-center gap-2">
            <TrendingUp class="h-5 w-5 text-primary" />
            <span>Resumen por concepto</span>
          </h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b border-base-300 text-xs font-bold uppercase tracking-wider text-base-content/60 bg-base-200/50">
                <th class="sticky left-0 z-10 bg-base-200 text-left py-3 px-4">Concepto</th>
                {allYears.map((y) => (
                  <th class="text-right py-3 px-4">{y}</th>
                ))}
                <th class="text-right py-3 px-4 text-base-content">Total</th>
                <th class="text-right py-3 px-4">Menciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-300">
              {conceptos.map(([concepto, data]) => {
                const total = data.entries.reduce((sum, e) => sum + e.valor, 0);
                return (
                  <tr class="hover:bg-primary/10/30 transition-colors">
                    <td class="sticky left-0 bg-base-100 py-3 px-4">
                      <a href={`/stats/${concepto}`} class="inline-flex items-center gap-1.5 text-primary hover:text-primary font-semibold group">
                        <span>{data.nombre}</span>
                        <ChevronRight class="h-3.5 w-3.5 text-base-content/40 group-hover:text-primary transition-colors" />
                      </a>
                    </td>
                    {allYears.map((y) => (
                      <td class="text-right py-3 px-4 text-base-content/70 tabular-nums font-mono text-xs">
                        {data.years.get(y) ? Math.round(data.years.get(y)!).toLocaleString('es-ES') : '—'}
                      </td>
                    ))}
                    <td class="text-right py-3 px-4 font-bold text-base-content tabular-nums font-mono">
                      {Math.round(total).toLocaleString('es-ES')}
                    </td>
                    <td class="text-right py-3 px-4 text-base-content/60 font-medium">
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-base-200 text-base-content/80">
                        {data.entries.length}
                      </span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ) : (
      <p class="text-sm text-base-content/60 bg-base-100 p-8 rounded-xl border border-dashed border-base-300 text-center">
        Aún no hay cifras registradas en eventos.
      </p>
    )}
  </article>
</Base>

