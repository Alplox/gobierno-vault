---
import Base from '../../layouts/Base.astro';
import { getSourcesRegistry } from '../../lib/registry';
import { getSourceToEventsMap } from '../../lib/extractEntities';
import { BookOpen, Calendar, FileText } from 'lucide-astro';

const sources = getSourcesRegistry();
const sourceToEvents = getSourceToEventsMap();

interface FlatRef {
  id: string;
  titulo: string;
  medio: string;
  tipo: string;
  fecha: Date;
  url?: string;
  eventCount: number;
}

const allRefs: FlatRef[] = Object.entries(sources).map(([id, source]) => ({
  id,
  titulo: source.titulo,
  medio: source.medio,
  tipo: source.tipo,
  fecha: source.fecha,
  url: source.url,
  eventCount: (sourceToEvents.get(id) ?? []).length,
})).sort((a, b) => b.fecha.getTime() - a.fecha.getTime());

// La primera tanda se renderiza en SSR (pintado inmediato + SEO); el resto viaja
// como JSON compacto y se pinta bajo demanda en el cliente con "Cargar más fuentes".
const SSR_LIMIT = 60;
const ssrRefs = allRefs.slice(0, SSR_LIMIT);
const lazyRefs = allRefs.slice(SSR_LIMIT);
const ssrIds = new Set(ssrRefs.map((r) => r.id));

const lazyData = lazyRefs.map((r) => ({
  id: r.id,
  titulo: r.titulo,
  medio: r.medio,
  tipo: r.tipo,
  fechaStr: r.fecha.toLocaleDateString('es-ES'),
  eventCount: r.eventCount,
}));

const tipoLabels: Record<string, string> = {
  oficial: 'Oficial', prensa: 'Prensa', agencia: 'Agencia',
  documento: 'Documento', entrevista: 'Entrevista', video: 'Video',
  audio: 'Audio', red_social: 'Red social', tribunal: 'Tribunal',
  parlamento: 'Parlamento', organismo_internacional: 'Organismo internacional',
  base_de_datos: 'Base de datos',
};
---

<Base title="Fuentes">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <BookOpen class="h-6 w-6 text-primary shrink-0" />
      <h1 class="text-2xl sm:text-3xl font-bold text-base-content leading-tight">Fuentes Periodísticas y Oficiales</h1>
    </div>
    <p class="text-base-content/60 text-sm">Catálogo verificable de medios, documentos y fuentes primarias citadas en el vault.</p>
  </div>

  <div id="sources-index-root" class="grid gap-3">
    {ssrRefs.map((ref) => (
      <div class="group block rounded-xl p-5 bg-base-100 border-0 shadow-[var(--shadow-border)] hover:shadow-[var(--shadow-border-hover)] transition-[box-shadow,border-color] duration-200 ease-out">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <a transition:name={`source-title-${ref.id}`} href={`/sources/${ref.id}`} class="font-bold text-base-content text-base leading-snug group-hover:text-primary transition-colors block">
              {ref.titulo}
            </a>
            <div class="flex flex-wrap items-center gap-2 mt-1.5 text-xs text-base-content/60">
              <span class="font-semibold text-base-content/80">{ref.medio}</span>
              <span>·</span>
              <span class="inline-flex items-center gap-1 rounded bg-base-200 px-2 py-0.5 font-medium text-base-content/70">
                <FileText class="h-3 w-3 text-base-content/40" />
                {tipoLabels[ref.tipo] ?? ref.tipo}
              </span>
              <span>·</span>
              <span class="inline-flex items-center gap-1">
                <Calendar class="h-3.5 w-3.5 text-base-content/40" />
                {ref.fecha.toLocaleDateString('es-ES')}
              </span>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/30/60">
              {ref.eventCount} {ref.eventCount === 1 ? 'evento' : 'eventos'}
            </span>
            <a href={`/sources/${ref.id}`} class="p-1 text-base-content/30 group-hover:text-primary transition-colors">
              <span class="block text-lg leading-none">›</span>
            </a>
          </div>
        </div>
      </div>
    ))}
    {allRefs.length === 0 && (
      <p class="text-sm text-base-content/60 bg-base-100 p-8 rounded-xl border border-dashed border-base-300 text-center">
        Aún no hay fuentes registradas.
      </p>
    )}
  </div>

  {lazyRefs.length > 0 && (
    <div class="mt-6 flex justify-center">
      <button
        id="load-more-sources"
        class="pointer-events-auto inline-flex items-center gap-2 rounded-lg border border-base-300 bg-base-100 px-5 py-2.5 text-sm font-semibold text-base-content/80 shadow-sm hover:bg-base-200"
      >
        <span class="source-more-label">Cargar más fuentes ({lazyRefs.length} restantes)</span>
      </button>
    </div>
  )}

  <script type="application/json" id="sources-index-data" set:html={JSON.stringify(lazyData)} />

  <script>
    import { initSourceList } from '../../scripts/sourceListClient.js';
    initSourceList();
  </script>
</Base>