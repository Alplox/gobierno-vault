---
import Base from '../../layouts/Base.astro';
import { getAllEvents, getEventEntities } from '../../lib/queries';
import { getSourcesRegistry } from '../../lib/registry';
import { BookOpen, ExternalLink, Calendar, FileText, ChevronRight } from 'lucide-astro';

const events = await getAllEvents();
const sources = getSourcesRegistry();

interface FlatRef {
  id: string;
  titulo: string;
  medio: string;
  tipo: string;
  fecha: Date;
  url?: string;
  eventCount: number;
}

const refMap = new Map<string, FlatRef>();
for (const [id, source] of Object.entries(sources)) {
  refMap.set(id, {
    id,
    titulo: source.titulo,
    medio: source.medio,
    tipo: source.tipo,
    fecha: source.fecha,
    url: source.url,
    eventCount: 0,
  });
}

for (const e of events) {
  const entities = getEventEntities(e.id);
  for (const sourceId of entities.fuentes) {
    const existing = refMap.get(sourceId);
    if (existing) {
      existing.eventCount++;
    }
  }
}

const allRefs = [...refMap.values()].sort((a, b) => b.fecha.getTime() - a.fecha.getTime());

const tipoLabels: Record<string, string> = {
  oficial: 'Oficial', prensa: 'Prensa', agencia: 'Agencia',
  documento: 'Documento', entrevista: 'Entrevista', video: 'Video',
  audio: 'Audio', red_social: 'Red social', tribunal: 'Tribunal',
  parlamento: 'Parlamento', organismo_internacional: 'Organismo internacional',
  base_de_datos: 'Base de datos',
};
---

<Base title="Fuentes">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <BookOpen class="h-6 w-6 text-blue-600 shrink-0" />
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">Fuentes Periodísticas y Oficiales</h1>
    </div>
    <p class="text-gray-500 text-sm">Catálogo verificable de medios, documentos y fuentes primarias citadas en el vault.</p>
  </div>

  <div class="grid gap-3">
    {allRefs.map((ref) => (
      <div class="group block border border-gray-200/80 shadow-sm rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all duration-200 bg-white">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <a href={`/sources/${ref.id}`} class="font-bold text-gray-900 text-base leading-snug group-hover:text-blue-600 transition-colors block">
              {ref.titulo}
            </a>
            <div class="flex flex-wrap items-center gap-2 mt-1.5 text-xs text-gray-500">
              <span class="font-semibold text-gray-700">{ref.medio}</span>
              <span>·</span>
              <span class="inline-flex items-center gap-1 rounded bg-gray-100 px-2 py-0.5 font-medium text-gray-600">
                <FileText class="h-3 w-3 text-gray-400" />
                {tipoLabels[ref.tipo] ?? ref.tipo}
              </span>
              <span>·</span>
              <span class="inline-flex items-center gap-1">
                <Calendar class="h-3.5 w-3.5 text-gray-400" />
                {ref.fecha.toLocaleDateString('es-ES')}
              </span>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200/60">
              {ref.eventCount} {ref.eventCount === 1 ? 'evento' : 'eventos'}
            </span>
            <a href={`/sources/${ref.id}`} class="p-1 text-gray-300 group-hover:text-blue-600 transition-colors">
              <ChevronRight class="h-5 w-5" />
            </a>
          </div>
        </div>
      </div>
    ))}
    {allRefs.length === 0 && (
      <p class="text-sm text-gray-500 bg-white p-8 rounded-xl border border-dashed border-gray-300 text-center">
        Aún no hay fuentes registradas.
      </p>
    )}
  </div>
</Base>

