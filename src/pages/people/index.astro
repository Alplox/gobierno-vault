---
import Base from '../../layouts/Base.astro';
import { getAllPeople } from '../../lib/queries';
import { Users, Briefcase, Building2, ChevronRight } from 'lucide-astro';

const people = await getAllPeople();
---

<Base title="Personas">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <Users class="h-6 w-6 text-blue-600 shrink-0" />
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">Personas</h1>
    </div>
    <p class="text-gray-500 text-sm">Figuras públicas, autoridades y actores mencionados en acontecimientos registrados.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    {people.map((person) => (
        <a href={`/people/${person.id}`} class="group block border border-gray-200/80 shadow-sm rounded-xl p-5 hover:border-blue-300 hover:shadow-md active:scale-[0.99] transition-all duration-200 bg-white">
          <div class="flex items-start gap-4">
            <div class="h-16 w-12 rounded-lg bg-gray-100 flex items-center justify-center shrink-0">
              <Users class="h-5 w-5 text-gray-400" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="font-bold text-gray-900 text-base group-hover:text-blue-600 transition-colors leading-snug">{person.data.nombre}</h3>
              {person.data.cargo && (
                <p class="flex items-center gap-1.5 text-xs text-gray-600 font-medium mt-1">
                  <Briefcase class="h-3.5 w-3.5 text-gray-400 shrink-0" />
                  <span>{person.data.cargo}</span>
                </p>
              )}
              {person.data.organizacion && (
                <p class="flex items-center gap-1.5 text-xs text-gray-500 mt-0.5">
                  <Building2 class="h-3.5 w-3.5 text-gray-400 shrink-0" />
                  <span>{person.data.organizacion}</span>
                </p>
              )}
            </div>
            <ChevronRight class="h-5 w-5 text-gray-300 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all shrink-0 mt-1" />
          </div>
        </a>
    ))}
  </div>
</Base>

