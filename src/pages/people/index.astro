---
import Base from '../../layouts/Base.astro';
import { getAllPeople } from '../../lib/queries';
import { Users } from 'lucide-astro';

const allPeople = await getAllPeople();

const SSR_LIMIT = 40;
const ssrPeople = allPeople.slice(0, SSR_LIMIT);
const lazyPeople = allPeople.slice(SSR_LIMIT);
const ssrIds = new Set(ssrPeople.map((p) => p.id));

const lazyData = lazyPeople.map((p) => ({
  id: p.id,
  nombre: p.data.nombre,
  cargo: p.data.cargo ?? null,
  organizacion: p.data.organizacion ?? null,
}));
---

<Base title="Personas">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <Users class="h-6 w-6 text-primary shrink-0" />
      <h1 class="text-2xl sm:text-3xl font-bold text-base-content leading-tight">Personas</h1>
    </div>
    <p class="text-base-content/60 text-sm">Figuras públicas, autoridades y actores mencionados en acontecimientos registrados.</p>
  </div>

  <div id="people-index-root" class="grid gap-4 sm:grid-cols-2">
    {ssrPeople.map((person) => (
        <a href={`/people/${person.id}`} class="group block rounded-xl p-5 bg-base-100 border-0 shadow-[var(--shadow-border)] hover:shadow-[var(--shadow-border-hover)] active:scale-[0.96] transition-[box-shadow,scale,border-color] duration-200 ease-out">
          <div class="flex items-start gap-4">
            <div class="h-16 w-12 rounded-lg bg-base-200 flex items-center justify-center shrink-0">
              <Users class="h-5 w-5 text-base-content/40" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 transition:name={`person-title-${person.id}`} class="font-bold text-base-content text-base group-hover:text-primary transition-colors leading-snug">{person.data.nombre}</h3>
              {person.data.cargo && (
                <p class="flex items-center gap-1.5 text-xs text-base-content/70 font-medium mt-1">
                  <span>{person.data.cargo}</span>
                </p>
              )}
              {person.data.organizacion && (
                <p class="flex items-center gap-1.5 text-xs text-base-content/60 mt-0.5">
                  <span>{person.data.organizacion}</span>
                </p>
              )}
            </div>
            <span class="ml-auto text-base-content/30 group-hover:text-primary group-hover:translate-x-0.5 transition-[translate,color] duration-200 ease-out shrink-0 mt-1">›</span>
          </div>
        </a>
    ))}
  </div>

  {lazyPeople.length > 0 && (
    <div class="mt-6 flex justify-center">
      <button
        id="load-more-people"
        class="pointer-events-auto inline-flex items-center gap-2 rounded-lg border border-base-300 bg-base-100 px-5 py-2.5 text-sm font-semibold text-base-content/80 shadow-sm hover:bg-base-200"
      >
        <span class="person-more-label">Cargar más personas ({lazyPeople.length} restantes)</span>
      </button>
    </div>
  )}

  <script type="application/json" id="people-index-data" set:html={JSON.stringify(lazyData)} />

  <script>
    import { initPersonList } from '../../scripts/personListClient.js';
    initPersonList();
  </script>
</Base>