---
import { Layers, X } from 'lucide-astro';

interface NavSection {
  id: string;
  label: string;
  railLabel?: string;
  level?: string;
  children?: NavSection[];
}

interface Props {
  sections?: NavSection[];
}

const { sections = [] } = Astro.props;
const flatSections: NavSection[] = [];
for (const s of sections) {
  flatSections.push(s);
  if (s.children) flatSections.push(...s.children);
}

const railLabelClass = (level?: string) =>
  level === 'decade'
    ? 'text-xs font-bold text-gray-500 hover:text-blue-600'
    : level === 'year'
      ? 'text-[11px] font-semibold text-gray-400 hover:text-blue-600'
      : 'text-[10px] font-medium text-gray-300 hover:text-blue-600';

// Estilos del índice plano del bottom-sheet móvil (misma jerarquía que el rail de escritorio).
const sheetLabelClass = (level?: string) =>
  level === 'decade'
    ? 'text-sm font-bold text-gray-900'
    : level === 'year'
      ? 'pl-5 text-[13px] font-semibold text-gray-600'
      : 'pl-10 text-xs font-medium text-gray-500';
---

{sections.length > 0 && (
  <>
    <nav
      id="timeline-rail"
      class="fixed right-4 top-1/2 z-40 hidden -translate-y-1/2 flex-col items-end gap-1 overflow-y-auto py-1 lg:flex [scrollbar-width:thin] [scrollbar-color:#cbd5e1_transparent]"
      style="max-height: 76vh"
      aria-label="Índice temporal"
    >
      {flatSections.map((s) => (
        <a
          href={`#${s.id}`}
          class={`timeline-rail-label group rounded px-1.5 py-0.5 leading-none transition-colors ${railLabelClass(s.level)}`}
          data-target={s.id}
          data-label={s.id}
          aria-label={s.label}
        >
          {s.railLabel ?? s.label}
        </a>
      ))}
    </nav>

    <button
      id="timeline-fab"
      class="fixed bottom-5 right-5 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-gray-900 text-white shadow-lg transition-transform hover:scale-105 lg:hidden"
      aria-label="Abrir índice temporal"
      aria-expanded="false"
    >
      <Layers class="h-5 w-5" />
    </button>

    <div id="timeline-sheet" class="pointer-events-none fixed inset-x-0 bottom-0 z-50 lg:hidden" aria-hidden="true">
      <div id="timeline-sheet-backdrop" class="absolute inset-0 bg-black/30 opacity-0 transition-opacity duration-200" />
      <div class="relative mx-auto max-h-[70vh] w-full max-w-xl translate-y-full overflow-y-auto overscroll-contain rounded-t-2xl bg-white p-4 pb-6 shadow-2xl transition-transform duration-300">
        <div class="mb-2 flex items-center justify-between">
          <h3 class="text-sm font-bold text-gray-900">Índice temporal</h3>
          <button id="timeline-sheet-close" class="flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100" aria-label="Cerrar">
            <X class="h-4 w-4" />
          </button>
        </div>
        <p class="mb-2 text-[11px] text-gray-400">Toca una fecha para desplazarte a esa sección.</p>
        <div class="space-y-px pb-1">
          {flatSections.map((s) => {
            // Inferir la jerarquía desde el prefijo del id cuando el caller no
            // entrega `level` (ej. /events), para mantener el mismo índice plano.
            const level =
              s.level ?? (s.id.startsWith('decade-')
                ? 'decade'
                : s.id.startsWith('year-')
                  ? 'year'
                  : 'month');
            return (
              <a
                href={`#${s.id}`}
                class={`timeline-sheet-link group flex w-full items-center rounded-lg py-1.5 pr-2 transition-colors hover:bg-gray-100 hover:text-blue-700 ${sheetLabelClass(level)}`}
                data-target={s.id}
                aria-label={s.label}
              >
                {s.railLabel ?? s.label}
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </>
)}

<script>
  // Patrón del vault: los <script> bundleados corren UNA sola vez (no se
  // re-ejecutan en cada navegación View Transitions). Todo init que consulta
  // el DOM debe registrarse en astro:page-load (se dispara también en la carga
  // inicial) y llamarse directo, para re-enganchar listeners al DOM nuevo tras
  // cada swap. cleanup() desconecta observers y remueve listeners previos para
  // no duplicarlos si init corre dos veces sobre el mismo DOM.
  const cleanupFns: (() => void)[] = [];
  let ro: ResizeObserver | null = null;
  let io: IntersectionObserver | null = null;

  function cleanup() {
    while (cleanupFns.length) {
      const fn = cleanupFns.pop();
      try { fn?.(); } catch { /* noop */ }
    }
    ro?.disconnect();
    ro = null;
    io?.disconnect();
    io = null;
  }

  function initTimelineNav() {
    cleanup();

    const rail = document.getElementById('timeline-rail');
    const fab = document.getElementById('timeline-fab');
    const sheet = document.getElementById('timeline-sheet');
    const sheetBackdrop = document.getElementById('timeline-sheet-backdrop');
    const sheetClose = document.getElementById('timeline-sheet-close');
    const sheetPanel = sheet?.querySelector('.translate-y-full');

    const railIsVisible = () => {
      if (!rail) return false;
      const main = document.querySelector('main');
      if (!main) return true;
      const mainRight = main.getBoundingClientRect().right;
      return window.innerWidth - mainRight >= 64;
    };

    const updateRailVisibility = () => {
      if (!rail) return;
      rail.classList.toggle('opacity-0', !railIsVisible());
      rail.classList.toggle('pointer-events-none', !railIsVisible());
      rail.classList.toggle('transition-opacity', true);
      rail.classList.toggle('duration-300', true);
    };

    updateRailVisibility();
    const onResize = () => updateRailVisibility();
    window.addEventListener('resize', onResize);
    cleanupFns.push(() => window.removeEventListener('resize', onResize));
    ro = new ResizeObserver(updateRailVisibility);
    const mainEl = document.querySelector('main');
    if (mainEl) ro.observe(mainEl);

    const openSheet = () => {
      if (!sheet) return;
      sheet.setAttribute('aria-hidden', 'false');
      sheet.classList.remove('pointer-events-none');
      sheetBackdrop?.classList.remove('opacity-0');
      sheetPanel?.classList.remove('translate-y-full');
      fab?.setAttribute('aria-expanded', 'true');
    };

    const closeSheet = () => {
      if (!sheet) return;
      sheet.setAttribute('aria-hidden', 'true');
      sheet.classList.add('pointer-events-none');
      sheetBackdrop?.classList.add('opacity-0');
      sheetPanel?.classList.add('translate-y-full');
      fab?.setAttribute('aria-expanded', 'false');
    };

    if (fab) {
      const onFab = () => {
        const isOpen = sheet?.getAttribute('aria-hidden') === 'false';
        if (isOpen) closeSheet();
        else openSheet();
      };
      fab.addEventListener('click', onFab);
      cleanupFns.push(() => fab.removeEventListener('click', onFab));
    }
    if (sheetBackdrop) {
      sheetBackdrop.addEventListener('click', closeSheet);
      cleanupFns.push(() => sheetBackdrop.removeEventListener('click', closeSheet));
    }
    if (sheetClose) {
      sheetClose.addEventListener('click', closeSheet);
      cleanupFns.push(() => sheetClose.removeEventListener('click', closeSheet));
    }

    const expandAncestors = (targetId: string) => {
      const el = document.getElementById(targetId);
      if (!el) return;
      let current: HTMLElement | null = el;
      while (current) {
        const details = current.parentElement?.closest('details[data-persist]') as HTMLDetailsElement | null;
        if (details && !details.open) details.open = true;
        current = details ?? current.parentElement;
      }
      const monthMatch = /^month-/.test(targetId);
      // __gvFillMonth se expone en el cliente por timelineClient/eventListClient;
      // no existe en el tipo Window, por eso el cast explicito.
      const fillMonth = (window as any).__gvFillMonth as ((key: string) => void) | undefined;
      if (monthMatch && typeof fillMonth === 'function') {
        fillMonth(targetId.slice(6));
      }
      // El IO llena meses del nuevo viewport tras el salto y el documento crece,
      // desplazando el destino. Salto instant + re-ajuste tras asentarse.
      requestAnimationFrame(() =>
        el.scrollIntoView({ behavior: 'instant', block: 'start' })
      );
      setTimeout(() => {
        el.scrollIntoView({ behavior: 'instant', block: 'start' });
      }, 400);
    };

    document.querySelectorAll<HTMLAnchorElement>('[data-target]').forEach((link) => {
      const onClick = (e: Event) => {
        e.preventDefault();
        const targetId = link.dataset.target!;
        expandAncestors(targetId);
        closeSheet();
      };
      link.addEventListener('click', onClick);
      cleanupFns.push(() => link.removeEventListener('click', onClick));
    });

    const dots = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-label]').forEach((dot) => {
      dots.set(dot.dataset.label!, dot);
    });

    const targetEls = [...dots.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const setActiveDot = (activeId: string | null) => {
      dots.forEach((label, id) => {
        const isActive = id === activeId;
        label.classList.toggle('!text-blue-600', isActive);
        label.classList.toggle('!bg-blue-50', isActive);
        label.classList.toggle('rounded', isActive);
      });
    };

    if ('IntersectionObserver' in window && targetEls.length > 0) {
      io = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length === 0) return;
          visible.sort((a, b) => b.boundingClientRect.top - a.boundingClientRect.top);
          setActiveDot(visible[0].target.id);
        },
        { rootMargin: '-80px 0px -65% 0px', threshold: 0 }
      );
      targetEls.forEach((el) => io?.observe(el));
    }
  }

  // Los <script> bundleados corren una sola vez; por eso el listener se registra
  // en astro:page-load (se dispara tambien en la carga inicial) y ademas se
  // llama directo, por si el evento ya ocurrio antes de evaluar este modulo.
  if (!(window as any).__gvTimelineNavInit) {
    (window as any).__gvTimelineNavInit = true;
    document.addEventListener('astro:page-load', initTimelineNav);
  }
  initTimelineNav();
</script>
