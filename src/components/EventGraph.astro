---
import { eventBasename, eventYearFromDate, RELATION_LABELS, countExplicitConnections, type EventConnections, type RelationEdge } from '../lib/relations';
import { TIPO_LABELS, TIPO_COLORS } from '../lib/eventTypes';
import { getEventEntities } from '../lib/queries';

interface FilterOption {
  id: string;
  label: string;
}

interface Props {
  events: any[];
  connectionIndex: Map<string, EventConnections>;
  size: 'mini' | 'full';
  filters?: {
    topics: FilterOption[];
    people: FilterOption[];
    orgs: FilterOption[];
    tipos: FilterOption[];
    years: number[];
  };
}

const { events, connectionIndex, size, filters } = Astro.props;

const edgeColorMap: Record<string, string> = {
  contradice: '#ef4444', confirma: '#10b981', cumple: '#10b981',
  incumple: '#ef4444', amplia: '#0ea5e9', corrige: '#f59e0b',
  rectifica: '#f59e0b', responde_a: '#8b5cf6', deriva_en: '#6366f1',
  provoca: '#f97316', cita: '#78716c', reemplaza: '#06b6d4',
  actualiza: '#3b82f6', mismo_contexto: '#a8a29e',
};

// Filter for mini mode: last 3 months + their direct connections (capado para no desbordar el viewport mini 800x280)
let graphEvents = events;
if (size === 'mini' && events.length > 0) {
  const now = new Date();
  const threeMonthsAgo = new Date(now.getFullYear(), now.getMonth() - 3, 1);
  const recentIds = new Set<string>();
  for (const e of events) {
    if (new Date(e.data.fecha) >= threeMonthsAgo) {
      recentIds.add(eventBasename(e.id));
    }
  }
  // También incluir eventos que conectan con los recientes, pero limitar para que el mini no intente renderizar 800+ nodos (visto 833 -> bw 120k -> scale 0.005 ilegible y fuera de vista)
  const connectedIds = new Set<string>();
  for (const id of recentIds) {
    const conn = connectionIndex.get(id);
    if (!conn) continue;
    for (const edge of [...conn.outgoing, ...conn.incoming]) {
      connectedIds.add(edge.eventId);
    }
  }
  const allRelevantIds = new Set([...recentIds, ...connectedIds]);
  let filtered = events.filter((e) => allRelevantIds.has(eventBasename(e.id)));
  // Si aún son demasiados, quedarse con los más conectados + más recientes (cap 140 para que fitView no necesite scale <0.02)
  const MINI_CAP = 140;
  if (filtered.length > MINI_CAP) {
    filtered.sort((a, b) => {
      const ca = connectionIndex.get(eventBasename(a.id));
      const cb = connectionIndex.get(eventBasename(b.id));
      const na = ca ? ca.outgoing.length + ca.incoming.length : 0;
      const nb = cb ? cb.outgoing.length + cb.incoming.length : 0;
      if (nb !== na) return nb - na;
      return new Date(b.data.fecha).getTime() - new Date(a.data.fecha).getTime();
    });
    filtered = filtered.slice(0, MINI_CAP);
    // Asegurar que todos los recientes con conexiones queden, si el slice los sacó, reinsertar al menos los recientes más conectados
    const kept = new Set(filtered.map(e => eventBasename(e.id)));
    for (const id of recentIds) {
      if (!kept.has(id) && filtered.length < MINI_CAP) {
        const ev = events.find(e => eventBasename(e.id) === id);
        if (ev) filtered.push(ev);
      }
    }
  }
  graphEvents = filtered;
}

// Full mode: eventos con conexiones explicitas (para el render inicial y el flag
// `connected` del JSON). Los aislados (~430) ensucian el grafo y encarecen la
// simulacion en movil; el checkbox del header los re-incluye en cliente.
const connectedSet = new Set<string>();
for (const e of events) {
  const conn = connectionIndex.get(eventBasename(e.id));
  if (conn && (conn.outgoing.length > 0 || conn.incoming.length > 0)) {
    connectedSet.add(eventBasename(e.id));
  }
}
if (size === 'full') {
  graphEvents = events;
}
const isolatedCount = events.length - connectedSet.size;

if (graphEvents.length === 0) {
  return null;
}

// Compute positions
const dates = graphEvents.map((e) => new Date(e.data.fecha).getTime());
const minTime = Math.min(...dates);
const maxTime = Math.max(...dates);
const timeSpan = maxTime - minTime || 1;

const PAD_X = 60;
const PAD_Y = 40;
const width = size === 'mini' ? 800 : 1200;
const height = size === 'mini' ? 280 : 600;
const plotW = width - PAD_X * 2;
const plotH = height - PAD_Y * 2;

// Group by month for Y distribution
const monthGroups = new Map<string, number[]>();
for (let i = 0; i < graphEvents.length; i++) {
  const d = new Date(graphEvents[i].data.fecha);
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  if (!monthGroups.has(key)) monthGroups.set(key, []);
  monthGroups.get(key)!.push(i);
}

// Assign Y positions: spread within each month group
const positions: { x: number; y: number }[] = new Array(graphEvents.length);
const sortedMonths = [...monthGroups.keys()].sort();
const monthStep = sortedMonths.length > 1 ? plotH / (sortedMonths.length - 1) : plotH / 2;

for (let mi = 0; mi < sortedMonths.length; mi++) {
  const indices = monthGroups.get(sortedMonths[mi])!;
  const centerY = PAD_Y + mi * monthStep;
  const spacing = size === 'mini' ? 28 : 36;
  const startY = centerY - ((indices.length - 1) * spacing) / 2;
  for (let ii = 0; ii < indices.length; ii++) {
    const idx = indices[ii];
    const t = (dates[idx] - minTime) / timeSpan;
    positions[idx] = {
      x: PAD_X + t * plotW,
      y: Math.max(PAD_Y, Math.min(height - PAD_Y, startY + ii * spacing)),
    };
  }
}

// Collect edges to draw (only explicit connections between visible events)
const visibleIds = new Set(graphEvents.map((e) => eventBasename(e.id)));
type GraphEdge = { from: number; to: number; tipo: string; label: string };
const graphEdges: GraphEdge[] = [];
const drawnEdges = new Set<string>();

for (let i = 0; i < graphEvents.length; i++) {
  const id = eventBasename(graphEvents[i].id);
  const conn = connectionIndex.get(id);
  if (!conn) continue;
  for (const edge of [...conn.outgoing, ...conn.incoming]) {
    if (!visibleIds.has(edge.eventId)) continue;
    const j = graphEvents.findIndex((e) => eventBasename(e.id) === edge.eventId);
    if (j < 0) continue;
    const key = [Math.min(i, j), Math.max(i, j), edge.tipo].join('-');
    if (drawnEdges.has(key)) continue;
    drawnEdges.add(key);
    graphEdges.push({
      from: edge.direction === 'outgoing' ? i : j,
      to: edge.direction === 'outgoing' ? j : i,
      tipo: edge.tipo,
      label: RELATION_LABELS[edge.tipo] ?? edge.tipo,
    });
  }
}

const markers = [...new Set(graphEdges.map((e) => e.tipo))];

// Build graph data for client-side interactivity.
// Campos filtrables (temas/personas/orgs/etiquetas + search normalizado) para los
// filtros de /graph en force-graph.js. Mini no los usa pero comparte el payload.
function normalizeGraphSearch(s: string) {
  return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}
const graphNodes = graphEvents.map((event, i) => {
  const entities = getEventEntities(event.id);
  return {
  id: eventBasename(event.id),
  label: event.data.titulo,
  color: TIPO_COLORS[event.data.tipo] ?? '#6b7280',
  year: eventYearFromDate(event.data.fecha),
  tipo: event.data.tipo,
  tipoLabel: TIPO_LABELS[event.data.tipo] || event.data.tipo,
  fecha: new Date(event.data.fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Santiago' }),
  connections: (() => { const c = connectionIndex.get(eventBasename(event.id)); return c ? countExplicitConnections(c) : 0; })(),
  connected: connectedSet.has(eventBasename(event.id)),
  temas: event.data.tema ?? [],
  personas: entities.personas,
  orgs: entities.organizaciones,
  etiquetas: event.data.etiquetas ?? [],
  search: normalizeGraphSearch(
    [
      event.data.titulo,
      ...(event.data.etiquetas ?? []),
      ...entities.personas,
      ...entities.organizaciones,
      ...(event.data.tema ?? []),
      event.data.tipo,
      eventBasename(event.id),
    ].join(' ')
  ),
  x: positions[i].x,
  y: positions[i].y,
  url: `/events/${eventYearFromDate(event.data.fecha)}/${eventBasename(event.id)}`,
};
});

const graphLinks = graphEdges.map((e) => ({
  source: graphNodes[e.from].id,
  target: graphNodes[e.to].id,
  tipo: e.tipo,
  label: e.label,
}));
---

<div class:list={[
  'relative overflow-hidden rounded-xl border-0 bg-base-100 shadow-[var(--shadow-border)]',
  size === 'mini' ? 'mb-6' : '',
]}>
  {size === 'mini' && (
    <a href="/graph" class="absolute right-4 top-4 z-10 rounded-lg border border-base-300 bg-base-100 px-2.5 py-1 text-xs font-semibold text-primary shadow-sm hover:bg-primary/10 transition-colors">Ver grafo completo →</a>
  )}
  {size === 'full' && (
  <>
    <div class="border-b border-base-300 px-5 py-3 flex items-center justify-between gap-3 flex-wrap">
      <div>
        <h2 class="text-sm font-semibold text-base-content">Grafo de relaciones</h2>
        <p class="text-xs text-base-content/60">Nodos = eventos, flechas = relaciones explicitas. Arrastra nodos, scroll para zoom, shift+drag para mover vista. Toca un nodo para leerlo sin perder la vista.</p>
      </div>
      <label class="flex shrink-0 cursor-pointer items-center gap-1.5 text-xs font-medium text-base-content/70">
        <input type="checkbox" id="graph-include-isolated" class="h-3.5 w-3.5 accent-blue-600" />
        Incluir sin conexiones ({isolatedCount})
      </label>
    </div>
    {filters && (
    <form id="graph-filters" class="flex flex-wrap gap-2.5 items-end border-b border-base-300 px-5 py-3" onsubmit="return false;">
      <div class="w-full sm:w-auto sm:min-w-[200px] sm:flex-1">
        <label for="graph-q" class="mb-1 block text-[11px] font-semibold text-base-content/70">Búsqueda</label>
        <input
          type="search"
          id="graph-q"
          placeholder="Título, ID, etiqueta…"
          autocomplete="off"
          class="w-full text-sm bg-base-200 border border-base-300 rounded-lg px-2.5 py-1.5 focus:bg-base-100 focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
        />
      </div>
      <div class="min-w-[130px] flex-1 sm:flex-none">
        <label for="graph-tipo" class="mb-1 block text-[11px] font-semibold text-base-content/70">Tipo</label>
        <select id="graph-tipo" class="w-full text-sm bg-base-200 border border-base-300 rounded-lg px-2 py-1.5">
          <option value="">Todos</option>
          {filters.tipos.map((t) => <option value={t.id}>{t.label}</option>)}
        </select>
      </div>
      <div class="min-w-[110px] flex-1 sm:flex-none">
        <label for="graph-year" class="mb-1 block text-[11px] font-semibold text-base-content/70">Año</label>
        <select id="graph-year" class="w-full text-sm bg-base-200 border border-base-300 rounded-lg px-2 py-1.5">
          <option value="">Todos</option>
          {filters.years.map((y) => <option value={String(y)}>{y}</option>)}
        </select>
      </div>
      <div class="min-w-[140px] flex-1 sm:flex-none">
        <label for="graph-tema" class="mb-1 block text-[11px] font-semibold text-base-content/70">Tema</label>
        <select id="graph-tema" class="w-full text-sm bg-base-200 border border-base-300 rounded-lg px-2 py-1.5">
          <option value="">Todos</option>
          {filters.topics.map((t) => <option value={t.id}>{t.label}</option>)}
        </select>
      </div>
      <div class="min-w-[140px] flex-1 sm:flex-none">
        <label for="graph-persona" class="mb-1 block text-[11px] font-semibold text-base-content/70">Persona</label>
        <select id="graph-persona" class="w-full text-sm bg-base-200 border border-base-300 rounded-lg px-2 py-1.5">
          <option value="">Todas</option>
          {filters.people.map((p) => <option value={p.id}>{p.label}</option>)}
        </select>
      </div>
      <div class="min-w-[140px] flex-1 sm:flex-none">
        <label for="graph-org" class="mb-1 block text-[11px] font-semibold text-base-content/70">Organización</label>
        <select id="graph-org" class="w-full text-sm bg-base-200 border border-base-300 rounded-lg px-2 py-1.5">
          <option value="">Todas</option>
          {filters.orgs.map((o) => <option value={o.id}>{o.label}</option>)}
        </select>
      </div>
      <div class="w-[110px] flex-none">
        <label for="graph-minconn" class="mb-1 block text-[11px] font-semibold text-base-content/70" title="Nº mínimo de vínculos explícitos">Mín. vínc.</label>
        <input
          type="number"
          id="graph-minconn"
          min="0"
          value="0"
          class="w-full text-sm bg-base-200 border border-base-300 rounded-lg px-2.5 py-1.5 focus:bg-base-100 focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
        />
      </div>
      <div class="flex items-center gap-2 pb-0.5">
        <button type="button" id="graph-clear" class="hidden text-xs font-medium bg-base-200 text-base-content/80 px-3 py-2 rounded-lg hover:bg-base-300 active:scale-[0.96] transition-[scale,background-color] duration-150 ease-out">Limpiar</button>
        <span id="graph-count" class="text-[11px] text-base-content/50 whitespace-nowrap" aria-live="polite"></span>
      </div>
    </form>
    )}
  </>
  )}
  <div id="graph-container" data-width={width} data-height={height} class:list={[
    size === 'mini' ? 'mb-6' : '',
    size === 'full' ? 'h-[420px] overflow-x-auto sm:h-[560px]' : '',
  ]}>
    <!-- Skeleton: se muestra hasta que force-graph.js crea el SVG interactivo y lo oculta. Reemplaza el SVG estático solapado previo. -->
    <div data-graph-skeleton class="flex w-full animate-pulse items-center justify-center bg-base-200" style={size === 'mini' ? 'height:280px' : 'height:100%'}>
      <div class="flex flex-col items-center gap-2 py-8 text-base-content/40">
        <div class="h-8 w-8 animate-spin rounded-full border-2 border-base-300 border-t-primary"></div>
        <span class="text-xs">Cargando grafo…</span>
      </div>
    </div>
  </div>
  <p id="graph-empty" class="hidden px-5 py-12 text-center text-sm text-base-content/60">Sin eventos para los filtros seleccionados.</p>
  <div class="pointer-events-none absolute bottom-4 right-4 z-10 flex flex-col gap-1">
    <button id="zoom-in" class="pointer-events-auto flex h-8 w-8 items-center justify-center rounded-lg border border-base-300 bg-base-100 text-base-content/70 shadow-sm hover:bg-base-200 text-sm font-bold" title="Acercar">+</button>
    <button id="zoom-out" class="pointer-events-auto flex h-8 w-8 items-center justify-center rounded-lg border border-base-300 bg-base-100 text-base-content/70 shadow-sm hover:bg-base-200 text-sm font-bold" title="Alejar">−</button>
    <button id="zoom-reset" class="pointer-events-auto flex h-8 min-w-8 items-center justify-center gap-1 rounded-lg border border-base-300 bg-base-100 px-2 text-base-content/70 shadow-sm hover:bg-base-200 text-xs font-medium" title="Centrar vista — ver todos los nodos">⟲ <span class="hidden sm:inline">Centrar</span></button>
  </div>
  <div id="graph-tooltip" class="pointer-events-none fixed z-50 hidden max-w-xs rounded-lg border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 shadow-lg" />
</div>

<dialog id="graph-modal" class="w-[92vw] max-w-lg rounded-2xl p-0 backdrop:bg-black/40 max-sm:mx-0 max-sm:mb-0 max-sm:mt-auto max-sm:w-full max-sm:max-w-none max-sm:rounded-b-none">
  <div class="p-5">
    <div class="flex items-center justify-between gap-2 mb-2">
      <span id="graph-modal-badge" class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset"></span>
      <button type="button" id="graph-modal-close" aria-label="Cerrar" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-base-content/40 hover:bg-base-200 hover:text-base-content/80 transition-colors text-sm font-bold">✕</button>
    </div>
    <h3 id="graph-modal-title" class="font-semibold text-base-content leading-snug mb-1 text-balance"></h3>
    <p id="graph-modal-meta" class="text-xs text-base-content/60 mb-3"></p>
    <div id="graph-modal-content" class="prose prose-sm max-w-none max-h-[55vh] overflow-y-auto border-y border-base-300 py-3 my-3"></div>
    <p id="graph-modal-links-title" class="mb-1.5 text-[11px] font-bold uppercase tracking-wider text-base-content/60">Conexiones</p>
    <div id="graph-modal-links" class="space-y-1.5 max-h-52 overflow-y-auto mb-4 pr-1"></div>
    <a id="graph-modal-open" href="#" class="block text-center text-sm font-medium bg-primary text-primary-content px-4 py-2 rounded-lg hover:bg-primary/90 active:scale-[0.96] transition-[scale,background-color] duration-150 ease-out">Leer evento completo →</a>
  </div>
</dialog>

  <script type="application/json" id="graph-data" set:html={JSON.stringify({ nodes: graphNodes, links: graphLinks, size })} />
