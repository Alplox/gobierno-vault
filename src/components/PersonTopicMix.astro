---
// Reparto por tipo de evento: barra apilada horizontal + leyenda cuantificada.
// SVG estatico. Cada segmento es un enlace a /events filtrado por persona y tipo,
// que es donde el visitante puede ver los eventos concretos de ese tipo.
import { TIPO_LABELS, TIPO_COLORS } from '../lib/eventTypes';
import type { PersonPanorama } from '../lib/personStats';

interface Props {
  panorama: PersonPanorama;
  slug: string;
}

const { panorama, slug } = Astro.props;

const items = panorama.porTipo;
if (items.length === 0) return null;

const W = 760;
const H = 34;
const total = items.reduce((s, t) => s + t.n, 0);
const fmt = (v: number) => v.toLocaleString('es-CL');

let acc = 0;
const segments = items.map((t) => {
  const w = (t.n / total) * W;
  const seg = { ...t, x: acc, w };
  acc += w;
  return seg;
});
const pct = (t: { n: number }) => `${((t.n / total) * 100).toFixed(t.n / total < 0.01 ? 2 : 0)}%`;
---

<div class="flex flex-col gap-3">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="w-full h-10 sm:h-12"
    preserveAspectRatio="none"
    role="img"
    aria-labelledby={`pv-mix-title-${slug}`}
    font-family="system-ui, -apple-system, sans-serif"
  >
    <title id={`pv-mix-title-${slug}`}>Reparto por tipo de evento</title>
    {segments.map((s) => (
      <a href={`/events?persona=${slug}&tipo=${s.id}`}>
        <rect
          x={s.x}
          y="0"
          width={Math.max(1, s.w - 1.5)}
          height={H}
          rx="3"
          fill={TIPO_COLORS[s.id] ?? 'var(--color-base-content)'}
          opacity="0.85"
          class="pv-mix-seg"
        >
          <title>{`${TIPO_LABELS[s.id] ?? s.id}: ${fmt(s.n)} (${pct(s)})`}</title>
        </rect>
      </a>
    ))}
  </svg>

  <ul class="flex flex-wrap gap-x-4 gap-y-1.5">
    {items.map((t) => (
      <li>
        <a
          href={`/events?persona=${slug}&tipo=${t.id}`}
          class="inline-flex items-center gap-1.5 rounded-md px-1 py-0.5 text-[11px] text-base-content/70 transition-colors hover:bg-base-200 hover:text-primary"
          title={`Ver los ${fmt(t.n)} eventos de tipo ${TIPO_LABELS[t.id] ?? t.id} en /events`}
        >
          <span class="h-2 w-2 rounded-sm shrink-0" style={`background:${TIPO_COLORS[t.id] ?? 'var(--color-base-content)'}`} aria-hidden="true" />
          <span>{TIPO_LABELS[t.id] ?? t.id}</span>
          <span class="tabular-nums font-semibold text-base-content/90">{fmt(t.n)}</span>
          <span class="tabular-nums text-base-content/45">{pct(t)}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .pv-mix-seg {
    transition: opacity 0.15s ease-out;
  }
  a:hover .pv-mix-seg,
  a:focus-visible .pv-mix-seg {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .pv-mix-seg {
      transition: none;
    }
  }
</style>
