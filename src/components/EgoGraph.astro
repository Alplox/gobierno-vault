---
import { TIPO_LABELS, TIPO_COLORS } from '../lib/eventTypes';
import { RELATION_LABELS, type EventConnections } from '../lib/relations';
import { GitFork, Maximize2, Minimize2 } from 'lucide-astro';

interface Props {
  event: any;
  connections: EventConnections;
}

const { event, connections } = Astro.props;
const { outgoing, incoming, inferred } = connections;

if (outgoing.length === 0 && incoming.length === 0 && inferred.length === 0) return null;

const EDGE_COLORS: Record<string, string> = {
  contradice: '#ef4444', confirma: '#10b981', cumple: '#10b981',
  incumple: '#ef4444', amplia: '#0ea5e9', corrige: '#f59e0b',
  rectifica: '#f59e0b', responde_a: '#8b5cf6', deriva_en: '#6366f1',
  provoca: '#f97316', cita: '#78716c', reemplaza: '#06b6d4',
  actualiza: '#3b82f6', mismo_contexto: '#a8a29e',
};

const centerId = event.id.split('/').pop() ?? event.id;
const centerColor = TIPO_COLORS[event.data.tipo] ?? '#6b7280';
const centerTipo = TIPO_LABELS[event.data.tipo] || event.data.tipo;

function trunc(s: string, n: number) {
  return s.length > n ? `${s.slice(0, n)}…` : s;
}
function shortDate(d: Date) {
  return d.toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Santiago' });
}

// Un vecino por ID: lo explícito gana sobre lo inferido.
const neighbors = new Map<string, any>();
for (const e of [...outgoing, ...incoming]) {
  if (!neighbors.has(e.eventId)) {
    neighbors.set(e.eventId, {
      id: e.eventId,
      label: e.titulo,
      color: TIPO_COLORS[e.tipo] ?? '#6b7280',
      tipoLabel: TIPO_LABELS[e.tipo] || e.tipo,
      relation: RELATION_LABELS[e.tipo] ?? e.tipo,
      relationTipo: e.tipo,
      fecha: shortDate(e.fecha),
      url: `/events/${e.year}/${e.eventId}`,
      kind: e.direction === 'outgoing' ? 'outgoing' : 'incoming',
    });
  }
}
// "Mismo contexto" se limita a 10 para que el mini no se llene de nodos grises.
for (const e of inferred.slice(0, 10)) {
  if (!neighbors.has(e.eventId)) {
    neighbors.set(e.eventId, {
      id: e.eventId,
      label: e.titulo,
      color: '#a8a29e',
      tipoLabel: 'Mismo contexto',
      relation: 'Mismo contexto',
      relationTipo: 'mismo_contexto',
      fecha: shortDate(e.fecha),
      url: `/events/${e.year}/${e.eventId}`,
      kind: 'inferred',
    });
  }
}

const nodes = [
  {
    id: centerId,
    label: event.data.titulo,
    color: centerColor,
    tipoLabel: centerTipo,
    relation: 'Este evento',
    fecha: shortDate(new Date(event.data.fecha)),
    url: '',
    kind: 'center',
  },
  ...neighbors.values(),
];
const links = [...neighbors.values()].map((n: any) => ({
  source: centerId,
  target: n.id,
  tipo: n.relationTipo ?? 'deriva_en',
  kind: n.kind,
}));

// SVG estático de respaldo (sin JS se ve igual de centrado; el cliente lo oculta
// cuando el grafo interactivo está listo). Distribución radial compacta.
const fallbackNodes = [...neighbors.values()].slice(0, 14);
const fx = 160;
const fy = 108;
const radius = 58 + Math.min(24, fallbackNodes.length * 2);
const fallbackPoints = fallbackNodes.map((n: any, i: number) => {
  const angle = -Math.PI / 2 + (i * 2 * Math.PI) / Math.max(fallbackNodes.length, 1);
  return { ...n, x: fx + Math.cos(angle) * radius, y: fy + Math.sin(angle) * radius };
});
---

<div class="gv-ego-widget not-prose mb-8 overflow-hidden rounded-xl border-0 bg-base-100 shadow-[var(--shadow-border)]" data-gv-ego-widget>
  <div class="gv-ego-header flex items-center justify-between gap-2 border-b border-base-300 px-3 py-2">
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-base-content">
      <GitFork class="h-3.5 w-3.5 shrink-0 text-primary" />
      Grafo interactivo
      <span class="font-normal text-base-content/50">· {neighbors.size} vínculos</span>
    </span>
    <span class="inline-flex items-center gap-1">
      <button type="button" data-gv-ego-expand class="gv-ego-icon" title="Expandir grafo" aria-label="Expandir grafo">
        <Maximize2 class="gv-ego-expand-in h-3.5 w-3.5" />
        <Minimize2 class="gv-ego-expand-out h-3.5 w-3.5 hidden" />
      </button>
      <a href="/graph" class="gv-ego-icon" title="Ver grafo global" aria-label="Ver grafo global">
        <GitFork class="h-3.5 w-3.5" />
      </a>
    </span>
  </div>

  <div data-gv-ego-stage class="gv-ego-stage relative h-[300px] sm:h-[340px]">
    <svg data-gv-ego-fallback viewBox="0 0 320 216" class="h-full w-full" role="img" aria-label="Grafo de conexiones del evento" font-family="system-ui, -apple-system, sans-serif">
      {fallbackPoints.map((n: any) => (
        <line x1={fx} y1={fy} x2={n.x} y2={n.y} stroke={EDGE_COLORS[n.relationTipo] ?? '#78716c'} stroke-opacity="0.5" stroke-width="1.2" stroke-dasharray={n.kind === 'inferred' ? '3 3' : undefined} />
      ))}
      {fallbackPoints.map((n: any) => (
        <a href={n.url}>
          <circle cx={n.x} cy={n.y} r="6" fill={n.color} stroke="var(--color-base-100)" stroke-width="1.5" />
          <title>{n.label} · {n.relation}</title>
        </a>
      ))}
      <circle cx={fx} cy={fy} r="10" fill={centerColor} stroke="var(--color-base-100)" stroke-width="2" />
      <text x={fx} y={fy + 24} text-anchor="middle" fill="var(--color-base-content)" font-size="8" font-weight="600">{trunc(event.data.titulo, 32)}</text>
    </svg>
  </div>
  <div data-gv-ego-card class="gv-ego-card hidden border-t border-base-300 bg-base-200/60 px-3 py-2">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <p data-gv-ego-card-relation class="text-[10px] font-semibold uppercase tracking-wide text-primary"></p>
        <p data-gv-ego-card-title class="mt-0.5 text-xs font-semibold leading-snug text-base-content"></p>
      </div>
      <button type="button" data-gv-ego-card-close class="gv-ego-icon shrink-0" aria-label="Cerrar detalle" title="Cerrar detalle">✕</button>
    </div>
    <a data-gv-ego-card-open href="#" class="mt-1.5 inline-flex text-[11px] font-semibold text-primary hover:underline">Abrir evento →</a>
  </div>
  <div data-gv-ego-tip class="gv-ego-tip pointer-events-none fixed z-50 hidden max-w-[15rem] rounded-lg border border-base-300 bg-base-100 px-2.5 py-1.5 text-xs text-base-content/80 shadow-lg"></div>
  <p class="border-t border-base-300 px-3 py-1.5 text-[10px] text-base-content/50">Arrastra nodos · scroll para acercar · toca un nodo para ver su título</p>
  <script type="application/json" data-gv-ego-data set:html={JSON.stringify({ nodes, links, colors: EDGE_COLORS })} />
</div>

<script>
  import { initEgoGraph } from '../scripts/egoGraphWidget.js';
  initEgoGraph();
</script>
