---
import type { EventConnections } from '../lib/relations';
import TimelineCard from './TimelineCard.astro';

interface Props {
  connections: EventConnections;
  eventFecha: Date;
}

const { connections, eventFecha } = Astro.props;
const { outgoing, incoming } = connections;

if (outgoing.length === 0 && incoming.length === 0) return null;

// Etiqueta temporal según la fecha real del evento relacionado, no según la
// dirección de la relación (incoming/outgoing): un evento anterior en el tiempo
// es "Anterior" aunque la relación la declare el otro evento, y viceversa.
const eventTime = eventFecha.getTime();
const edges = [...incoming, ...outgoing];
const siguientes = edges
  .filter((e) => e.fecha.getTime() > eventTime)
  .sort((a, b) => a.fecha.getTime() - b.fecha.getTime());
const anteriores = edges
  .filter((e) => e.fecha.getTime() < eventTime)
  .sort((a, b) => b.fecha.getTime() - a.fecha.getTime());
const relacionados = edges.filter((e) => e.fecha.getTime() === eventTime);
---

<section class="mb-8">
  <h2 class="mb-4 text-lg font-semibold tracking-tight text-base-content text-balance">Linea de tiempo</h2>
  <div class="relative ml-4 border-l-2 border-base-300 pl-6 space-y-0">
    {siguientes.map((edge) => (
      <TimelineCard edge={edge} label="Siguiente" />
    ))}
    {relacionados.map((edge) => (
      <TimelineCard edge={edge} label="Relacionado" />
    ))}

    <div class="relative pb-6 last:pb-0">
      <div class="absolute -left-[31px] top-1 h-4 w-4 rounded-full bg-primary ring-4 ring-white" />
      <div class="rounded-lg border-2 border-primary/30 bg-primary/10/50 px-4 py-3">
        <span class="text-[10px] font-medium uppercase tracking-wide text-primary">Este evento</span>
        <div class="mt-1 flex items-center gap-2">
          <svg class="h-4 w-4 text-primary/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </div>
      </div>
    </div>

    {anteriores.map((edge) => (
      <TimelineCard edge={edge} label="Anterior" />
    ))}
  </div>
</section>
