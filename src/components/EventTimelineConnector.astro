---
import type { EventConnections } from '../lib/relations';
import TimelineCard from './TimelineCard.astro';
import { Crosshair } from 'lucide-astro';

interface Props {
  connections: EventConnections;
  eventFecha: Date;
}

const { connections, eventFecha } = Astro.props;
const { outgoing, incoming } = connections;

if (outgoing.length === 0 && incoming.length === 0) return null;

const eventTime = eventFecha.getTime();
const edges = [...outgoing, ...incoming];
const posteriores = edges.filter((e) => e.fecha.getTime() > eventTime).length;
const anteriores = edges.filter((e) => e.fecha.getTime() < eventTime).length;
const mismoDia = edges.length - posteriores - anteriores;
const total = edges.length;
const resumen = [
  `${anteriores} anteriores`,
  `${posteriores} posteriores`,
  ...(mismoDia ? [`${mismoDia} el mismo día`] : []),
].join(' · ');

// Una sola lista cronológica (antigua → reciente) con el evento actual en su
// posición real. Antes se ordenaba por distancia al evento actual (futuros
// ascendentes + pasados descendentes) y "Este evento" se insertaba siempre en
// medio, lo que rompía el orden de fechas (1 oct → 2 oct → 1 oct).
type Item =
  | { kind: 'current'; time: number }
  | { kind: 'edge'; time: number; edge: (typeof edges)[number]; label: string };

const items: Item[] = [
  ...edges.map((edge) => {
    const t = edge.fecha.getTime();
    return {
      kind: 'edge' as const,
      time: t,
      edge,
      label: t > eventTime ? 'Posterior' : t < eventTime ? 'Anterior' : 'Relacionado',
    };
  }),
  { kind: 'current', time: eventTime },
].sort((a, b) => a.time - b.time || (a.kind === 'current' ? -1 : 1));
---

<section class="mb-8 gv-tl" data-gv-tl data-gv-tl-total={total}>
  <div class="flex items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold tracking-tight text-base-content text-balance">Línea de tiempo</h2>
    <span class="shrink-0 text-[10px] font-semibold text-base-content/80">{total} vínculos</span>
  </div>
  <p class="mb-1.5 text-[10px] text-base-content/80">
    {resumen}. Orden cronológico; «posterior» no significa el siguiente inmediato.
  </p>
  <div class="mb-3 flex items-center gap-2">
    <button type="button" data-gv-tl-focus class="gv-tl-focus inline-flex items-center gap-1 rounded-md border border-base-300 bg-base-100 px-2 py-1 text-[10px] font-semibold text-base-content/80 transition-colors hover:border-primary/40 hover:text-base-content">
      <Crosshair class="h-3 w-3 shrink-0" />
      Este evento
    </button>
    <span data-gv-tl-offscreen class="gv-tl-offscreen text-[10px] font-medium text-base-content/80" aria-live="polite"></span>
  </div>
  <div data-gv-tl-stage class="gv-tl-stage relative ml-4 border-l-2 border-base-300 pl-6">
    {items.map((item) => item.kind === 'edge' ? (
      <TimelineCard edge={item.edge} label={item.label} />
    ) : (
      <div data-gv-tl-item data-gv-tl-current class="relative pb-6 last:pb-0">
        <div class="absolute -left-[31px] top-1 h-4 w-4 rounded-full bg-primary ring-4 ring-white" />
        <div class="rounded-lg border-2 border-primary/30 bg-primary/10 px-4 py-3">
          <span class="text-[10px] font-medium uppercase tracking-wide text-base-content">Este evento · estás aquí</span>
          <div class="mt-1 flex items-center gap-2">
            <svg class="h-4 w-4 text-base-content/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { initEventTimeline } from '../scripts/eventTimelineClient.js';
  initEventTimeline();
</script>
