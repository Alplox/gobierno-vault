---
import { getEventEntities, getPeopleMap, getTopicsMap, getAllEvents } from '../lib/queries';
import {
  buildConnectionIndex,
  countExplicitConnections,
  eventBasename,
  eventYearFromDate,
  RELATION_LABELS,
} from '../lib/relations';
import { Clock, User, Tag, GitFork, ChevronRight, ChevronDown, AlertCircle } from 'lucide-astro';
import { TIPO_LABELS, TIPO_STYLES } from '../lib/eventTypes';
import TimelineNav from './TimelineNav.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  events: CollectionEntry<'events'>[];
}

const { events } = Astro.props;

// Solo el mes actual se renderiza en SSR; los demas meses cargan bajo demanda.
const now = new Date();
const currentMonthKey = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'America/Santiago', year: 'numeric', month: '2-digit',
}).format(now).slice(0, 7);

interface LazyEvent {
  id: string;
  year: number;
  month: number;
  day: number;
  weekday: string;
  timeStr: string | null;
  tipo: string;
  titulo: string;
  personas: string[];
  temas: string[];
  links: number;
  previews: { tipo: string; titulo: string }[];
}

const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const monthShort = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
const weekdayNames = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];

const [peopleMap, topicsMap, allEvents] = await Promise.all([
  getPeopleMap(),
  getTopicsMap(),
  getAllEvents(),
]);
const connectionIndex = buildConnectionIndex(allEvents);

function formatEventTime(date: Date): string | null {
  const parts = new Intl.DateTimeFormat('es-CL', {
    timeZone: 'America/Santiago',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(date);
  const hour = parts.find((p) => p.type === 'hour')?.value ?? '00';
  const minute = parts.find((p) => p.type === 'minute')?.value ?? '00';
  if (hour === '00' && minute === '00') return null;
  return `${hour}:${minute}`;
}

function dayKey(date: Date): string {
  return new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Santiago',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
}

interface DayGroup {
  key: string;
  day: number;
  month: number;
  year: number;
  weekday: string;
  events: typeof events;
}
interface MonthGroup {
  key: string;
  month: number;
  year: number;
  days: DayGroup[];
}
interface YearGroup {
  year: number;
  months: MonthGroup[];
}
interface DecadeGroup {
  decade: number;
  years: YearGroup[];
}

const decades: DecadeGroup[] = [];

for (const event of events) {
  const d = new Date(event.data.fecha);
  const year = eventYearFromDate(d);
  const month = parseInt(
    new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Santiago', month: '2-digit' }).format(d),
    10
  );
  const key = dayKey(d);
  const day = parseInt(key.slice(-2), 10);
  const weekday = weekdayNames[d.getDay()];

  const decadeIndex = Math.floor(year / 10);
  let decade = decades.find((d) => d.decade === decadeIndex);
  if (!decade) {
    decade = { decade: decadeIndex, years: [] };
    decades.push(decade);
  }
  let yearGroup = decade.years.find((y) => y.year === year);
  if (!yearGroup) {
    yearGroup = { year, months: [] };
    decade.years.push(yearGroup);
  }
  const monthKey = `${year}-${String(month).padStart(2, '0')}`;
  let monthGroup = yearGroup.months.find((m) => m.key === monthKey);
  if (!monthGroup) {
    monthGroup = { key: monthKey, month, year, days: [] };
    yearGroup.months.push(monthGroup);
  }
  let dayGroup = monthGroup.days.find((dg) => dg.key === key);
  if (!dayGroup) {
    dayGroup = { key, day, month, year, weekday, events: [] };
    monthGroup.days.push(dayGroup);
  }
  dayGroup.events.push(event);
}

for (const decade of decades) {
  decade.years.sort((a, b) => b.year - a.year);
  for (const yearGroup of decade.years) {
    yearGroup.months.sort((a, b) => (b.key < a.key ? -1 : 1));
    for (const monthGroup of yearGroup.months) {
      monthGroup.days.sort((a, b) => (b.key < a.key ? -1 : 1));
      for (const dayGroup of monthGroup.days) {
        dayGroup.events.sort((a, b) => new Date(b.data.fecha).getTime() - new Date(a.data.fecha).getTime());
      }
    }
  }
}
decades.sort((a, b) => b.decade - a.decade);

const currentYear = new Date().getFullYear();
// El mes actual se renderiza en SSR pero con un tope: los primeros 12 eventos.
const CURRENT_SSR_LIMIT = 12;
const ssrCurrentIds = new Set<string>();
let ssrCount = 0;
for (const month of months()) {
  if (month.key !== currentMonthKey) continue;
  for (const day of month.days) {
    for (const event of day.events) {
      if (ssrCount >= CURRENT_SSR_LIMIT) break;
      ssrCurrentIds.add(eventBasename(event.id));
      ssrCount++;
    }
    if (ssrCount >= CURRENT_SSR_LIMIT) break;
  }
}

// JSON compacto para el cliente: todos los eventos, agrupados por mes para carga bajo demanda.
const lazyData: LazyEvent[] = [];
for (const month of months()) {
  for (const day of month.days) {
    for (const event of day.events) {
      const d = new Date(event.data.fecha);
      const filename = eventBasename(event.id);
      const entities = getEventEntities(event.id);
      const connections = connectionIndex.get(filename)!;
      lazyData.push({
        id: filename,
        year: month.year,
        month: month.month,
        day: day.day,
        weekday: day.weekday,
        timeStr: formatEventTime(d),
        tipo: event.data.tipo,
        titulo: event.data.titulo,
        personas: entities.personas.map((id) => peopleMap.get(id) ?? id),
        temas: event.data.tema.map((id) => topicsMap.get(id) ?? id),
        links: countExplicitConnections(connections),
        previews: [...connections.outgoing, ...connections.incoming].slice(0, 2).map((edge) => ({
          tipo: edge.tipo,
          titulo: edge.titulo,
        })),
      });
    }
  }
}

function* months() {
  for (const decade of decades) for (const y of decade.years) for (const m of y.months) yield m;
}

const navSections = decades.map((d) => ({
  id: `decade-${d.decade}`,
  label: `${d.decade}0s`,
  railLabel: `${d.decade}0s`,
  level: 'decade',
  children: d.years.map((y) => ({
    id: `year-${y.year}`,
    label: `${y.year}`,
    railLabel: `${y.year}`,
    level: 'year',
    children: y.months.map((m) => ({
      id: `month-${m.key}`,
      label: `${monthNames[m.month - 1]} ${m.year}`,
      railLabel: `${monthShort[m.month - 1]} ${String(m.year).slice(-2)}`,
      level: 'month',
    })),
  })),
}));
---

{events.length === 0 ? (
  <div class="rounded-xl border border-dashed border-base-300 bg-base-100 px-6 py-16 text-center">
    <AlertCircle class="mx-auto h-8 w-8 text-base-content/40 mb-2" />
    <p class="text-sm font-medium text-base-content">Sin eventos registrados</p>
    <p class="mt-1 text-sm text-base-content/60">Los acontecimientos apareceran aqui cuando se agreguen a la base.</p>
  </div>
) : (
  <>
    <div id="timeline-crumb" class="sticky z-10 -mx-4 mb-4 border-b border-base-300 bg-base-100/90 px-4 py-2 backdrop-blur-md" style="top: 52px">
      <nav class="flex items-center gap-1 overflow-x-auto whitespace-nowrap text-[13px] text-base-content/60" aria-label="Posición actual">
        <span class="shrink-0">Estás en</span>
        <ChevronRight class="h-3.5 w-3.5 shrink-0 text-base-content/30" />
        <a id="crumb-decade" href="#" data-crumb-seg="decade" class="hidden shrink-0 rounded px-1 py-0.5 font-semibold text-base-content hover:bg-base-200">
          <span data-crumb-text></span>
        </a>
        <ChevronRight class="h-3.5 w-3.5 shrink-0 text-base-content/30" data-crumb-sep="year" />
        <a id="crumb-year" href="#" data-crumb-seg="year" class="hidden shrink-0 rounded px-1 py-0.5 font-medium text-base-content/80 hover:bg-base-200">
          <span data-crumb-text></span>
        </a>
        <ChevronRight class="h-3.5 w-3.5 shrink-0 text-base-content/30" data-crumb-sep="month" />
        <a id="crumb-month" href="#" data-crumb-seg="month" class="hidden shrink-0 rounded px-1 py-0.5 font-medium text-base-content/80 hover:bg-base-200">
          <span data-crumb-text></span>
        </a>
        <ChevronRight class="h-3.5 w-3.5 shrink-0 text-base-content/30" data-crumb-sep="day" />
        <a id="crumb-day" href="#" data-crumb-seg="day" class="hidden shrink-0 rounded px-1 py-0.5 font-semibold text-primary hover:bg-base-200">
          <span data-crumb-text></span>
        </a>
      </nav>
    </div>

    <div class="relative">
    <div
      class="absolute bottom-3 left-[15px] top-3 w-[2px] rounded-full bg-gradient-to-b from-neutral/50 via-base-300 to-base-200"
      aria-hidden="true"
    />

    <div class="space-y-10">
      {decades.map((decade) => (
        <section id={`decade-${decade.decade}`} class="scroll-mt-32" data-crumb-level="decade" data-crumb-label={`${decade.decade}0s`}>
          <details class="group/decade" open={decade.decade === Math.floor(currentYear / 10)} data-persist={`decade-${decade.decade}`}>
            <summary class="flex cursor-pointer list-none items-center gap-3 py-2 [&::-webkit-details-marker]:hidden">
              <ChevronRight class="h-5 w-5 shrink-0 text-base-content/40 transition-transform duration-200 group-open/decade:hidden" />
              <ChevronDown class="h-5 w-5 shrink-0 text-primary transition-transform duration-200 hidden group-open/decade:block" />
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-neutral text-[11px] font-semibold tabular-nums text-neutral-content ring-2 ring-base-300">
                {String(decade.decade).slice(-2)}s
              </div>
              <div class="min-w-0">
                <h2 class="text-xl font-bold tracking-tight text-base-content sm:text-2xl">
                  {decade.decade}0s
                </h2>
                <p class="text-xs text-base-content/60">
                  {decade.years.reduce((acc, y) => acc + y.months.reduce((a, m) => a + m.days.reduce((b, dg) => b + dg.events.length, 0), 0), 0)} eventos
                </p>
              </div>
            </summary>

            <div class="mt-4 space-y-10">
              {decade.years.map((yearGroup) => (
                <section id={`year-${yearGroup.year}`} class="scroll-mt-32" data-crumb-level="year" data-crumb-label={`${yearGroup.year}`}>
                  <details class="group/year" open={yearGroup.year === currentYear} data-persist={`year-${yearGroup.year}`}>
                    <summary class="relative flex cursor-pointer list-none items-center gap-2 border-b border-base-300 py-2 pl-12 [&::-webkit-details-marker]:hidden">
                      <span class="pointer-events-none absolute left-[15px] top-0 h-full w-8 border-b-2 border-l-2 border-base-300 rounded-bl-[10px]" aria-hidden="true" />
                      <ChevronRight class="h-4 w-4 shrink-0 text-base-content/40 transition-transform duration-200 group-open/year:hidden" />
                      <ChevronDown class="h-4 w-4 shrink-0 text-primary transition-transform duration-200 hidden group-open/year:block" />
                      <span class="text-sm font-bold uppercase tracking-wide text-base-content/60">
                        Año {yearGroup.year}
                      </span>
                      <span class="ml-auto text-xs text-base-content/40">
                        {yearGroup.months.reduce((a, m) => a + m.days.reduce((b, dg) => b + dg.events.length, 0), 0)} eventos
                      </span>
                    </summary>

                    <div class="space-y-10 pt-4">
                      {yearGroup.months.map((monthGroup) => (
                        <section id={`month-${monthGroup.key}`} class="scroll-mt-32" data-crumb-level="month" data-crumb-label={`${monthNames[monthGroup.month - 1]}`}>
                          <details class="group/month" open data-persist={`month-${monthGroup.key}`}>
                            <summary class="relative flex cursor-pointer list-none items-center gap-3 pb-2 pl-[72px] [&::-webkit-details-marker]:hidden">
                              <span class="pointer-events-none absolute left-[15px] top-0 h-full w-14 border-b-2 border-l-2 border-base-300 rounded-bl-[10px]" aria-hidden="true" />
                              <ChevronRight class="h-4 w-4 shrink-0 text-base-content/40 transition-transform duration-200 group-open/month:hidden" />
                              <ChevronDown class="h-4 w-4 shrink-0 text-primary transition-transform duration-200 hidden group-open/month:block" />
                              <div class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-neutral text-[11px] font-semibold tabular-nums text-neutral-content ring-2 ring-base-300">
                                {monthGroup.month}
                              </div>
                              <div class="min-w-0">
                                <h3 class="text-base font-semibold tracking-tight text-base-content">
                                  {monthNames[monthGroup.month - 1]} {monthGroup.year}
                                </h3>
                                <p class="text-xs text-base-content/60">
                                  {monthGroup.days.reduce((a, dg) => a + dg.events.length, 0)} {monthGroup.days.reduce((a, dg) => a + dg.events.length, 0) === 1 ? 'evento' : 'eventos'}
                                </p>
                              </div>
                            </summary>

                          <div class="space-y-3 bg-base-100 pt-2">
                            {monthGroup.key === currentMonthKey && monthGroup.days
                              .filter((dg) => dg.events.every((e) => ssrCurrentIds.has(eventBasename(e.id))))
                              .map((dayGroup) => (
                              <details id={`day-${dayGroup.key}`} class="group/day scroll-mt-32" open data-persist={`day-${dayGroup.key}`} data-crumb-level="day" data-crumb-label={`${dayGroup.day}`}>
                                <summary class="relative flex cursor-pointer list-none items-center gap-2.5 py-2 pl-24 [&::-webkit-details-marker]:hidden">
                                  <span class="pointer-events-none absolute left-[15px] top-0 h-full w-20 border-b-2 border-l-2 border-base-300 rounded-bl-[10px]" aria-hidden="true" />
                                  <ChevronRight class="h-3.5 w-3.5 shrink-0 text-base-content/40 transition-transform duration-200 group-open/day:hidden" />
                                  <ChevronDown class="h-3.5 w-3.5 shrink-0 text-primary transition-transform duration-200 hidden group-open/day:block" />
                                  <span class="text-sm font-semibold tabular-nums text-base-content">
                                    {dayGroup.day} {monthNames[dayGroup.month - 1]}
                                  </span>
                                  <span class="text-[11px] font-medium uppercase tracking-wide text-base-content/40">
                                    {dayGroup.weekday}
                                  </span>
                                  <span class="ml-auto text-[11px] text-base-content/40">
                                    {dayGroup.events.length} {dayGroup.events.length === 1 ? 'evento' : 'eventos'}
                                  </span>
                                </summary>

                                <div class="ml-24 space-y-0.5 border-l-2 border-base-300 pl-4">
                                  {dayGroup.events.map((event) => {
                                    const d = new Date(event.data.fecha);
                                    const yearNum = eventYearFromDate(event.data.fecha);
                                    const filename = eventBasename(event.id);
                                    const entities = getEventEntities(event.id);
                                    const tLabel = TIPO_LABELS[event.data.tipo] || event.data.tipo;
                                    const personaNames = entities.personas.map((id) => peopleMap.get(id) ?? id);
                                    const temaNombres = event.data.tema.map((id) => topicsMap.get(id) ?? id);
                                    const timeStr = formatEventTime(d);
                                    const connections = connectionIndex.get(filename)!;
                                    const explicitCount = countExplicitConnections(connections);
                                    const previewEdges = [...connections.outgoing, ...connections.incoming].slice(0, 2);

                                    return (
                                      <a
                                        href={`/events/${yearNum}/${filename}`}
                                        class="group flex gap-3 rounded-lg py-3 transition-colors hover:bg-base-200/80"
                                      >
                                        <article class="min-w-0 flex-1">
                                          <div class="flex items-start justify-between gap-3">
                                            <div class="min-w-0 flex-1">
                                              <div class="mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-1">
                                                <span class={`inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-semibold tracking-wide ring-1 ring-inset ${TIPO_STYLES[event.data.tipo] || 'bg-base-200 text-base-content/70 ring-base-300'}`}>
                                                  {tLabel}
                                                </span>
                                                {timeStr && (
                                                  <time class="inline-flex items-center gap-1 text-[11px] tabular-nums text-base-content/60">
                                                    <Clock class="h-3 w-3 text-base-content/40" />
                                                    {timeStr}
                                                  </time>
                                                )}
                                                {explicitCount > 0 && (
                                                  <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-medium text-primary ring-1 ring-inset ring-primary/30">
                                                    <GitFork class="h-3 w-3 shrink-0 text-primary" />
                                                    {explicitCount} {explicitCount === 1 ? 'vinculo' : 'vinculos'}
                                                  </span>
                                                )}
                                              </div>
                                              <h4 transition:name={`event-title-${filename}`} class="text-sm font-semibold leading-snug text-base-content text-balance transition-colors group-hover:text-primary sm:text-[15px]">
                                                {event.data.titulo}
                                              </h4>
                                              {personaNames.length > 0 && (
                                                <p class="mt-1.5 flex items-center gap-1.5 truncate text-xs text-base-content/60">
                                                  <User class="h-3.5 w-3.5 shrink-0 text-base-content/40" />
                                                  <span class="truncate">{personaNames.join(', ')}</span>
                                                </p>
                                              )}
                                              {temaNombres.length > 0 && (
                                                <div class="mt-2 flex flex-wrap gap-1">
                                                  {temaNombres.map((nombre) => (
                                                    <span class="inline-flex items-center gap-1 rounded-md bg-base-200 px-2 py-0.5 text-[11px] font-medium text-base-content/70">
                                                      <Tag class="h-3 w-3 text-base-content/40" />
                                                      {nombre}
                                                    </span>
                                                  ))}
                                                </div>
                                              )}
                                              {previewEdges.length > 0 && (
                                                <div class="mt-2.5 flex flex-wrap gap-1.5">
                                                  {previewEdges.map((edge) => {
                                                    const label = RELATION_LABELS[edge.tipo] ?? edge.tipo;
                                                    return (
                                                      <span class="inline-flex max-w-full items-center gap-1 rounded-md bg-base-200/80 px-2 py-0.5 text-[10px] font-medium text-base-content/70">
                                                        <span class="shrink-0 font-semibold text-base-content/80">{label}:</span>
                                                        <span class="truncate text-base-content/60">{edge.titulo}</span>
                                                      </span>
                                                    );
                                                  })}
                                                </div>
                                              )}
                                            </div>
                                            <ChevronRight class="mt-5 h-4 w-4 shrink-0 text-base-content/30 transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-primary" />
                                          </div>
                                        </article>
                                      </a>
                                    );
                                  })}
                                </div>
                              </details>
                            ))}
                            {(monthGroup.key !== currentMonthKey || monthGroup.days.some((dg) => dg.events.some((e) => !ssrCurrentIds.has(eventBasename(e.id))))) && (
                              <div
                                class="month-loader ml-24 py-3 pl-4 text-xs font-medium text-base-content/40"
                                data-load-month
                                data-year={monthGroup.year}
                                data-month={monthGroup.month}
                              >
                                {monthGroup.days.reduce((a, dg) => a + dg.events.length, 0)} {monthGroup.days.reduce((a, dg) => a + dg.events.length, 0) === 1 ? 'evento' : 'eventos'} · cargando…
                              </div>
                            )}
                          </div>
                          </details>
                        </section>
                      ))}
                    </div>
                  </details>
                </section>
              ))}
            </div>
          </details>
        </section>
      ))}
    </div>

    <TimelineNav sections={navSections} />
    </div>
  </>

  <script type="application/json" id="timeline-index-data" set:html={JSON.stringify(lazyData)} />

  <script>
    import { initTimeline } from '../scripts/timelineClient.js';
    // initTimeline debe re-ejecutarse en cada navegacion (View Transitions
    // reconstruye el DOM del mes actual; sin esto el observer mira nodos
    // viejos y los meses quedan en "cargando…"). El script del modulo solo
    // corre una vez, por eso el listener se registra en astro:page-load.
    if (!(window as any).__gvTimelinePageLoad) {
      (window as any).__gvTimelinePageLoad = true;
      document.addEventListener('astro:page-load', initTimeline);
    }
    initTimeline();
  </script>
)}

<script>
  // Patrón del vault: los <script> bundleados corren UNA sola vez (no se
  // re-ejecutan en cada navegación View Transitions). Todo init que consulta
  // el DOM debe registrarse en astro:page-load (se dispara también en la carga
  // inicial) y llamarse directo. cleanup() remueve listeners previos para que
  // init sea idempotente si corre dos veces sobre el mismo DOM.
  const STORAGE_KEY = 'gobierno-vault-timeline-collapsed';
  const cleanupFns: (() => void)[] = [];

  function cleanup() {
    while (cleanupFns.length) {
      const fn = cleanupFns.pop();
      try { fn?.(); } catch { /* noop */ }
    }
  }

  function loadPersisted(): Record<string, boolean> {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    } catch {
      return {};
    }
  }

  function initTimelineExtras() {
    cleanup();

    document.querySelectorAll<HTMLDetailsElement>('details[data-persist]').forEach((el) => {
      const onToggle = () => {
        const state = loadPersisted();
        state[el.dataset.persist!] = !el.open;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      };
      el.addEventListener('toggle', onToggle);
      cleanupFns.push(() => el.removeEventListener('toggle', onToggle));
    });

    const persisted = loadPersisted();
    document.querySelectorAll<HTMLDetailsElement>('details[data-persist]').forEach((el) => {
      const key = el.dataset.persist!;
      if (persisted[key] !== undefined) {
        el.open = !persisted[key];
      }
    });

    const crumb = document.getElementById('timeline-crumb');
    if (!crumb) return;

    const nav = document.querySelector('nav');
    const setCrumbTop = () => {
      crumb.style.top = `${(nav?.offsetHeight ?? 0) + 0}px`;
    };
    setCrumbTop();
    const onResize = () => setCrumbTop();
    window.addEventListener('resize', onResize);
    cleanupFns.push(() => window.removeEventListener('resize', onResize));

    const order = ['decade', 'year', 'month', 'day'] as const;
    const segEls = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-crumb-seg]').forEach((el) => segEls.set(el.dataset.crumbSeg!, el));
    const sepEls = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-crumb-sep]').forEach((el) => sepEls.set(el.dataset.crumbSep!, el));

    // Los días de meses lazy se agregan al DOM en el cliente (timelineClient),
    // así que los targets se refrescan cuando cambia la cantidad de secciones.
    let targets: { el: HTMLElement; level: string; label: string }[] = [];
    const refreshTargets = () => {
      const els = document.querySelectorAll<HTMLElement>('[data-crumb-level]');
      if (els.length === targets.length) return;
      targets = Array.from(els).map((el) => ({
        el,
        level: el.dataset.crumbLevel!,
        label: el.dataset.crumbLabel ?? '',
      }));
    };
    refreshTargets();

    // Chrome moderno oculta el contenido de <details> con content-visibility
    // (no display:none): getBoundingClientRect sigue devolviendo rects stale
    // no-cero, asi que el filtro por tamano 0x0 no detecta lo colapsado y el
    // crumb mostraba fechas fantasma. La comprobacion determinista es caminar
    // los ancestros details.
    const hiddenByDetails = (el: HTMLElement): boolean => {
      let node: HTMLElement | null = el;
      while (node?.parentElement) {
        const det = node.parentElement.closest('details');
        if (!det) break;
        if (!(det as HTMLDetailsElement).open) return true;
        node = det as HTMLElement;
      }
      return false;
    };

    const updateCrumb = () => {
      refreshTargets();
      const line = crumb.getBoundingClientRect().bottom + 4;
      let currentEl: HTMLElement | null = null;
      for (const t of targets) {
        if (hiddenByDetails(t.el)) continue;
        const rect = t.el.getBoundingClientRect();
        if (rect.top <= line) currentEl = t.el;
        else break;
      }
      const chain = new Map<string, { label: string; el: HTMLElement }>();
      if (currentEl) {
        let node: HTMLElement | null = currentEl;
        while (node) {
          const lvl = node.dataset.crumbLevel;
          if (lvl) chain.set(lvl, { label: node.dataset.crumbLabel ?? '', el: node });
          node = node.parentElement?.closest<HTMLElement>('[data-crumb-level]') ?? null;
        }
      }
      for (const level of order) {
        const seg = segEls.get(level);
        if (!seg) continue;
        const span = seg.querySelector('[data-crumb-text]');
        if (span) span.textContent = chain.get(level)?.label ?? '';
        if (chain.has(level)) seg.dataset.crumbTarget = chain.get(level)!.el.id;
        else delete seg.dataset.crumbTarget;
        seg.classList.toggle('hidden', !chain.has(level));
        sepEls.get(level)?.classList.toggle('hidden', !chain.has(level));
        seg.classList.toggle('font-bold', chain.has(level) && level === order[order.length - 1]);
        seg.classList.toggle('text-primary', chain.has(level) && level === order[order.length - 1]);
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        try {
          updateCrumb();
        } finally {
          ticking = false;
        }
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    cleanupFns.push(() => window.removeEventListener('scroll', onScroll));

    document.querySelectorAll<HTMLElement>('[data-crumb-seg]').forEach((a) => {
      const onClick = (e: Event) => {
        e.preventDefault();
        const targetId = a.dataset.crumbTarget;
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;
        // Si el target quedo bajo un details colapsado (estado stale entre
        // updates del crumb), abrir ancestros antes de saltar; el documento
        // crece al abrir y el IO llena meses, por eso el doble ajuste.
        let node: HTMLElement | null = target;
        while (node?.parentElement) {
          const det = node.parentElement.closest('details') as HTMLDetailsElement | null;
          if (!det) break;
          if (!det.open) det.open = true;
          node = det as HTMLElement;
        }
        requestAnimationFrame(() => target.scrollIntoView({ behavior: 'instant', block: 'start' }));
        setTimeout(() => target.scrollIntoView({ behavior: 'instant', block: 'start' }), 400);
      };
      a.addEventListener('click', onClick);
      cleanupFns.push(() => a.removeEventListener('click', onClick));
    });

    updateCrumb();
  }

  // Los <script> bundleados corren una sola vez; por eso el listener se registra
  // en astro:page-load (se dispara tambien en la carga inicial) y ademas se
  // llama directo, por si el evento ya ocurrio antes de evaluar este modulo.
  if (!(window as any).__gvTimelineExtrasInit) {
    (window as any).__gvTimelineExtrasInit = true;
    document.addEventListener('astro:page-load', initTimelineExtras);
  }
  initTimelineExtras();
</script>
