---
// Ficha de la fuente + fila de mirrors, compartida por el detalle de evento y
// /sueldos. La lista vive en src/lib/sourceMirrors.ts, la misma que usa el
// script de cliente de /source: un solo lugar para agregar o retirar espejos.
// Los mirrors son de solo lectura, nunca sustituyen la URL original citada.
import { SOURCE_MIRRORS } from '../lib/sourceMirrors';

const { url = '', sourceId = '' } = Astro.props;
---

{sourceId && (
  <p class="mt-1">
    <a href={`/source?id=${sourceId}`} class="text-[10px] font-medium text-base-content/80 hover:text-base-content transition-colors">Ficha de la fuente →</a>
  </p>
)}
{url && (
  <span class="flex flex-wrap items-center gap-x-1.5 gap-y-1 mt-1">
    {SOURCE_MIRRORS.map((m) => (
      <a href={m.href(url)} class="text-[10px] font-medium text-base-content/80 hover:text-base-content hover:underline underline-offset-2 decoration-1 transition-colors" target="_blank" rel="noopener" title={m.title}>{m.label}</a>
    ))}
  </span>
)}
