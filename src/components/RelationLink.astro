---
import { RELATION_LABELS, RELATION_CHIP_CLASS, DEFAULT_RELATION_CHIP, type RelationEdge } from '../lib/relations';
import { CheckCircle2, AlertTriangle, GitCommit, Link2, Calendar, ArrowRight } from 'lucide-astro';

interface Props {
  edge: RelationEdge;
  compact?: boolean;
  subtitle?: string;
  transitionName?: string;
}

const { edge, compact = false, subtitle, transitionName } = Astro.props;
const label = RELATION_LABELS[edge.tipo] ?? edge.tipo;
const chipClass = RELATION_CHIP_CLASS[edge.tipo] ?? DEFAULT_RELATION_CHIP;
const fechaStr = edge.fecha.toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Santiago',
});
---

<a
  href={`/events/${edge.year}/${edge.eventId}`}
  class:list={[
    'group block rounded-xl border border-gray-200/80 bg-white transition-all duration-150 hover:border-blue-300 hover:shadow-sm hover:bg-blue-50/20',
    compact ? 'px-3 py-2' : 'px-4 py-3',
  ]}
>
  <div class="flex items-start gap-3">
    <span
      class:list={[
        'inline-flex items-center gap-1 shrink-0 rounded-md px-2 py-0.5 text-[11px] font-semibold ring-1 ring-inset',
        chipClass,
      ]}
    >
      {edge.tipo === 'confirma' || edge.tipo === 'cumple' ? (
        <CheckCircle2 class="h-3 w-3 shrink-0" />
      ) : edge.tipo === 'contradice' || edge.tipo === 'incumple' || edge.tipo === 'corrige' ? (
        <AlertTriangle class="h-3 w-3 shrink-0" />
      ) : edge.tipo === 'amplia' || edge.tipo === 'deriva_en' ? (
        <GitCommit class="h-3 w-3 shrink-0" />
      ) : (
        <Link2 class="h-3 w-3 shrink-0" />
      )}
      <span>{label}</span>
    </span>
    <div class="min-w-0 flex-1">
      <p
        transition:name={transitionName}
        class:list={[
          'font-semibold leading-snug text-gray-900 text-balance group-hover:text-blue-600',
          compact ? 'text-xs' : 'text-sm',
        ]}
      >
        {edge.titulo}
      </p>
      {subtitle && <p class="mt-0.5 text-[11px] text-gray-500 font-medium">{subtitle}</p>}
      <time class="mt-1 flex items-center gap-1 text-[11px] tabular-nums text-gray-400">
        <Calendar class="h-3 w-3 text-gray-400 shrink-0" />
        <span>{fechaStr}</span>
      </time>
    </div>
    <ArrowRight class="h-4 w-4 shrink-0 text-gray-300 transition-all duration-150 group-hover:translate-x-0.5 group-hover:text-blue-600 self-center" />
  </div>
</a>

