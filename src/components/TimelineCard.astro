---
import { RELATION_LABELS, RELATION_CHIP_CLASS, DEFAULT_RELATION_CHIP, type RelationEdge } from '../lib/relations';

interface Props {
  edge: RelationEdge;
  label: string;
}

const { edge, label } = Astro.props;
const relationLabel = RELATION_LABELS[edge.tipo] ?? edge.tipo;
const chipClass = RELATION_CHIP_CLASS[edge.tipo] ?? DEFAULT_RELATION_CHIP;

const fechaTexto = edge.fecha.toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Santiago',
});
---

<div class="relative pb-6 last:pb-0">
  <div class="absolute -left-[31px] top-1 h-3 w-3 rounded-full bg-gray-300 ring-2 ring-white" />
  <a href={`/events/${edge.year}/${edge.eventId}`} class="group block rounded-lg border border-gray-200/80 bg-white px-4 py-3 transition-colors hover:border-gray-300 hover:bg-gray-50/80">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-[10px] font-medium uppercase tracking-wide text-gray-400">{label}</span>
      <span class={`inline-flex rounded-md px-1.5 py-0.5 text-[10px] font-medium ring-1 ring-inset ${chipClass}`}>
        {relationLabel}
      </span>
    </div>
    <p class="text-sm font-medium leading-snug text-gray-900 text-balance group-hover:text-blue-800">{edge.titulo}</p>
    <time class="mt-1 block text-[11px] tabular-nums text-gray-500">{fechaTexto}</time>
  </a>
</div>
