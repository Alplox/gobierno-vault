---
// Reproductor bajo demanda para la sección de referencias: si la URL de la
// fuente es de YouTube/Instagram/TikTok/Facebook/Vimeo/Dailymotion/Drive o un
// video directo, envuelve la referencia en un <details> que recién crea el
// iframe (o <video>) cuando el usuario lo abre. Nunca se emite un iframe en el
// HTML: ni terceros ni peso de red hasta que hay un clic explícito.
import { Play } from 'lucide-astro';
import { resolveVideoEmbed } from '../lib/videoEmbed';

const { url, label = '' } = Astro.props;
const embed = resolveVideoEmbed(url);

// Ancho máximo por formato: un vertical en la columna angosta de referencias
// se ve desproporcionado si ocupa todo el ancho.
const LAYOUT = {
  landscape: 'aspect-video w-full',
  square: 'aspect-square w-full max-w-[26rem]',
  portrait: 'aspect-[9/16] w-full max-w-[20rem]',
} as const;
---

{embed && (
  <details
    class="gv-video group mt-2"
    data-gv-video
    data-gv-kind={embed.kind}
    data-gv-src={embed.embedUrl}
    data-gv-title={label ? `${embed.platform} — ${label}` : embed.platform}
  >
    <summary class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary/80 cursor-pointer list-none [&::-webkit-details-marker]:hidden w-fit px-2 py-1 -ml-2 rounded-lg hover:bg-primary/10 transition-colors">
      <Play class="h-3.5 w-3.5" />
      <span>Reproducir aquí</span>
      <span class="font-medium text-base-content/40 group-open:hidden">· {embed.platform}</span>
      <span class="font-medium text-base-content/40 hidden group-open:inline">· cerrar</span>
    </summary>
    <div class="mt-2">
      <div class={`overflow-hidden rounded-lg bg-base-300/60 border border-base-300 ${LAYOUT[embed.layout]}`} data-gv-slot></div>
      <noscript>
        <a href={url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-primary hover:underline">
          Abrir en {embed.platform}
        </a>
      </noscript>
    </div>
  </details>
)}

<script>
  // El iframe se crea al abrir y se destruye al cerrar: así un video cerrado no
  // sigue sonando de fondo (el `display:none` de <details> no detiene el media
  // de un iframe de terceros).
  const build = (details: HTMLElement) => {
    const slot = details.querySelector<HTMLElement>('[data-gv-slot]');
    const src = details.dataset.gvSrc;
    if (!slot || !src || slot.dataset.gvLoaded) return;

    if (details.dataset.gvKind === 'file') {
      const video = document.createElement('video');
      video.controls = true;
      video.preload = 'metadata';
      video.playsInline = true;
      video.src = src;
      video.className = 'h-full w-full';
      slot.appendChild(video);
    } else {
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.loading = 'lazy';
      iframe.title = details.dataset.gvTitle || 'Video';
      iframe.className = 'h-full w-full border-0';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute(
        'allow',
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen',
      );
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      slot.appendChild(iframe);
    }
    slot.dataset.gvLoaded = '1';
  };

  const clear = (details: HTMLElement) => {
    const slot = details.querySelector<HTMLElement>('[data-gv-slot]');
    if (!slot || !slot.dataset.gvLoaded) return;
    slot.replaceChildren();
    delete slot.dataset.gvLoaded;
  };

  const wire = () => {
    document.querySelectorAll<HTMLElement>('details[data-gv-video]').forEach((details) => {
      if (details.dataset.gvWired) return;
      details.dataset.gvWired = '1';
      details.addEventListener('toggle', () => {
        if (details.open) build(details);
        else clear(details);
      });
    });
  };

  wire();
  document.addEventListener('astro:page-load', wire);
</script>
