---
// Fila de la línea de tiempo de /presupuesto. La fecha deja de ser meta: es el
// eje de la lectura (timeline-start). El evento del vault y los vínculos por
// atributo compartido suben a la superficie visible; el detalle largo sigue
// colapsado. Contraste: el texto siempre usa base-content, el color semantic lo
// llevan un rail, un punto y un icono (no una palabra coloreada), para que el
// mismo markup se lea en los 30 temas de daisyUI.
import { ArrowUpRight, TriangleAlert, ChevronDown, Landmark, Link2 } from 'lucide-astro';
import SourceRef from './SourceRef.astro';
import type { Movimiento, PresupuestoFuente, Vinculo } from '../lib/presupuesto';

interface Props {
  mov: Movimiento;
  ancla: string;
  fuente: PresupuestoFuente;
  refIndex: number;
  refAnchor: string;
  eventoHref: string | null;
  secundarias?: Array<{ fuente: PresupuestoFuente; index: number; anchor: string; oficial: boolean }>;
}

const { mov, ancla, fuente, refIndex, refAnchor, eventoHref, secundarias = [] } = Astro.props;

const TIPO_LABEL: Record<string, string> = {
  recorte: 'Recorte',
  aumento: 'Aumento',
  ingreso: 'Ingreso',
  redistribucion: 'Redistribución',
  revision_programas: 'Revisión de programas',
};
const rail = mov.tipo === 'recorte' ? 'bg-error' : mov.tipo === 'aumento' || mov.tipo === 'ingreso' ? 'bg-success' : 'bg-warning';
const punto = mov.tipo === 'recorte' ? 'status-error' : mov.tipo === 'aumento' || mov.tipo === 'ingreso' ? 'status-success' : 'status-warning';
const hayDetalle = Boolean(mov.nota || mov.monto_nota);

const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const fecha = mov.fecha ? mov.fecha.split('-').map(Number) : null;
const diaFecha = fecha ? `${String(fecha[2]).padStart(2, '0')} ${MESES[fecha[1] - 1]}` : 'sin fecha';
const anioFecha = fecha ? String(fecha[0]) : '—';
---

<li class="flex gap-2 sm:gap-4">
  <div class="pres-fecha w-12 sm:w-20 shrink-0 pt-4 text-right text-xs tabular-nums text-base-content/60">
    {diaFecha}
    <span class="block text-[10px] text-base-content/40">{anioFecha}</span>
  </div>
  <div class="flex w-4 shrink-0 justify-center pt-4"><span class={`status ${punto}`} aria-hidden="true"></span></div>
  <div class="min-w-0 flex-1">
    <article id={ancla} class="card bg-base-100 shadow-[var(--shadow-border)] scroll-mt-24 overflow-hidden">
      <div class={`h-1 ${rail}`} aria-hidden="true"></div>
      <div class="card-body gap-2.5 p-4">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
          <span class="badge badge-sm badge-outline gap-1.5">
            <span class={`h-1.5 w-1.5 rounded-full ${rail}`} aria-hidden="true"></span>
            {TIPO_LABEL[mov.tipo] ?? mov.tipo.replace(/_/g, ' ')}
          </span>
          <span class="badge badge-sm badge-outline capitalize">{mov.nivel_impacto}</span>
          {mov.partida && <span class="badge badge-sm badge-outline">{mov.partida}</span>}
        </div>

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <p class="text-xl font-bold tabular-nums leading-none text-base-content">
            {mov.monto !== null ? '$' + mov.monto.toLocaleString('es-CL') : 'Monto no publicado'}
          </p>
          {mov.organizacion_id && (
            <a href={`/organization?id=${mov.organizacion_id}`} class="text-xs font-semibold text-base-content/70 hover:text-primary transition-colors">
              {mov.organizacionNombre}
            </a>
          )}
        </div>

        <p class="text-sm text-base-content/90 leading-snug">
          {mov.descripcion}
          <SourceRef
            id=""
            index={refIndex}
            href={`#${refAnchor}`}
            title={`${fuente.medio} - ${fuente.titulo}`}
            tip={`${fuente.medio}\n${fuente.titulo}`}
          />
          {secundarias.map((s) => (
            <SourceRef
              id=""
              index={s.index}
              href={`#${s.anchor}`}
              title={`${s.fuente.medio} - ${s.fuente.titulo}`}
              tip={`${s.fuente.medio}\n${s.fuente.titulo}`}
            />
          ))}
        </p>

        {mov.objetivo_declarado ? (
          <div class="rounded-xl bg-base-200/60 px-3 py-2">
            <p class="text-[10px] font-semibold text-base-content/50">Objetivo declarado</p>
            <p class="text-xs text-base-content/80 mt-0.5 leading-relaxed">{mov.objetivo_declarado}</p>
          </div>
        ) : (
          <p class="flex items-start gap-1.5 rounded-xl bg-warning/10 px-3 py-2 text-xs font-semibold text-base-content">
            <TriangleAlert class="h-3.5 w-3.5 shrink-0 mt-0.5 text-warning" aria-hidden="true" />
            <span>Sin objetivo ni destino publicado a la fecha</span>
          </p>
        )}

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 pt-0.5">
          {eventoHref && mov.evento_id && (
            <a href={eventoHref} class="inline-flex items-center gap-1 text-xs font-semibold text-base-content/80 underline decoration-base-300 underline-offset-2 hover:text-primary transition-colors">
              <Link2 class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
              Evento {mov.evento_id}
              <ArrowUpRight class="h-3 w-3" aria-hidden="true" />
            </a>
          )}
          {mov.vinculos.map((v: Vinculo) => (
            <a
              href={`#${v.anchors[0]}`}
              title={`${v.texto} · salta al primero`}
              class="inline-flex items-center gap-1 text-xs text-base-content/60 underline decoration-base-300 underline-offset-2 hover:text-primary transition-colors"
            >
              <span class={`h-1.5 w-1.5 rounded-full ${rail}`} aria-hidden="true"></span>
              {v.texto}
            </a>
          ))}
          {mov.vinculos.length === 0 && (
            <span class="text-xs text-base-content/50">Sin vínculo documentado con otros movimientos</span>
          )}
        </div>

        {(hayDetalle || secundarias.length > 0) && (
          <details class="group/det rounded-xl bg-base-200/40 px-3 py-2">
            <summary class="flex items-center gap-1.5 cursor-pointer list-none text-xs font-semibold text-base-content/60 hover:text-primary transition-colors">
              <ChevronDown class="h-3.5 w-3.5 transition-transform group-open/det:rotate-180" aria-hidden="true" />
              Detalle y fuente
            </summary>
            <div class="mt-2 space-y-1.5 text-xs text-base-content/70">
              {mov.monto_nota && <p>{mov.monto_nota}</p>}
              {mov.nota && <p>{mov.nota}</p>}
              <p class="text-base-content/50">
                Fuente: {fuente.medio} ·{' '}
                <a href={fuente.url} class="link link-primary" target="_blank" rel="noopener">{fuente.titulo}</a>
              </p>
              {secundarias.length > 0 && (
                <div class="rounded-lg bg-base-200/60 px-2.5 py-2 space-y-1">
                  <p class="text-[10px] font-semibold uppercase tracking-wide text-base-content/50 flex items-center gap-1">
                    <Landmark class="h-3 w-3" aria-hidden="true" /> Trazabilidad ({secundarias.length + 1} fuentes)
                  </p>
                  <ul class="space-y-0.5">
                    {secundarias.map((s) => (
                      <li class="flex flex-wrap items-center gap-1">
                        {s.oficial && <span class="badge badge-xs badge-outline gap-1"><span class="h-1 w-1 rounded-full bg-success" aria-hidden="true"></span>oficial</span>}
                        <span class="text-base-content/60">{s.fuente.medio} ·</span>{' '}
                        <a href={s.fuente.url} class="link link-primary" target="_blank" rel="noopener">{s.fuente.titulo}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </details>
        )}
      </div>
    </article>
  </div>
</li>
