---
// Referencia inline de /sueldos. La forma semántica preferida es
// <SRef id="cfr-registro-publico-38bis" />; n se conserva para compatibilidad con
// componentes antiguos. El índice visible se resuelve desde orden_refs.
import SourceRef from '../SourceRef.astro';
import { getSueldos } from '../../lib/sueldos';

const { id, n } = Astro.props as { id?: string; n?: number };
const data = getSueldos();
const indice = id ? data.ordenRefs.indexOf(id) + 1 : n;
if (!indice || !data.fuentes[indice - 1]) {
  throw new Error(`SRef: no existe la fuente ${id ?? n} en sueldos.yaml`);
}
const fuente = data.fuentes[indice - 1];
---

<SourceRef
  id={`ref-${indice}`}
  index={indice}
  href={`#ref-${indice}`}
  tip={`${fuente.medio}\n${fuente.titulo}`}
/>
