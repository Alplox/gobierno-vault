---
import { Filter, Tag, User, Building2 } from 'lucide-astro';

const { topics = [], people = [], orgs = [] } = Astro.props;
---

<form method="get" class="flex flex-wrap gap-3 items-end p-4 bg-white border border-gray-200/80 shadow-sm rounded-xl mb-8">
  {topics.length > 0 && (
    <div class="flex-1 min-w-[140px]">
      <label class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 mb-1.5">
        <Tag class="h-3.5 w-3.5 text-gray-400" />
        Tema
      </label>
      <select name="tema" class="w-full text-sm bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
        <option value="">Todos</option>
        {topics.map((t: { id: string; label: string }) => <option value={t.id}>{t.label}</option>)}
      </select>
    </div>
  )}
  {people.length > 0 && (
    <div class="flex-1 min-w-[140px]">
      <label class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 mb-1.5">
        <User class="h-3.5 w-3.5 text-gray-400" />
        Persona
      </label>
      <select name="persona" class="w-full text-sm bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
        <option value="">Todas</option>
        {people.map((p: { id: string; label: string }) => <option value={p.id}>{p.label}</option>)}
      </select>
    </div>
  )}
  {orgs.length > 0 && (
    <div class="flex-1 min-w-[140px]">
      <label class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 mb-1.5">
        <Building2 class="h-3.5 w-3.5 text-gray-400" />
        Organización
      </label>
      <select name="org" class="w-full text-sm bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
        <option value="">Todas</option>
        {orgs.map((o: { id: string; label: string }) => <option value={o.id}>{o.label}</option>)}
      </select>
    </div>
  )}
  <button type="submit" class="inline-flex items-center justify-center gap-1.5 text-sm font-medium bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 active:scale-[0.98] transition-all duration-150 shadow-sm shrink-0">
    <Filter class="h-4 w-4" />
    <span>Filtrar</span>
  </button>
</form>

