---
import { Filter, Tag, User, Building2, Search, X, Layers, Hash } from 'lucide-astro';

const { topics = [], people = [], orgs = [], tipos = [], etiquetas = [] } = Astro.props;
---

<form method="get" id="filter-form" data-filter-form class="flex flex-wrap gap-3 items-end p-4 bg-white border border-gray-200/80 shadow-sm rounded-xl mb-8">
  <div class="w-full min-w-[220px]">
    <label class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 mb-1.5">
      <Search class="h-3.5 w-3.5 text-gray-400" />
      Búsqueda
    </label>
    <input
      type="search"
      name="q"
      data-search-input
      placeholder="Buscar por título, persona, tema, etiqueta o ID (ej. 20260618)"
      class="w-full text-sm bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
    />
  </div>
  {topics.length > 0 && (
    <div class="flex-1 min-w-[140px]">
      <label class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 mb-1.5">
        <Tag class="h-3.5 w-3.5 text-gray-400" />
        Tema
      </label>
      <select name="tema" data-filter-select="tema" class="w-full text-sm bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
        <option value="">Todos</option>
        {topics.map((t: { id: string; label: string }) => <option value={t.id}>{t.label}</option>)}
      </select>
    </div>
  )}
  {people.length > 0 && (
    <div class="flex-1 min-w-[140px]">
      <label class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 mb-1.5">
        <User class="h-3.5 w-3.5 text-gray-400" />
        Persona
      </label>
      <select name="persona" data-filter-select="persona" class="w-full text-sm bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
        <option value="">Todas</option>
        {people.map((p: { id: string; label: string }) => <option value={p.id}>{p.label}</option>)}
      </select>
    </div>
  )}
  {orgs.length > 0 && (
    <div class="flex-1 min-w-[140px]">
      <label class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 mb-1.5">
        <Building2 class="h-3.5 w-3.5 text-gray-400" />
        Organización
      </label>
      <select name="org" data-filter-select="org" class="w-full text-sm bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
        <option value="">Todas</option>
        {orgs.map((o: { id: string; label: string }) => <option value={o.id}>{o.label}</option>)}
      </select>
    </div>
  )}
  {etiquetas.length > 0 && (
    <div class="flex-1 min-w-[160px]">
      <label class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 mb-1.5">
        <Hash class="h-3.5 w-3.5 text-gray-400" />
        Etiqueta
      </label>
      <input
        type="text"
        name="etiqueta"
        data-etiqueta-input
        list="etiquetas-suggestions"
        placeholder="ej. megarreforma"
        class="w-full text-sm bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
      />
      <datalist id="etiquetas-suggestions">
        {etiquetas.map((e: string) => <option value={e}>{e}</option>)}
      </datalist>
    </div>
  )}
  <div class="flex items-center gap-2 shrink-0">
    <button type="submit" class="inline-flex items-center justify-center gap-1.5 text-sm font-medium bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 active:scale-[0.98] transition-all duration-150 shadow-sm">
      <Filter class="h-4 w-4" />
      <span>Filtrar</span>
    </button>
    <button
      type="button"
      id="clear-filters"
      data-clear-filters
      class="hidden inline-flex items-center justify-center gap-1.5 text-sm font-medium bg-gray-100 text-gray-700 px-3 py-2 rounded-lg hover:bg-gray-200 active:scale-[0.98] transition-all duration-150"
    >
      <X class="h-4 w-4" />
      <span>Limpiar</span>
    </button>
  </div>
  {tipos.length > 0 && (
    <div class="w-full">
      <span class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 mb-1.5">
        <Layers class="h-3.5 w-3.5 text-gray-400" />
        Tipo (clic para mostrar/ocultar)
      </span>
      <div class="flex flex-wrap gap-1.5" data-tipo-chips role="group" aria-label="Filtrar por tipo de evento">
        {tipos.map((t: { id: string; label: string; style: string }) => (
          <button
            type="button"
            data-tipo-chip={t.id}
            data-style-on={t.style}
            aria-pressed="false"
            class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset bg-white text-gray-500 ring-gray-200 hover:bg-gray-100 transition-colors"
          >
            {t.label}
          </button>
        ))}
      </div>
    </div>
  )}
</form>
