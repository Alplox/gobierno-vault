---
// Red de co-apariciones de una persona: la persona al centro y las figuras con las
// que mas veces comparte un evento, en disposicion radial. El radio del nodo y el
// grosor del enlace crecen con el numero de eventos compartidos, asi que la
// densidad de la red se lee de un vistazo. SVG estatico, cero JS: cada nodo es un
// enlace a la ficha de la otra persona.
import type { PersonPanorama } from '../lib/personStats';

interface Props {
  panorama: PersonPanorama;
  personName: string;
  slug: string;
}

const { panorama, personName, slug } = Astro.props;

const MAX_NODES = 12;
const nodes = panorama.coPeople.slice(0, MAX_NODES);

function trunc(s: string, n: number): string {
  return s.length > n ? `${s.slice(0, n - 1)}…` : s;
}

// Con 1-3 vecinos una circunferencia se ve vacia y las etiquetas se pisan:
// en ese caso se cae a una lista, que además lee mejor en movil.
const radial = nodes.length >= 4;

const W = 660;
const H = 480;
const cx = W / 2;
const cy = H / 2;
const R = 158;

const maxN = nodes[0]?.n ?? 1;
const rOf = (n: number) => 6 + Math.sqrt(n / maxN) * 17;

const placed = nodes.map((node, i) => {
  // Empieza arriba y reparte en circulo completo; en pantallas angostas se
  // recorre alternando lados para que no se alineen en la horizontal.
  const angle = -Math.PI / 2 + (i * 2 * Math.PI) / nodes.length;
  const r = rOf(node.n);
  const x = cx + R * Math.cos(angle);
  const y = cy + R * Math.sin(angle);
  const cos = Math.cos(angle);
  const sin = Math.sin(angle);
  return {
    ...node,
    r,
    x,
    y,
    lx: cx + (R + r + 7) * cos,
    ly: cy + (R + r + 7) * sin,
    anchor: cos > 0.25 ? 'start' : cos < -0.25 ? 'end' : 'middle',
    baseline: sin > 0.35 ? 'hanging' : sin < -0.35 ? 'auto' : 'middle',
  };
});

const centerR = 24;
const totalCompartidos = nodes.reduce((s, x) => s + x.n, 0);
---

{
  nodes.length === 0 ? (
    <p class="text-sm text-base-content/60">
      No hay co-apariciones registradas: esta persona aparece sola en los eventos del vault.
    </p>
  ) : radial ? (
    <div class="overflow-x-auto">
      <svg
        viewBox={`0 0 ${W} ${H}`}
        class="w-full min-w-[440px] h-auto"
        role="img"
        aria-labelledby={`pv-net-title-${slug} pv-net-desc-${slug}`}
        font-family="system-ui, -apple-system, sans-serif"
      >
        <title id={`pv-net-title-${slug}`}>Red de co-apariciones de {personName}</title>
        <desc id={`pv-net-desc-${slug}`}>
          {placed
            .map((p) => `${p.nombre}: ${p.n} evento${p.n === 1 ? '' : 's'} en común`)
            .join('; ')}
          .
        </desc>

        {/* Enlaces: grosor proporcional a los eventos compartidos */}
        {placed.map((p) => (
          <line
            x1={cx}
            y1={cy}
            x2={p.x}
            y2={p.y}
            stroke="var(--color-primary)"
            stroke-opacity="0.28"
            stroke-width={0.6 + (p.n / maxN) * 3.4}
            stroke-linecap="round"
          />
        ))}

        {/* Vecinos */}
        {placed.map((p) => (
          <g class="pv-net-node">
            <a href={`/people/${p.id}`}>
              <circle
                cx={p.x}
                cy={p.y}
                r={p.r}
                fill="color-mix(in oklab, var(--color-primary) 22%, var(--color-base-100))"
                stroke="var(--color-primary)"
                stroke-width="1.5"
              />
              <text
                x={p.x}
                y={p.y + 3}
                text-anchor="middle"
                font-size="9.5"
                font-weight="700"
                fill="var(--color-base-content)"
                pointer-events="none"
              >
                {p.n}
              </text>
              <text
                x={p.lx}
                y={p.ly}
                text-anchor={p.anchor}
                dominant-baseline={p.baseline}
                font-size="10.5"
                font-weight="500"
                fill="var(--color-base-content)"
                pointer-events="none"
              >
                {trunc(p.nombre, 22)}
              </text>
            </a>
          </g>
        ))}

        {/* Persona central */}
        <circle cx={cx} cy={cy} r={centerR} fill="var(--color-primary)" />
        <text
          x={cx}
          y={cy + 1}
          text-anchor="middle"
          font-size="11"
          font-weight="700"
          fill="var(--color-primary-content)"
        >
          {trunc(personName, 14)}
        </text>
        <text
          x={cx}
          y={cy + centerR + 16}
          text-anchor="middle"
          font-size="10"
          fill="var(--color-base-content)"
          fill-opacity="0.6"
        >
          {placed.length} figura{placed.length === 1 ? '' : 's'} · {totalCompartidos.toLocaleString('es-CL')}{' '}
          eventos compartidos
        </text>
      </svg>
    </div>
  ) : (
    <ul class="flex flex-wrap gap-2">
      {nodes.map((p) => (
        <li>
          <a
            href={`/people/${p.id}`}
            class="inline-flex items-center gap-1.5 rounded-lg bg-base-200 px-2.5 py-1.5 text-xs font-medium text-base-content/80 transition-colors hover:bg-primary/10 hover:text-primary"
          >
            <span class="font-semibold tabular-nums text-primary">{p.n}</span>
            <span class="max-w-[16rem] truncate">{p.nombre}</span>
            <span class="text-base-content/45">evento{p.n === 1 ? '' : 's'}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
