---
import { getPeopleMap, getTopicsMap, getEventEntities } from '../lib/queries';
import { countExplicitConnections, eventBasename, RELATION_LABELS, RELATION_CHIP_CLASS, DEFAULT_RELATION_CHIP, type EventConnections } from '../lib/relations';
import { Calendar, User, Tag, GitFork } from 'lucide-astro';
import { TIPO_LABELS, TIPO_STYLES } from '../lib/eventTypes';
import type { CollectionEntry } from 'astro:content';

interface Props {
  event: CollectionEntry<'events'>;
  connectionIndex?: Map<string, EventConnections>;
}

const { event, connectionIndex } = Astro.props;
const { titulo, fecha, tipo, tema, etiquetas = [] } = event.data;
const id = eventBasename(event.id);

const dateObj = new Date(fecha);
const fechaStr = dateObj.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const entities = getEventEntities(event.id);
const [peopleMap, topicsMap] = await Promise.all([getPeopleMap(), getTopicsMap()]);
const personaNombres = entities.personas.map((id) => peopleMap.get(id) ?? id);
const temaNombres = tema.map((id) => ({ id, nombre: topicsMap.get(id) ?? id }));
const year = dateObj.getFullYear();

const connections: EventConnections | undefined = connectionIndex?.get(id);
const explicitCount = connections ? countExplicitConnections(connections) : 0;
const previewEdges = connections ? [...connections.outgoing, ...connections.incoming].slice(0, 2) : [];

// Texto plano normalizado (sin acentos, minúsculas) para la búsqueda del cliente.
function normalizeSearch(s: string) {
  return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}
---

<a
  href={`/events/${year}/${id}`}
  data-tipo={tipo}
  data-tema={tema.join(',')}
  data-personas={entities.personas.join(',')}
  data-orgs={entities.organizaciones.join(',')}
  data-etiquetas={etiquetas.join(',')}
  data-search={normalizeSearch([titulo, ...etiquetas, ...personaNombres, ...temaNombres.map((t) => t.nombre), TIPO_LABELS[tipo] || tipo, id, fechaStr, year].join(' '))}
  class="block shadow-[0_1px_3px_rgba(0,0,0,0.04),0_1px_2px_rgba(0,0,0,0.06)] rounded-xl p-5 hover:shadow-md hover:border-primary/30/80 active:scale-[0.99] transition-all duration-200 bg-base-100 border border-base-300 overflow-hidden"
>
  <div class="flex flex-wrap items-center gap-2 mb-2 text-xs">
    <span class={`inline-flex items-center gap-1 rounded-md px-2 py-0.5 font-medium ring-1 ring-inset ${TIPO_STYLES[tipo] || 'bg-base-200 text-base-content/80 ring-base-300'}`}>
      {TIPO_LABELS[tipo] || tipo}
    </span>
    <span class="inline-flex items-center gap-1 text-base-content/60 font-medium">
      <Calendar class="h-3.5 w-3.5 text-base-content/40 shrink-0" />
      {fechaStr}
    </span>
    {explicitCount > 0 && (
      <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2 py-0.5 text-[11px] font-medium text-primary ring-1 ring-inset ring-primary/30">
        <GitFork class="h-3 w-3 shrink-0" />
        {explicitCount} {explicitCount === 1 ? 'vinculo' : 'vinculos'}
      </span>
    )}
  </div>

  <h3 transition:name={`event-title-${id}`} class="font-semibold text-base-content text-balance text-base leading-snug mb-2 group-hover:text-primary">{titulo}</h3>

  {personaNombres.length > 0 && (
    <div class="flex items-center gap-1.5 text-xs text-base-content/70 mb-2.5 min-w-0">
      <User class="h-3.5 w-3.5 text-base-content/40 shrink-0" />
      <span class="truncate">{personaNombres.join(', ')}</span>
    </div>
  )}

  <div class="flex gap-1.5 flex-wrap mb-3">
    {temaNombres.map((t) => (
      <span class="inline-flex items-center gap-1 text-xs bg-base-200/80 text-base-content/70 px-2 py-0.5 rounded-md font-medium">
        <Tag class="h-3 w-3 text-base-content/40 shrink-0" />
        {t.nombre}
      </span>
    ))}
  </div>

  {previewEdges.length > 0 && (
    <div class="pt-2 border-t border-base-300 flex flex-wrap gap-1.5">
      {previewEdges.map((edge) => {
        const label = RELATION_LABELS[edge.tipo] ?? edge.tipo;
        const chipClass = RELATION_CHIP_CLASS[edge.tipo] ?? DEFAULT_RELATION_CHIP;
        const arrow = edge.direction === 'outgoing' ? '→' : '←';
        return (
          <span class={`inline-flex max-w-full items-center gap-1.5 rounded-md px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset ${chipClass}`}>
            <span class="shrink-0">{arrow}</span>
            <span class="shrink-0 font-semibold">{label}</span>
            <span class="truncate">{edge.titulo}</span>
          </span>
        );
      })}
    </div>
  )}
</a>

